@page "/plugins/com-multishock-joystickintegration/joystickintegration"
@using System.Net.Http.Headers
@using System.Text
@implements IDisposable

<PageHeader Title="Joystick.tv" Icon="gamepad-2"
            Description="Run shocker reactions from Joystick.tv tips, tip menu items, follows and subscriptions while you stream.">
    <Meta>
        <ConnectionChip Connected="Connection.IsConnected" Connecting="Connection.IsConnecting" />
    </Meta>
    <Actions>
        @if (Connection.IsConnected)
        {
            <Button Variant="secondary" Icon="unplug" Text="Disconnect" OnClick="Disconnect" />
        }
        else if (!Auth.IsInstalled)
        {
            @if (Settings.HasCredentials)
            {
                <Button Variant="primary" Icon="download" Text="@(_installing ? "Waiting for approval…" : "Install on my channel")"
                        Loading="_installing" OnClick="Install" />
            }
        }
        else
        {
            <Button Variant="primary" Icon="plug" Text="Connect" Loading="Connection.IsConnecting" OnClick="Connect" />
        }
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!string.IsNullOrEmpty(_error) && !Connection.IsConnected && !Connection.IsConnecting)
    {
        <Alert Variant="danger" Title="Couldn't connect to Joystick.tv">@_error</Alert>
    }

    @if (!Auth.IsInstalled)
    {
        <Card Title="Connection"
              Description="Joystick.tv sends events to a private bot that you create and install on your channel. Changes save automatically.">
            <SettingRow Label="Create a bot"
                        Description="On Joystick.tv, create a private bot with the ReadMessages and ReceiveStreamEvents permissions. Add SendMessage if you want chat replies.">
                <Button Variant="secondary" Icon="external-link" Text="Open Joystick.tv" OnClick="OpenBotsPage" />
            </SettingRow>
            <SettingRow Label="Redirect URL" Description="Paste this exactly as the bot's redirect URL.">
                <div class="flex w-full min-w-0 items-center gap-2">
                    <code class="tile min-w-0 flex-1 truncate px-2.5 py-1.5 font-mono text-xs text-app-text">@RedirectUri</code>
                    <Button Variant="secondary" Size="icon" Icon="@(_copied ? "check" : "copy")"
                            AriaLabel="@(_copied ? "Redirect URL copied" : "Copy redirect URL")" Title="Copy redirect URL"
                            OnClick="CopyRedirect" />
                </div>
            </SettingRow>
            <SettingRow Label="Client ID" Description="Shown on your bot's page after you create it.">
                <TextInput Placeholder="Bot client ID" Value="@_clientId"
                           ValueChanged="UpdateClientId" aria-label="Client ID" />
            </SettingRow>
            <SettingRow Label="Client secret" Description="Keep it private. Anyone with it can act as your bot.">
                <TextInput InputType="password" Placeholder="Paste your client secret" Value="@_clientSecret"
                           ValueChanged="UpdateClientSecret" aria-label="Client secret" />
            </SettingRow>
            <SettingRow Label="Install the bot"
                        Description="@(Settings.HasCredentials
                            ? "Your browser opens to approve the bot on your channel, then MultiShock connects."
                            : "Enter the client ID and client secret above first.")">
                <Button Variant="secondary" Icon="download" Text="@(_installing ? "Waiting for approval…" : "Install on my channel")"
                        Loading="_installing" Disabled="@(!Settings.HasCredentials)"
                        Title="@InstallDisabledReason" OnClick="Install" />
            </SettingRow>
        </Card>
    }
    else
    {
        <Card Title="Connection" Description="Changes save automatically.">
            <SettingRow Label="Bot" Description="Removing the install signs MultiShock out of the bot; you'll need to install it again to reconnect.">
                <div class="flex flex-wrap items-center justify-end gap-2">
                    <span class="chip chip-ok"><span class="status-dot bg-app-success"></span>Installed</span>
                    <Button Variant="danger" Icon="trash-2" Text="Remove install" OnClick="@(() => _confirmRemove = true)" />
                </div>
            </SettingRow>
            <SettingRow Label="Connect on startup" Description="Connect when MultiShock starts.">
                <Toggle AriaLabel="Connect on startup" Value="Settings.AutoConnect" ValueChanged="@(v => Settings.AutoConnect = v)" />
            </SettingRow>
            <SettingRow Label="Reconnect automatically" Description="Reconnect if the connection drops during a stream.">
                <Toggle AriaLabel="Reconnect automatically" Value="Settings.AutoReconnect" ValueChanged="@(v => Settings.AutoReconnect = v)" />
            </SettingRow>
            <SettingRow Label="Test tip"
                        Description="@(Connection.IsConnected
                            ? "Ask Joystick.tv to send a sample tip through your bot, to check your reactions."
                            : "Connect first. Joystick.tv then sends a sample tip through your bot, to check your reactions.")">
                <Button Variant="secondary" Icon="send" Text="Send test tip" Loading="_sendingTest"
                        Disabled="@(!Connection.IsConnected)"
                        Title="@(Connection.IsConnected ? null : "Connect first")"
                        OnClick="SendTestTip" />
            </SettingRow>
        </Card>
    }

    <Card Title="Reactions"
          Description="Run shocker actions straight from Joystick.tv events. For custom logic, use the Joystick.tv triggers in a flow instead.">
        <SettingRow Label="Tip brackets" Description="Set intensity and duration by tip amount.">
            <Meta><SummaryChip Summary="BracketSummary" /></Meta>
            <ChildContent>
                <NavButton Href="/plugins/com-multishock-joystickintegration/tip-brackets" AriaLabel="Configure tip brackets" />
            </ChildContent>
        </SettingRow>
        <SettingRow Label="Tip menu items" Description="Give specific tip menu items their own reaction.">
            <Meta><SummaryChip Summary="RuleSummary" /></Meta>
            <ChildContent>
                <NavButton Href="/plugins/com-multishock-joystickintegration/tip-menu-rules" AriaLabel="Configure tip menu items" />
            </ChildContent>
        </SettingRow>
        <SettingRow Label="Follows, subs and more" Description="React to follows, subscriptions, wheel spins and tip goals.">
            <Meta><SummaryChip Summary="EventsSummary" /></Meta>
            <ChildContent>
                <NavButton Href="/plugins/com-multishock-joystickintegration/events-config" AriaLabel="Configure follow, subscription and other reactions" />
            </ChildContent>
        </SettingRow>
    </Card>

    <Card Title="Event log" Description="Events from this session, newest first." NoPadding="true">
        <Actions>
            @if (Log.Count > 0)
            {
                <Button Variant="ghost" Size="sm" Icon="trash-2" Text="Clear" OnClick="@(() => Log.Clear())" />
            }
        </Actions>
        <ChildContent>
            @if (Log.Count == 0)
            {
                <div class="px-4 py-6">
                    <p class="text-sm text-app-muted">No events yet.</p>
                    <p class="mt-0.5 text-xs text-app-subtle">
                        @(Connection.IsConnected
                            ? "Tips, follows and subscriptions appear here as they happen."
                            : "Tips, follows, subscriptions and connection messages appear here once you connect.")
                    </p>
                </div>
            }
            else
            {
                <ol class="max-h-80 divide-y divide-app-border overflow-y-auto">
                    @foreach (var entry in Log.Entries.Reverse())
                    {
                        <li class="flex items-start gap-3 px-4 py-2 text-sm">
                            <span class="shrink-0 pt-px font-mono text-xs text-app-subtle">@entry.Time.ToString("HH:mm:ss")</span>
                            @if (entry.IsError)
                            {
                                <span class="flex min-w-0 items-start gap-1.5 text-app-danger">
                                    <LucideIcon Name="alert-circle" Size="14" Class="mt-0.5 shrink-0" />
                                    <span class="break-words">@entry.Message</span>
                                </span>
                            }
                            else
                            {
                                <span class="min-w-0 break-words text-app-text">@entry.Message</span>
                            }
                        </li>
                    }
                </ol>
            }
        </ChildContent>
    </Card>
</div>

<ConfirmDialog IsOpen="_confirmRemove" Title="Remove the bot install?"
               Message="MultiShock disconnects and forgets the bot's sign-in. To use Joystick.tv again you'll need to install the bot on your channel again."
               ConfirmText="Remove install" OnCancel="@(() => _confirmRemove = false)" OnConfirm="RemoveInstall" />

@code {
    private static readonly string PluginId = JoystickIntegrationPlugin.PluginId;
    private JoystickSettingsService Settings => PluginServiceLocator.GetRequiredService<JoystickSettingsService>(PluginId);
    private JoystickAuthService Auth => PluginServiceLocator.GetRequiredService<JoystickAuthService>(PluginId);
    private JoystickConnectionService Connection => PluginServiceLocator.GetRequiredService<JoystickConnectionService>(PluginId);
    private EventLogService Log => PluginServiceLocator.GetRequiredService<EventLogService>(PluginId);
    private TipBracketsConfigService Brackets => PluginServiceLocator.GetRequiredService<TipBracketsConfigService>(PluginId);
    private TipRulesConfigService Rules => PluginServiceLocator.GetRequiredService<TipRulesConfigService>(PluginId);
    private EventsConfigService Events => PluginServiceLocator.GetRequiredService<EventsConfigService>(PluginId);

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private static readonly HttpClient Http = new();

    private string _clientId = "";
    private string _clientSecret = "";
    private bool _installing;
    private bool _sendingTest;
    private bool _copied;
    private bool _confirmRemove;
    private string? _error;
    private static string RedirectUri => JoystickConstants.OAuthRedirectUri;

    private string? InstallDisabledReason =>
        Settings.HasCredentials ? null : "Enter your bot's client ID and secret first";

    private ReactionSummary BracketSummary => ActionOptions.SummarizeBrackets(
        Brackets.Config.Enabled, Brackets.Config.Brackets.Count, Brackets.Config.SelectedShockerIds.Count);

    private ReactionSummary RuleSummary
    {
        get
        {
            var on = Rules.Config.Rules.Where(r => r.Enabled).ToList();
            return ActionOptions.SummarizeRules(Rules.Config.Enabled, Rules.Config.Rules.Count, on.Count,
                (on.Count(r => string.IsNullOrWhiteSpace(r.ItemName)), "an item name"),
                (on.Count(r => r.SelectedShockerIds.Count == 0), "shockers"));
        }
    }

    private ReactionSummary EventsSummary => ActionOptions.SummarizeEvents(
        [Events.Config.Follow, Events.Config.Subscribe, Events.Config.WheelSpin, Events.Config.TipGoal]);

    protected override void OnInitialized()
    {
        _clientId = Settings.ClientId;
        _clientSecret = Settings.ClientSecret;
        Connection.ConnectionStateChanged += OnStateChanged;
        Connection.ErrorOccurred += OnError;
        Auth.StatusChanged += OnAuthStatus;
        Log.LogChanged += OnLogChanged;
    }

    private void UpdateClientId(string? value)
    {
        _clientId = value ?? "";
        Settings.ClientId = _clientId;
    }

    private void UpdateClientSecret(string? value)
    {
        _clientSecret = value ?? "";
        Settings.ClientSecret = _clientSecret;
    }

    private void OnStateChanged(bool _) => InvokeAsync(StateHasChanged);
    private void OnLogChanged() => InvokeAsync(StateHasChanged);

    private void OnError(string error) => InvokeAsync(() =>
    {
        _error = error;
        StateHasChanged();
    });

    private void OnAuthStatus(string message)
    {
        Log.AddLog(message);
        InvokeAsync(StateHasChanged);
    }

    private async Task Install()
    {
        _error = null;
        _installing = true;
        try
        {
            var ok = await Auth.InstallAsync();
            if (ok)
            {
                await Connection.ConnectAsync();
            }
        }
        finally
        {
            _installing = false;
        }
    }

    private void RemoveInstall()
    {
        _confirmRemove = false;
        _ = Connection.DisconnectAsync();
        Auth.ClearInstall();
    }

    private async Task Connect()
    {
        _error = null;
        await Connection.ConnectAsync();
    }

    private async Task Disconnect() => await Connection.DisconnectAsync();

    private async Task OpenBotsPage()
    {
        try
        {
            await JS.InvokeVoidAsync("open", JoystickConstants.SiteHost, "_blank");
        }
        catch (JSException ex)
        {
            Log.AddLog($"Couldn't open {JoystickConstants.SiteHost}: {ex.Message}", isError: true);
        }
    }

    private async Task CopyRedirect()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", RedirectUri);
        }
        catch (JSException ex)
        {
            Log.AddLog($"Couldn't copy the redirect URL: {ex.Message}", isError: true);
            return;
        }

        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    /// <summary>Uses the joystick.tv /echo endpoint to inject a sample Tipped event for testing.</summary>
    private async Task SendTestTip()
    {
        _sendingTest = true;
        try
        {
            using var req = new HttpRequestMessage(HttpMethod.Post, JoystickConstants.EchoUrl);
            req.Headers.Authorization = new AuthenticationHeaderValue("Basic", Settings.BasicKey);
            req.Content = new StringContent(
                "{\"sample\":{\"event\":\"StreamEvent\",\"data\":\"Tipped\"}}",
                Encoding.UTF8, "application/json");
            var resp = await Http.SendAsync(req);
            Log.AddLog(resp.IsSuccessStatusCode
                ? "Sent test tip via /echo"
                : $"Test tip failed ({(int)resp.StatusCode})", isError: !resp.IsSuccessStatusCode);
        }
        catch (Exception ex)
        {
            Log.AddLog($"Test tip error: {ex.Message}", isError: true);
        }
        finally
        {
            _sendingTest = false;
        }
    }

    public void Dispose()
    {
        Connection.ConnectionStateChanged -= OnStateChanged;
        Connection.ErrorOccurred -= OnError;
        Auth.StatusChanged -= OnAuthStatus;
        Log.LogChanged -= OnLogChanged;
    }
}
