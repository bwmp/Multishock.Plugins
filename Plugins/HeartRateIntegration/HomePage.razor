@page "/plugins/com-multishock-heartrateintegration/heart-rate"
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Logging.Abstractions
@implements IAsyncDisposable

    <PageHeader Title="Heart rate" Icon="heart-pulse" Description="Use readings from a Bluetooth heart-rate monitor in flows.">
        <Meta><span class="chip @(Snapshot.Error is not null ? "chip-danger" : Snapshot.State == HeartRateConnectionState.Connected ? "chip-ok" : Snapshot.State == HeartRateConnectionState.Reconnecting ? "chip-info" : Snapshot.State == HeartRateConnectionState.Connecting ? "chip-info" : "chip-neutral")" role="status"><span class="status-dot @StatusDotClass"></span> @StatusLabel</span></Meta>
        <Actions>            <div class="flex flex-wrap gap-2">
                @if (Scanning)
                {
                    <Button Text="Cancel scan" Variant="secondary" OnClick="CancelScan" />
                }
                else
                {
                    <Button Text="Scan for monitors" Icon="bluetooth" Disabled="Busy" OnClick="ScanAsync" />
                }
                @if (Snapshot.State != HeartRateConnectionState.Disconnected)
                {
                    <Button Text="Disconnect" Variant="secondary" Disabled="Busy" OnClick="DisconnectAsync" />
                }
            </div></Actions>
    </PageHeader>

<div class="max-w-4xl space-y-4">
    <Card Title="Live reading" Description="Readings expire after 10 seconds without an update. Use Heart Rate Received or Get Heart Rate in the flow editor.">
        <div class="flex flex-wrap items-baseline gap-2">
            @if (Snapshot.HasFreshReading(DateTimeOffset.UtcNow))
            {
                <span class="text-2xl font-semibold tabular-nums">@Snapshot.Latest!.BeatsPerMinute</span>
                <span class="text-app-muted">BPM</span>
            }
            else
            {
                <span class="text-2xl font-semibold" aria-hidden="true">--</span>
                <span class="text-app-muted" aria-hidden="true">BPM</span>
                <span class="sr-only">No reading</span>
            }
        </div>
        <span class="sr-only" aria-live="polite" aria-atomic="true">@ReadingAnnouncement</span>
        <p class="mt-2 text-sm text-app-muted">@Snapshot.StatusText(DateTimeOffset.UtcNow)</p>
        @if (Snapshot.Device is { } activeDevice)
        {
            <p class="mt-1 text-sm break-all">@activeDevice.Name</p>
        }
        @if (Snapshot.HasFreshReading(DateTimeOffset.UtcNow) && Snapshot.Latest is { } reading)
        {
            <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                <div><dt class="text-app-muted">Sensor contact</dt><dd>@ContactText(reading)</dd></div>
                @if (reading.RrIntervalsMilliseconds.Count > 0)
                {
                    <div><dt class="text-app-muted">Last RR interval</dt><dd>@reading.RrIntervalsMilliseconds[^1].ToString("0.0") ms</dd></div>
                }
                @if (reading.EnergyExpendedKilojoules is { } energy)
                {
                    <div><dt class="text-app-muted">Energy expended</dt><dd>@energy kJ</dd></div>
                }
            </dl>
        }
    </Card>

    @if (Snapshot.Error is { } error)
    {
        <Alert Variant="danger" Title="Monitor error">@error</Alert>
    }
    @if (Message is not null)
    {
        <Alert Variant="danger" Title="Scan failed">@Message</Alert>
    }

    <Card Title="Monitor connection" Description="Wear the H808S with its electrodes moistened to wake it. Enable Bluetooth in Windows and disconnect the strap from other Bluetooth apps before connecting here.">
        @if (Scanning)
        {
            <p class="text-sm text-app-muted" role="status">Scanning for nearby heart-rate monitors for 10 seconds…</p>
        }
        else if (Scanned && Devices.Count == 0)
        {
            <div class="py-2 text-sm text-app-muted"><p>No monitors found</p><p class="text-xs text-app-subtle">Check that the strap is awake and nearby, then scan again.</p></div>
        }
        else if (Devices.Count == 0)
        {
            <p class="py-2 text-sm text-app-muted">Scan for nearby heart-rate monitors to choose one.</p>
        }
        <ul class="divide-y divide-app-border">
            @foreach (var device in Devices)
            {
                <li @key="device.Address" class="flex flex-wrap items-center justify-between gap-3 py-3">
                    <div class="min-w-0">
                        <div class="font-medium break-all">@device.Name</div>
                        <div class="text-xs text-app-muted">@device.Address.ToString("X12") · @device.SignalStrength dBm</div>
                    </div>
                    <Button Text="Connect" Variant="secondary" Disabled="@(Busy || Scanning || (Snapshot.Device?.Address == device.Address && Snapshot.State != HeartRateConnectionState.Disconnected))"
                            AriaLabel="@($"Connect to {device.Name}")" OnClick="@(() => ConnectAsync(device))" />
                </li>
            }
        </ul>
    </Card>

    @if (History.Count > 0)
    {
        <Card Title="Recent readings" Description="History is kept in memory for this session.">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead><tr class="border-b border-app-border text-app-muted"><th scope="col" class="py-2 pr-4">Time</th><th scope="col" class="py-2 pr-4">BPM</th><th scope="col" class="py-2">Contact</th></tr></thead>
                    <tbody>
                        @foreach (var previousReading in History.Take(10))
                        {
                            <tr class="border-b border-app-border"><td class="py-2 pr-4 tabular-nums">@previousReading.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</td><td class="py-2 pr-4 tabular-nums">@previousReading.BeatsPerMinute</td><td class="py-2">@ContactText(previousReading)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </Card>
    }
</div>

@code {
    private string StatusLabel => Snapshot.Error is not null ? "Error" : Snapshot.State switch
    {
        HeartRateConnectionState.Connected => "Connected",
        HeartRateConnectionState.Connecting => "Connecting",
        HeartRateConnectionState.Reconnecting => "Reconnecting",
        _ => "Disconnected"
    };
    private string StatusDotClass => Snapshot.Error is not null ? "bg-app-danger" : Snapshot.State switch
    {
        HeartRateConnectionState.Connected => "bg-app-success",
        HeartRateConnectionState.Connecting => "bg-app-info",
        HeartRateConnectionState.Reconnecting => "bg-app-info",
        _ => "bg-app-subtle"
    };

    private HeartRateMonitor Monitor = null!;
    private ILogger Logger = NullLogger.Instance;
    private HeartRateSnapshot Snapshot = new(HeartRateConnectionState.Disconnected, null, null, null);
    private IReadOnlyList<HeartRateDevice> Devices = [];
    private IReadOnlyList<HeartRateMeasurement> History = [];
    private readonly CancellationTokenSource Lifetime = new();
    private CancellationTokenSource? ScanCancellation;
    private Task RefreshTask = Task.CompletedTask;
    private bool Scanning;
    private bool Scanned;
    private bool Busy;
    private string? Message;
    private string? ReadingAnnouncement;
    private string? AnnouncedStatus;
    private int? AnnouncedBpm;
    private DateTimeOffset LastAnnouncement;

    private void UpdateReadingAnnouncement()
    {
        var now = DateTimeOffset.UtcNow;
        int? bpm = Snapshot.HasFreshReading(now) ? Snapshot.Latest!.BeatsPerMinute : null;
        var statusChanged = AnnouncedStatus != StatusLabel;
        if (!statusChanged && (now - LastAnnouncement < TimeSpan.FromSeconds(10)
            || (bpm == AnnouncedBpm || (bpm.HasValue && AnnouncedBpm.HasValue && Math.Abs(bpm.Value - AnnouncedBpm.Value) < 5))))
            return;

        ReadingAnnouncement = $"{StatusLabel}. {(bpm.HasValue ? $"{bpm} BPM" : "No reading")}.";
        AnnouncedStatus = StatusLabel;
        AnnouncedBpm = bpm;
        LastAnnouncement = now;
    }

    private static string ContactText(HeartRateMeasurement reading) => reading.SensorContactDetected switch
    {
        true => "Detected", false => "Poor / no contact", null => "Not reported"
    };

    protected override void OnInitialized()
    {
        Monitor = PluginServiceLocator.GetRequiredService<HeartRateMonitor>(HeartRatePlugin.PluginId);
        Logger = PluginServiceLocator.GetService<IPluginHost>(HeartRatePlugin.PluginId)
            ?.CreateLogger("HeartRateIntegration.Plugin") ?? NullLogger.Instance;
        Snapshot = Monitor.Snapshot;
        UpdateReadingAnnouncement();
        History = Monitor.History;
        RefreshTask = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(Lifetime.Token))
                await InvokeAsync(() =>
                {
                    Snapshot = Monitor.Snapshot;
                    UpdateReadingAnnouncement();
                    History = Monitor.History;
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
    }

    private async Task ScanAsync()
    {
        Scanning = true;
        Message = null;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(Lifetime.Token);
        ScanCancellation = cancellation;
        try
        {
            Devices = await Monitor.ScanAsync(cancellation.Token);
            Scanned = true;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Heart-rate scan failed");
            Message = ex is InvalidOperationException ? ex.Message : "Scanning failed. Check your Bluetooth adapter and Windows permissions.";
        }
        finally
        {
            ScanCancellation = null;
            Scanning = false;
        }
    }

    private void CancelScan() => ScanCancellation?.Cancel();

    private async Task ConnectAsync(HeartRateDevice device)
    {
        Busy = true;
        try
        {
            await Monitor.ConnectAsync(device);
            Snapshot = Monitor.Snapshot;
            UpdateReadingAnnouncement();
            History = Monitor.History;
        }
        finally { Busy = false; }
    }

    private async Task DisconnectAsync()
    {
        Busy = true;
        try
        {
            await Monitor.DisconnectAsync();
            Snapshot = Monitor.Snapshot;
            UpdateReadingAnnouncement();
        }
        finally { Busy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        await Lifetime.CancelAsync();
        await RefreshTask;
        Lifetime.Dispose();
    }
}
