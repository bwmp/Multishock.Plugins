@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@using SteamVROverlay.Overlay
@using SteamVROverlay.Services
@implements IDisposable

<div class="max-w-4xl space-y-4">
<p class="text-sm text-app-muted">Changes save automatically.</p>
@if (!string.IsNullOrWhiteSpace(Overlay.LastError)) { <Alert Variant="danger" Title="SteamVR error">@Overlay.LastError</Alert> }
<Card Title="General">
    <SettingRow Label="Overlay enabled" Description="Allow the overlay to run. Turning this off stops it; turning it on makes Start available."><Toggle AriaLabel="Overlay enabled" Value="Settings.Enabled" ValueChanged="ToggleEnabled" /></SettingRow>
    <SettingRow Label="Start the overlay with MultiShock" Description="Start automatically when MultiShock opens, if the overlay is enabled."><Toggle AriaLabel="Start the overlay with MultiShock" Value="AutoStart" ValueChanged="ToggleAutoStart" /></SettingRow>
</Card>
<Card Title="Placement" Description="Offsets are in left-controller space: X right, Y up, Z toward your elbow. The right hand mirrors them.">
<Actions><Button Text="Reset placement" Variant="secondary" Size="sm" Icon="rotate-ccw" OnClick="ResetPlacement" /></Actions>
<ChildContent>
    <SettingRow Label="Attach to" Description="Choose the controller that carries the panel."><Select Class="[&_label]:sr-only" TValue="string"
                    Label="Attach to"
                    Options="HandOptions"
                    Value="@HandValue"
                    ValueChanged="OnHandChanged" /></SettingRow>
    <SettingRow Label="Panel width" Description="Set the physical width of the wrist panel in cm."><div class="flex items-center gap-3"><span class="shrink-0 text-xs text-app-muted tabular-nums">@((WidthMeters * 100).ToString("0.#")) cm</span><Slider ShowValue="false" Class="[&_label]:sr-only" Label="Panel width in cm"
                Min="5" Max="60" Step="1"
                Value="@(WidthMeters * 100)"
                ValueChanged="@(v => WidthMeters = (float)(v / 100))" /></div></SettingRow>
    <SettingRow WideControl="true" Class="!flex-col xl:!flex-row" Label="Position" Description="Offsets in left-controller space, mirrored for the right hand."><div class="grid w-full grid-cols-1 gap-2 sm:w-96 sm:grid-cols-3">
        <div><span class="mb-1.5 block text-xs font-medium text-app-muted" aria-hidden="true">X</span><NumberInput Class="[&_label]:sr-only" Label="X in centimetres" Suffix="cm" Min="-50" Max="50" Step="0.1" Value="OffsetXInput" Error="@OffsetXError" ValueChanged="@(v => SetOffsetX(v))" /></div>
        <div><span class="mb-1.5 block text-xs font-medium text-app-muted" aria-hidden="true">Y</span><NumberInput Class="[&_label]:sr-only" Label="Y in centimetres" Suffix="cm" Min="-50" Max="50" Step="0.1" Value="OffsetYInput" Error="@OffsetYError" ValueChanged="@(v => SetOffsetY(v))" /></div>
        <div><span class="mb-1.5 block text-xs font-medium text-app-muted" aria-hidden="true">Z</span><NumberInput Class="[&_label]:sr-only" Label="Z in centimetres" Suffix="cm" Min="-50" Max="50" Step="0.1" Value="OffsetZInput" Error="@OffsetZError" ValueChanged="@(v => SetOffsetZ(v))" /></div></div></SettingRow>
    <SettingRow WideControl="true" Class="!flex-col xl:!flex-row" Label="Rotation" Description="Tilt forward, turn sideways and rotate around the facing direction."><div class="grid w-full grid-cols-1 gap-2 sm:w-96 sm:grid-cols-3">
        <div><span class="mb-1.5 block text-xs font-medium text-app-muted" aria-hidden="true">Pitch</span><NumberInput Class="[&_label]:sr-only" Label="Pitch in degrees" Suffix="°" Min="-180" Max="180" Step="0.1" Value="PitchDegreesInput" Error="@PitchDegreesError" ValueChanged="@(v => SetPitchDegrees(v))" /></div>
        <div><span class="mb-1.5 block text-xs font-medium text-app-muted" aria-hidden="true">Yaw</span><NumberInput Class="[&_label]:sr-only" Label="Yaw in degrees" Suffix="°" Min="-180" Max="180" Step="0.1" Value="YawDegreesInput" Error="@YawDegreesError" ValueChanged="@(v => SetYawDegrees(v))" /></div>
        <div><span class="mb-1.5 block text-xs font-medium text-app-muted" aria-hidden="true">Roll</span><NumberInput Class="[&_label]:sr-only" Label="Roll in degrees" Suffix="°" Min="-180" Max="180" Step="0.1" Value="RollDegreesInput" Error="@RollDegreesError" ValueChanged="@(v => SetRollDegrees(v))" /></div></div></SettingRow>
    <SettingRow Label="Move the panel by grabbing it in VR" Description="Allow placement changes using the other controller."><Toggle AriaLabel="Move the panel by grabbing it in VR" Value="GrabToMove" ValueChanged="ToggleGrabToMove" /></SettingRow>
    <SettingRow Label="Opacity" Description="Panel visibility in percent, from 10% to fully opaque."><div class="flex items-center gap-3"><span class="shrink-0 text-xs text-app-muted tabular-nums">@((Opacity * 100).ToString("0.#"))%</span><Slider ShowValue="false" Class="[&_label]:sr-only" Label="Opacity in percent" Min="10" Max="100" Step="5"
                Value="@(Opacity * 100)"
                ValueChanged="@(v => Opacity = (float)(v / 100))" /></div></SettingRow>
    <SettingRow Label="Curvature" Description="Bend the panel in percent, from flat (0%) to fully curved (100%)."><div class="flex items-center gap-3"><span class="shrink-0 text-xs text-app-muted tabular-nums">@((Curvature * 100).ToString("0.#"))%</span><Slider ShowValue="false" Class="[&_label]:sr-only" Label="Curvature in percent" Min="0" Max="100" Step="5"
                Value="@(Curvature * 100)"
                ValueChanged="@(v => Curvature = (float)(v / 100))" /></div></SettingRow>
</ChildContent>
</Card>
<Card Title="Watch" Description="The time and shocker controls are always available.">
    <SettingRow Label="Device batteries" Description="Show the battery section on the watch."><Toggle AriaLabel="Device batteries" Value="ShowBatteries" ValueChanged="ToggleShowBatteries" /></SettingRow>
    <SettingRow Label="Media controls" Description="Show current media and playback controls."><Toggle AriaLabel="Media controls" Value="ShowMedia" ValueChanged="ToggleShowMedia" /></SettingRow>
    <SettingRow Label="Volume and microphone" Description="Show system volume and microphone controls."><Toggle AriaLabel="Volume and microphone" Value="ShowAudio" ValueChanged="ToggleShowAudio" /></SettingRow>
    <SettingRow Label="Performance" Description="Show VR performance measurements."><Toggle AriaLabel="Performance" Value="ShowPerformance" ValueChanged="ToggleShowPerformance" /></SettingRow>
@foreach (var item in ContributedItems) {
<SettingRow Label="@item.Label"><Toggle AriaLabel="@item.Label" Value="@Settings.IsWatchItemShown(item.Key)" ValueChanged="@(shown => SetWatchItemShown(item.Key, shown))" /></SettingRow>
}
</Card>
<Card Title="Visibility">
    <SettingRow Label="Only show when you turn your wrist toward you" Description="Hide the panel when your wrist faces away."><Toggle AriaLabel="Only show when you turn your wrist toward you"
                Value="GazeActivation"
                ValueChanged="ToggleGazeActivation" /></SettingRow>
@if (GazeActivation) {
    <SettingRow Label="Activation angle" Description="Maximum wrist angle in degrees that keeps the panel visible."><div class="flex items-center gap-3"><span class="shrink-0 text-xs text-app-muted tabular-nums">@(GazeAngleDegrees.ToString("0.#"))°</span><Slider ShowValue="false" Class="[&_label]:sr-only" Label="Activation angle in degrees" Min="10" Max="90" Step="5"
                    Value="@((double)GazeAngleDegrees)"
                    ValueChanged="@(v => GazeAngleDegrees = (float)v)" /></div></SettingRow>
}
@if (GazeActivation) {
    <SettingRow Label="Hide delay" Description="Wait this long before hiding a panel that faces away."><NumberInput Class="[&_label]:sr-only" Label="Hide delay" Step="50" Min="0" Max="5000"
                             Value="HideDelayMsInput" Error="@HideDelayMsError" Suffix="ms"
                             ValueChanged="SetHideDelayMs" /></SettingRow>
}
</Card>
<Card Title="Limits and safety">
    <SettingRow Label="Maximum intensity" Description="Upper limit in percent for actions sent from the wrist panel."><div class="flex items-center gap-3"><span class="shrink-0 text-xs text-app-muted tabular-nums">@((MaxIntensity).ToString("0.#"))%</span><Slider ShowValue="false" Class="[&_label]:sr-only" Label="Maximum intensity in percent" Min="1" Max="100" Step="1"
                Value="@((double)MaxIntensity)"
                ValueChanged="@(v => MaxIntensity = (int)v)" /></div></SettingRow>
    <SettingRow Label="Maximum duration" Description="Longest action in seconds the wrist panel can send."><div class="flex items-center gap-3"><span class="shrink-0 text-xs text-app-muted tabular-nums">@((MaxDurationSeconds).ToString("0.#")) s</span><Slider ShowValue="false" Class="[&_label]:sr-only" Label="Maximum duration in seconds" Min="0.1" Max="15" Step="0.1"
                Value="@MaxDurationSeconds"
                ValueChanged="@(v => MaxDurationSeconds = v)" /></div></SettingRow>
    <SettingRow Label="Starting intensity" Description="Initial intensity in percent when opening the shocker controls."><div class="flex items-center gap-3"><span class="shrink-0 text-xs text-app-muted tabular-nums">@((DefaultIntensity).ToString("0.#"))%</span><Slider ShowValue="false" Class="[&_label]:sr-only" Label="Starting intensity in percent" Min="1" Max="@MaxIntensity" Step="1"
                Value="@((double)DefaultIntensity)"
                ValueChanged="@(v => DefaultIntensity = (int)v)" /></div></SettingRow>
    <SettingRow Label="Starting duration" Description="Initial duration in seconds when opening the shocker controls."><div class="flex items-center gap-3"><span class="shrink-0 text-xs text-app-muted tabular-nums">@((DefaultDurationSeconds).ToString("0.#")) s</span><Slider ShowValue="false" Class="[&_label]:sr-only" Label="Starting duration in seconds" Min="0.1" Max="@MaxDurationSeconds" Step="0.1"
                Value="@DefaultDurationSeconds"
                ValueChanged="@(v => DefaultDurationSeconds = v)" /></div></SettingRow>
    <SettingRow Label="Require press-and-hold on the shock button" Description="Prevent a single click from sending a shock."><Toggle AriaLabel="Require press-and-hold on the shock button"
                Value="HoldToShock"
                ValueChanged="ToggleHoldToShock" /></SettingRow>
@if (HoldToShock) {
    <SettingRow Label="Hold time" Description="Hold the shock button this long before it fires."><NumberInput Class="[&_label]:sr-only" Label="Hold time" Step="50" Min="200" Max="3000"
                             Value="ShockHoldMsInput" Error="@ShockHoldMsError" Suffix="ms"
                             ValueChanged="SetShockHoldMs" /></SettingRow>
}
    <SettingRow Label="Send a warning vibration before each shock" Description="Give the wearer a vibration before the shock is sent."><Toggle AriaLabel="Send a warning vibration before each shock"
                Value="WarnBeforeShock"
                ValueChanged="ToggleWarnBeforeShock" /></SettingRow>
</Card>
</div>

@code {
    private double? OffsetXInput;
    private string? OffsetXError => ValidOffsetX(OffsetXInput) ? null : "Enter a number from -50 to 50.";
    private static bool ValidOffsetX(double? v) => v is { } value && double.IsFinite(value) && value >= -50 && value <= 50;
    private void SetOffsetX(double? v)
    {
        OffsetXInput = v;
        if (ValidOffsetX(v)) OffsetX = (float)(v!.Value / 100);
    }

    private double? OffsetYInput;
    private string? OffsetYError => ValidOffsetY(OffsetYInput) ? null : "Enter a number from -50 to 50.";
    private static bool ValidOffsetY(double? v) => v is { } value && double.IsFinite(value) && value >= -50 && value <= 50;
    private void SetOffsetY(double? v)
    {
        OffsetYInput = v;
        if (ValidOffsetY(v)) OffsetY = (float)(v!.Value / 100);
    }

    private double? OffsetZInput;
    private string? OffsetZError => ValidOffsetZ(OffsetZInput) ? null : "Enter a number from -50 to 50.";
    private static bool ValidOffsetZ(double? v) => v is { } value && double.IsFinite(value) && value >= -50 && value <= 50;
    private void SetOffsetZ(double? v)
    {
        OffsetZInput = v;
        if (ValidOffsetZ(v)) OffsetZ = (float)(v!.Value / 100);
    }

    private double? PitchDegreesInput;
    private string? PitchDegreesError => ValidPitchDegrees(PitchDegreesInput) ? null : "Enter a number from -180 to 180.";
    private static bool ValidPitchDegrees(double? v) => v is { } value && double.IsFinite(value) && value >= -180 && value <= 180;
    private void SetPitchDegrees(double? v)
    {
        PitchDegreesInput = v;
        if (ValidPitchDegrees(v)) PitchDegrees = (float)v!.Value;
    }

    private double? YawDegreesInput;
    private string? YawDegreesError => ValidYawDegrees(YawDegreesInput) ? null : "Enter a number from -180 to 180.";
    private static bool ValidYawDegrees(double? v) => v is { } value && double.IsFinite(value) && value >= -180 && value <= 180;
    private void SetYawDegrees(double? v)
    {
        YawDegreesInput = v;
        if (ValidYawDegrees(v)) YawDegrees = (float)v!.Value;
    }

    private double? RollDegreesInput;
    private string? RollDegreesError => ValidRollDegrees(RollDegreesInput) ? null : "Enter a number from -180 to 180.";
    private static bool ValidRollDegrees(double? v) => v is { } value && double.IsFinite(value) && value >= -180 && value <= 180;
    private void SetRollDegrees(double? v)
    {
        RollDegreesInput = v;
        if (ValidRollDegrees(v)) RollDegrees = (float)v!.Value;
    }

    private double? HideDelayMsInput;
    private string? HideDelayMsError => ValidHideDelayMs(HideDelayMsInput) ? null : "Enter a whole number from 0 to 5000.";
    private static bool ValidHideDelayMs(double? v) => v is { } value && double.IsFinite(value) && value >= 0 && value <= 5000 && value == Math.Floor(value);
    private void SetHideDelayMs(double? v)
    {
        HideDelayMsInput = v;
        if (ValidHideDelayMs(v)) HideDelayMs = (int)v!.Value;
    }

    private double? ShockHoldMsInput;
    private string? ShockHoldMsError => ValidShockHoldMs(ShockHoldMsInput) ? null : "Enter a whole number from 200 to 3000.";
    private static bool ValidShockHoldMs(double? v) => v is { } value && double.IsFinite(value) && value >= 200 && value <= 3000 && value == Math.Floor(value);
    private void SetShockHoldMs(double? v)
    {
        ShockHoldMsInput = v;
        if (ValidShockHoldMs(v)) ShockHoldMs = (int)v!.Value;
    }

    private static readonly string PluginIdValue = SteamVROverlayPlugin.PluginId;

    private static readonly IEnumerable<Select<string>.SelectOption<string>> HandOptions =
    [
        new("left", "Left controller"),
        new("right", "Right controller"),
    ];

    private OverlaySettingsService Settings =>
        PluginServiceLocator.GetRequiredService<OverlaySettingsService>(PluginIdValue);

    private WristOverlayService Overlay =>
        PluginServiceLocator.GetRequiredService<WristOverlayService>(PluginIdValue);

    private WatchProviderService WatchProviders =>
        PluginServiceLocator.GetRequiredService<WatchProviderService>(PluginIdValue);

    [Parameter]
    public string? PluginId { get; set; }

    private bool AutoStart;
    private IReadOnlyList<(string Key, string Label)> ContributedItems = [];

    protected override void OnInitialized()
    {
        OffsetXInput = Math.Round(Settings.OffsetX * 100.0, 1);
        OffsetYInput = Math.Round(Settings.OffsetY * 100.0, 1);
        OffsetZInput = Math.Round(Settings.OffsetZ * 100.0, 1);
        PitchDegreesInput = Math.Round((double)Settings.PitchDegrees, 1);
        YawDegreesInput = Math.Round((double)Settings.YawDegrees, 1);
        RollDegreesInput = Math.Round((double)Settings.RollDegrees, 1);
        HideDelayMsInput = Settings.HideDelayMs;
        ShockHoldMsInput = Settings.ShockHoldMs;
        AutoStart = Settings.AutoStart;
        Overlay.StateChanged += OnStateChanged;
        Settings.Changed += OnSettingsChanged;

        ContributedItems =
        [
            .. WatchProviders.Poll().SelectMany(c =>
                c.Content.Cards.Select(card => (WatchContent.CardKey(c.PluginId, card.Id), $"{card.Title ?? card.Id} card from {c.PluginName}"))
                    .Concat(c.Content.Pages.Select(page => (WatchContent.PageKey(c.PluginId, page.Id), $"{page.Title} page from {c.PluginName}"))))
        ];
    }

    private Task SetWatchItemShown(string key, bool shown)
    {
        Settings.SetWatchItemShown(key, shown);
        return Task.CompletedTask;
    }

    private string HandValue => Settings.Hand == OverlayHand.Right ? "right" : "left";

    private float WidthMeters
    {
        get => Settings.WidthMeters;
        set => Settings.WidthMeters = value;
    }

    private float OffsetX
    {
        get => Settings.OffsetX;
        set => Settings.OffsetX = value;
    }

    private float OffsetY
    {
        get => Settings.OffsetY;
        set => Settings.OffsetY = value;
    }

    private float OffsetZ
    {
        get => Settings.OffsetZ;
        set => Settings.OffsetZ = value;
    }

    private float PitchDegrees
    {
        get => Settings.PitchDegrees;
        set => Settings.PitchDegrees = value;
    }

    private float YawDegrees
    {
        get => Settings.YawDegrees;
        set => Settings.YawDegrees = value;
    }

    private float RollDegrees
    {
        get => Settings.RollDegrees;
        set => Settings.RollDegrees = value;
    }

    private float Opacity
    {
        get => Settings.Opacity;
        set => Settings.Opacity = value;
    }

    private float Curvature
    {
        get => Settings.Curvature;
        set => Settings.Curvature = value;
    }

    private bool GrabToMove => Settings.GrabToMove;

    private bool ShowBatteries => Settings.ShowBatteries;

    private bool ShowMedia => Settings.ShowMedia;

    private bool ShowAudio => Settings.ShowAudio;

    private bool ShowPerformance => Settings.ShowPerformance;

    private bool GazeActivation => Settings.GazeActivation;

    private float GazeAngleDegrees
    {
        get => Settings.GazeAngleDegrees;
        set => Settings.GazeAngleDegrees = value;
    }

    private int HideDelayMs
    {
        get => Settings.HideDelayMs;
        set => Settings.HideDelayMs = value;
    }

    private int MaxIntensity
    {
        get => Settings.MaxIntensity;
        set
        {
            var startingIntensity = Settings.DefaultIntensity;
            Settings.MaxIntensity = value;
            Settings.DefaultIntensity = Math.Min(startingIntensity, Settings.MaxIntensity);
        }
    }

    private double MaxDurationSeconds
    {
        get => Settings.MaxDurationSeconds;
        set
        {
            var startingDuration = Settings.DefaultDurationSeconds;
            Settings.MaxDurationSeconds = value;
            Settings.DefaultDurationSeconds = Math.Min(startingDuration, Settings.MaxDurationSeconds);
        }
    }

    private int DefaultIntensity
    {
        get => Settings.DefaultIntensity;
        set => Settings.DefaultIntensity = value;
    }

    private double DefaultDurationSeconds
    {
        get => Settings.DefaultDurationSeconds;
        set => Settings.DefaultDurationSeconds = value;
    }

    private bool HoldToShock => Settings.HoldToShock;

    private int ShockHoldMs
    {
        get => Settings.ShockHoldMs;
        set => Settings.ShockHoldMs = value;
    }

    private bool WarnBeforeShock => Settings.WarnBeforeShock;

    private void OnHandChanged(string? value)
    {
        Settings.Hand = string.Equals(value, "right", StringComparison.OrdinalIgnoreCase)
            ? OverlayHand.Right
            : OverlayHand.Left;
    }


    private void ToggleEnabled(bool enabled)
    {
        Settings.Enabled = enabled;
        if (!enabled) Overlay.Stop();
    }

    private Task ToggleAutoStart(bool enabled)
    {
        AutoStart = enabled;
        Settings.AutoStart = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleGrabToMove(bool enabled)
    {
        Settings.GrabToMove = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleShowBatteries(bool enabled)
    {
        Settings.ShowBatteries = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleShowMedia(bool enabled)
    {
        Settings.ShowMedia = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleShowAudio(bool enabled)
    {
        Settings.ShowAudio = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleShowPerformance(bool enabled)
    {
        Settings.ShowPerformance = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleGazeActivation(bool enabled)
    {
        Settings.GazeActivation = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleHoldToShock(bool enabled)
    {
        Settings.HoldToShock = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleWarnBeforeShock(bool enabled)
    {
        Settings.WarnBeforeShock = enabled;
        return Task.CompletedTask;
    }

    private void ResetPlacement()
    {
        Settings.ResetPlacement();
        OffsetXInput = Math.Round(Settings.OffsetX * 100.0, 1);
        OffsetYInput = Math.Round(Settings.OffsetY * 100.0, 1);
        OffsetZInput = Math.Round(Settings.OffsetZ * 100.0, 1);
        PitchDegreesInput = Math.Round((double)Settings.PitchDegrees, 1);
        YawDegreesInput = Math.Round((double)Settings.YawDegrees, 1);
        RollDegreesInput = Math.Round((double)Settings.RollDegrees, 1);
    }

    private void OnStateChanged(OverlayRuntimeState state) => InvokeAsync(StateHasChanged);

    // Moving the panel in VR saves its placement from the overlay thread; show the new offsets.
    private void OnSettingsChanged() => InvokeAsync(() =>
    {
        if (ValidOffsetX(OffsetXInput)) OffsetXInput = Math.Round(Settings.OffsetX * 100.0, 1);
        if (ValidOffsetY(OffsetYInput)) OffsetYInput = Math.Round(Settings.OffsetY * 100.0, 1);
        if (ValidOffsetZ(OffsetZInput)) OffsetZInput = Math.Round(Settings.OffsetZ * 100.0, 1);
        if (ValidPitchDegrees(PitchDegreesInput)) PitchDegreesInput = Math.Round((double)Settings.PitchDegrees, 1);
        if (ValidYawDegrees(YawDegreesInput)) YawDegreesInput = Math.Round((double)Settings.YawDegrees, 1);
        if (ValidRollDegrees(RollDegreesInput)) RollDegreesInput = Math.Round((double)Settings.RollDegrees, 1);
        if (ValidHideDelayMs(HideDelayMsInput)) HideDelayMsInput = Settings.HideDelayMs;
        if (ValidShockHoldMs(ShockHoldMsInput)) ShockHoldMsInput = Settings.ShockHoldMs;
        StateHasChanged();
    });

    public void Dispose()
    {
        Overlay.StateChanged -= OnStateChanged;
        Settings.Changed -= OnSettingsChanged;
    }
}
