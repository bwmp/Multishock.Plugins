@page "/plugins/com-multishock-fanslyintegration/events-config"
@implements IDisposable

<PageHeader Title="Follows and subscriptions" Icon="user-plus"
            Description="Run a shocker action when someone follows or subscribes. Each reaction runs only while its switch is on; you can set it up first. Changes save automatically.">
    <Breadcrumb><BackLink /></Breadcrumb>
</PageHeader>

<div class="max-w-4xl space-y-4">
    <Card Title="Event reactions">
        <div class="divide-y divide-app-border">
            <EventReactionRow Title="New follower" Icon="user-plus" Config="Events.Config.Follow"
                              Description="When a viewer follows you." OnChanged="SaveEvents" />
            <EventReactionRow Title="New subscriber" Icon="star" Config="Events.Config.Subscribe"
                              Description="When a viewer subscribes or is gifted a subscription." OnChanged="SaveEvents" />
        </div>
    </Card>
</div>

@code {
    private static readonly string PluginId = FanslyIntegrationPlugin.PluginId;
    private EventsConfigService Events => PluginServiceLocator.GetRequiredService<EventsConfigService>(PluginId);

    protected override void OnInitialized()
    {
        Events.ConfigChanged += OnConfigChanged;
    }

    private void OnConfigChanged() => InvokeAsync(StateHasChanged);

    private void SaveEvents() => Events.SaveConfig();

    public void Dispose()
    {
        Events.ConfigChanged -= OnConfigChanged;
    }
}
