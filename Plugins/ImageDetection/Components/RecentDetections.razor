@using ImageDetection.Models
@using ImageDetection.Services
@using MultiShock.PluginSdk.Components
@inject RecentDetectionsService DetectionHistory
@inject ImageConfigService ConfigService
@implements IDisposable

<Card Title="Detections"
      Description="@(_detections.Count == 0 ? null : $"Showing the latest {Plural(_detections.Count, "detection", "detections")}. Select one to see the full screenshot.")"
      NoPadding="true"
      Footer="@(_detections.Count > 0 && _stats != null ? StatsFooter : null)">
    <Actions>
        @if (_detections.Count > 0)
        {
            <Button Text="Clear" Icon="trash-2" Variant="ghost" Size="sm" OnClick="ClearDetections" />
        }
    </Actions>
    <ChildContent>
        @if (_detections.Count > 0)
        {
            <ul class="max-h-[60vh] divide-y divide-app-border overflow-y-auto">
                @foreach (var detection in _detections)
                {
                    <li>
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-app-surface-2 focus-visible:bg-app-surface-2 focus-visible:outline-none"
                                aria-label="@($"Show details for {detection.ImageName} in {detection.ModuleName}")"
                                @onclick="() => ShowDetails(detection)">
                            <span class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-ctl border border-app-border bg-app-surface-2">
                                @if (GetThumbnailPath(detection) is { } thumbnail)
                                {
                                    <img src="@GetImageDataUrl(thumbnail)" alt="" class="h-full w-full object-cover" />
                                }
                                else
                                {
                                    <LucideIcon Name="image" Size="18" Class="text-app-subtle" />
                                }
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm font-medium text-app-text">@detection.ImageName</span>
                                <span class="block truncate text-xs text-app-muted">@detection.ModuleName</span>
                            </span>
                            <span class="hidden shrink-0 text-xs tabular-nums text-app-muted sm:block" title="Match confidence">
                                @((detection.Confidence * 100).ToString("F0"))% match
                            </span>
                            <span class="w-24 shrink-0 text-right">
                                @if (detection.ActionTriggered)
                                {
                                    <Badge Variant="neutral">@(detection.ActionType ?? "Action")</Badge>
                                }
                                else if (detection.WasInCooldown)
                                {
                                    <Badge Variant="warning">Cooldown</Badge>
                                }
                                else
                                {
                                    <span class="text-xs text-app-subtle">No action</span>
                                }
                            </span>
                            <span class="w-16 shrink-0 text-right font-mono text-xs text-app-subtle" title="@detection.Timestamp.ToString("g")">@detection.TimeAgo</span>
                        </button>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="px-4 py-2 text-sm text-app-muted"><p>No detections yet</p><p class="text-xs text-app-subtle">Detections appear here when a target is found on screen while detection is running.</p></div>
        }
    </ChildContent>
</Card>

<Modal IsOpen="@(_selectedDetection != null)" Title="Detection details" Size="xl" OnClose="CloseDetails">
    @if (_selectedDetection is { } selected)
    {
        @if (!string.IsNullOrEmpty(selected.ScreenshotPath) && File.Exists(selected.ScreenshotPath))
        {
            <div class="relative mx-auto mb-4 w-full max-w-4xl overflow-hidden rounded-ctl border border-app-border bg-app-surface-2">
                <img src="@GetImageDataUrl(selected.ScreenshotPath)" alt="Screenshot of the detection" class="h-auto w-full object-contain" />
                <div class="pointer-events-none absolute border-2 border-app-success bg-app-success/20"
                     style="left: @GetMarkerLeft(); top: @GetMarkerTop(); width: @GetMarkerWidth(); height: @GetMarkerHeight();">
                </div>
            </div>
        }
        <dl class="grid grid-cols-1 gap-x-8 text-sm sm:grid-cols-2">
            <div class="flex justify-between gap-4 border-b border-app-border py-2">
                <dt class="text-app-muted">Target</dt>
                <dd class="truncate font-medium text-app-text">@selected.ImageName</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-app-border py-2">
                <dt class="text-app-muted">Module</dt>
                <dd class="truncate font-medium text-app-text">@selected.ModuleName</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-app-border py-2">
                <dt class="text-app-muted">Time</dt>
                <dd class="font-mono text-xs text-app-text">@selected.Timestamp.ToString("F")</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-app-border py-2">
                <dt class="text-app-muted">Match confidence</dt>
                <dd class="tabular-nums text-app-text">@((selected.Confidence * 100).ToString("F2"))%</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-app-border py-2">
                <dt class="text-app-muted">Location</dt>
                <dd class="font-mono text-xs text-app-text">@selected.LocationX, @selected.LocationY</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-app-border py-2">
                <dt class="text-app-muted">Detection time</dt>
                <dd class="font-mono text-xs text-app-text">@selected.DetectionTime.TotalMilliseconds.ToString("F0") ms</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-app-border py-2">
                <dt class="text-app-muted">Result</dt>
                <dd class="text-app-text">
                    @if (selected.ActionTriggered)
                    {
                        @($"{selected.ActionType ?? "Action"} sent")
                    }
                    else if (selected.WasInCooldown)
                    {
                        <span class="text-app-warning">In cooldown, no action sent</span>
                    }
                    else
                    {
                        @("No action")
                    }
                </dd>
            </div>
        </dl>
    }
</Modal>

@code {
    private RenderFragment StatsFooter => @<div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-app-muted">
        <span>Last 24 hours</span>
        <span><span class="tabular-nums text-app-text">@_stats!.TotalDetections</span> detections</span>
        <span><span class="tabular-nums text-app-text">@_stats!.ActionsTriggered</span> actions sent</span>
        <span><span class="tabular-nums text-app-text">@((_stats!.AverageConfidence * 100).ToString("F1"))%</span> average match</span>
    </div>;

    private List<DetectionEvent> _detections = [];
    private DetectionHistoryStats? _stats;
    private DetectionEvent? _selectedDetection;

    protected override void OnInitialized()
    {
        RefreshDetections();
        DetectionHistory.DetectionRecorded += OnDetectionRecorded;
        DetectionHistory.DetectionsCleared += OnDetectionsCleared;
    }

    public void Dispose()
    {
        DetectionHistory.DetectionRecorded -= OnDetectionRecorded;
        DetectionHistory.DetectionsCleared -= OnDetectionsCleared;
    }

    private void OnDetectionRecorded(DetectionEvent evt)
    {
        InvokeAsync(() =>
        {
            RefreshDetections();
            StateHasChanged();
        });
    }

    private void OnDetectionsCleared()
    {
        InvokeAsync(() =>
        {
            RefreshDetections();
            StateHasChanged();
        });
    }

    private void RefreshDetections()
    {
        // Show up to MaxDisplayEvents (default 50) most recent detections
        _detections = DetectionHistory.GetRecentDetections(DetectionHistory.MaxDisplayEvents);
        _stats = DetectionHistory.GetStats(TimeSpan.FromHours(24));
    }

    private void ClearDetections()
    {
        DetectionHistory.ClearDetections();
    }

    private void ShowDetails(DetectionEvent detection)
    {
        _selectedDetection = detection;
    }

    private void CloseDetails()
    {
        _selectedDetection = null;
    }

    private string GetImageDataUrl(string path)
    {
        try
        {
            var bytes = File.ReadAllBytes(path);
            var base64 = Convert.ToBase64String(bytes);
            return $"data:image/png;base64,{base64}";
        }
        catch
        {
            return "";
        }
    }

    private static string? GetThumbnailPath(DetectionEvent detection)
    {
        if (!string.IsNullOrEmpty(detection.ThumbnailPath) && File.Exists(detection.ThumbnailPath))
            return detection.ThumbnailPath;
        if (!string.IsNullOrEmpty(detection.ScreenshotPath) && File.Exists(detection.ScreenshotPath))
            return detection.ScreenshotPath;
        return null;
    }

    private static string Plural(int count, string singular, string plural)
        => $"{count} {(count == 1 ? singular : plural)}";

    private string GetMarkerLeft() => _selectedDetection?.LocationX + "px";
    private string GetMarkerTop() => _selectedDetection?.LocationY + "px";
    private string GetMarkerWidth() => "50px"; // Approximate
    private string GetMarkerHeight() => "50px"; // Approximate
}
