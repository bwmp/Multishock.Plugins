@using Microsoft.AspNetCore.Components.Forms
@inject ImageDetectionService DetectionService
@inject ImageConfigService ConfigService
@inject IScreenCaptureService CaptureService
@inject RegionPickerArmService PickerArmService
@inject IPluginHost PluginHost
@implements IDisposable

@* Module editor host: target selection, target creation (upload / capture /
   meter / OCR), deletion, and the shared modals (region picker, visual grid
   selector, resolution dialog). The per-target editing UI lives in
   Components/TargetEditors. *@

<div class="flex flex-col gap-5 lg:flex-row lg:items-start">
    <aside class="lg:sticky lg:top-24 lg:w-72 lg:shrink-0">
        <Card NoPadding="true">
            <Header>
                <div class="flex w-full items-center justify-between gap-2">
                    <div class="panel-title">Targets</div>
                    <span class="text-xs text-app-subtle">@(SelectedModuleData?.Images.Count ?? 0)</span>
                </div>
            </Header>
            <ChildContent>
                @if (SelectedModuleData == null || SelectedModuleData.Images.Count == 0)
                {
                    <p class="px-4 py-3 text-sm text-app-muted">No targets yet. Add one below.</p>
                }
                else
                {
                    <ul class="max-h-96 overflow-y-auto py-1">
                        @foreach (var image in SelectedModuleData.Images.Values)
                        {
                            var isSelected = image.Id == SelectedImageId;
                            var hasIssues = DetectionService.GetTargetIssues(image).Count > 0;
                            <li>
                                <button type="button"
                                        class="flex w-full items-center gap-3 border-l-2 px-4 py-2 text-left transition-colors @(isSelected ? "border-app-primary bg-app-surface-2" : "border-transparent hover:bg-app-surface-2")"
                                        aria-current="@(isSelected ? "true" : null)"
                                        @onclick="() => SelectImage(image.Id)">
                                    <LucideIcon Name="@TargetIcon(image.TargetType)" Size="16"
                                                Class="@($"shrink-0 {(isSelected ? "text-app-text" : "text-app-muted")}")" />
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate text-sm @(image.Enabled ? "text-app-text" : "text-app-subtle")">@image.Name</span>
                                        <span class="block text-xs text-app-subtle">
                                            @TargetLabel(image.TargetType)@(image.Enabled ? "" : " · Off")
                                        </span>
                                    </span>
                                    @if (hasIssues)
                                    {
                                        <span class="shrink-0" title="Needs attention">
                                            <LucideIcon Name="triangle-alert" Size="14" Class="text-app-warning" />
                                            <span class="sr-only">Needs attention</span>
                                        </span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                }

                <div class="border-t border-app-border p-3">
                    <div class="section-label mb-2">Add target</div>
                    <div class="grid grid-cols-2 gap-2">
                        <Button Text="Capture" Icon="crop" Variant="secondary" Size="sm"
                                Title="Take a screenshot and drag a rectangle around the thing to detect"
                                OnClick="CaptureTemplateFromScreen" />
                        <label class="inline-flex h-7 cursor-pointer select-none items-center justify-center gap-1.5 rounded-ctl border border-app-border bg-app-surface-2 px-2.5 text-xs font-medium leading-none text-app-text transition-colors hover:border-app-border-strong hover:bg-app-surface-3 focus-within:ring-2 focus-within:ring-app-primary"
                               title="Upload a PNG or JPG of the thing to detect">
                            <LucideIcon Name="upload" Size="16" Class="shrink-0" />
                            <span>Upload</span>
                            <InputFile OnChange="HandleFileUpload" accept=".png,.jpg,.jpeg" class="sr-only" />
                        </label>
                        <Button Text="Health bar" Icon="heart-pulse" Variant="secondary" Size="sm"
                                Title="Read how full a health bar is and react when it drops"
                                OnClick="CreateMeterTarget" />
                        <Button Text="Text / number" Icon="type" Variant="secondary" Size="sm"
                                Title="Read text or numbers in a screen region"
                                OnClick="CreateOcrTarget" />
                    </div>
                    <p class="mt-2 text-xs text-app-subtle">Capture or upload an image to match it on screen.</p>
                </div>
            </ChildContent>
        </Card>
    </aside>

    <section class="min-w-0 flex-1 space-y-4">
        @if (SelectedImage != null)
        {
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-app-border pb-4">
                <div class="flex min-w-0 items-center gap-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-ctl border border-app-border bg-app-surface-2">
                        <LucideIcon Name="@TargetIcon(SelectedImage.TargetType)" Size="18" Class="text-app-muted" />
                    </div>
                    <div class="min-w-0">
                        <h2 class="truncate text-base font-semibold text-app-text">@SelectedImage.Name</h2>
                        <p class="text-xs text-app-muted">@TargetDescription(SelectedImage.TargetType)</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <Toggle Label="Enabled" Value="SelectedImage.Enabled" ValueChanged="OnImageEnabledChanged" />
                    <Button Text="Delete" Icon="trash-2" Variant="danger" Size="sm" OnClick="ConfirmDeleteImage" />
                </div>
            </div>

            <TargetStatusPanel ModuleId="@ModuleId" Image="SelectedImage" />

            @if (SelectedImage.TargetType == DetectionTargetType.Meter)
            {
                <MeterTargetEditor ModuleId="@ModuleId" Image="SelectedImage"
                                   OnPickRegion="CaptureAndOpenPicker" />
            }
            else if (SelectedImage.TargetType == DetectionTargetType.Ocr)
            {
                <OcrTargetEditor ModuleId="@ModuleId" Image="SelectedImage"
                                 OnPickRegion="CaptureAndOpenPicker" />
            }
            else
            {
                <TemplateRegionCard ModuleId="@ModuleId" Image="SelectedImage"
                                    OnPickRegion="CaptureAndOpenPicker"
                                    OnOpenVisualSelector="OpenVisualSelector" />
            }

            <ActionSettingsCard ModuleId="@ModuleId" Image="SelectedImage" />
        }
        else
        {
            <EmptyState Icon="scan-eye"
                        Title="No targets in this module"
                        Description="Add a target to start detecting: capture or upload an image to match, or read a health bar or on-screen text." />
        }
    </section>
</div>

<ConfirmDialog IsOpen="ShowDeleteConfirmDialog"
               Title="Delete target"
               Message="@DeleteConfirmMessage"
               ConfirmText="Delete"
               OnCancel="CancelDelete"
               OnConfirm="ExecuteDelete" />

<VisualSectionSelector
    IsVisible="ShowVisualSelector"
    MonitorIndex="SelectedMonitor"
    SectionStates="SelectedImage?.Region.GridSections?.Sections"
    OnSelectionChanged="OnVisualSelectionChanged"
    OnClose="CloseVisualSelector" />

<ResolutionInputDialog
    IsVisible="ShowResolutionDialog"
    DefaultResolution="_pendingUploadResolution"
    CurrentMonitorResolution="Monitors.FirstOrDefault(m => m.Index == SelectedMonitor)?.Resolution"
    OnConfirm="OnResolutionConfirmed"
    OnCancel="CancelUpload" />

<RegionPickerModal @ref="_regionPickerModal"
    IsVisible="_showRegionPicker"
    TargetName="@(_regionPickerTargetName)"
    InitialRegion="@(_regionPickerInitialRegion)"
    OnApply="OnRegionPickerApply"
    OnCancel="OnRegionPickerCancel" />

<style>
    .region-preview-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
    }

    .region-preview-layout.has-preview {
        grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
        align-items: start;
    }
</style>

@code {
    [Parameter, EditorRequired] public string ModuleId { get; set; } = string.Empty;

    private int SelectedMonitor => ConfigService.CaptureConfig.MonitorIndex;

    private List<MonitorInfo> Monitors = [];
    private string? SelectedImageId;

    private string? _lastModuleId;
    private bool ShowDeleteConfirmDialog;
    private string DeleteConfirmMessage = string.Empty;
    private Action? DeleteAction;

    private bool ShowVisualSelector;
    private bool ShowResolutionDialog;
    private byte[]? _pendingUploadBytes;
    private string? _pendingUploadFileName;
    private Resolution? _pendingUploadResolution;

    private Timer? _liveRefreshTimer;

    private RegionPickerModal? _regionPickerModal;
    private bool _showRegionPicker;
    private string? _regionPickerTargetName;
    private ScreenRegion? _regionPickerInitialRegion;
    private string? _regionPickerTargetId;
    private Emgu.CV.Mat? _regionPickerScreenshot;
    private bool _regionPickerCaptureMode;

    private DetectionModule? SelectedModuleData =>
        !string.IsNullOrWhiteSpace(ModuleId) && ConfigService.Modules.TryGetValue(ModuleId, out var module)
            ? module
            : null;

    private DetectionImage? SelectedImage =>
        SelectedModuleData?.Images.TryGetValue(SelectedImageId ?? string.Empty, out var image) == true
            ? image
            : null;

    protected override void OnInitialized()
    {
        LoadEditorData();

        DetectionService.RunningStateChanged += OnRunningStateChanged;
        ConfigService.ConfigurationChanged += OnConfigChanged;
        PickerArmService.Armed += OnPickerArmed;
        PickerArmService.Disarmed += OnPickerDisarmed;
        PickerArmService.Triggered += OnPickerTriggered;

        if (DetectionService.IsRunning)
        {
            _liveRefreshTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, 0, 500);
        }
    }

    protected override void OnParametersSet()
    {
        if (_lastModuleId != ModuleId)
        {
            _lastModuleId = ModuleId;
            SelectedImageId = SelectedModuleData?.Images.Keys.FirstOrDefault();
        }

        EnsureSelectedImage();
    }

    public void Dispose()
    {
        _liveRefreshTimer?.Dispose();
        _liveRefreshTimer = null;
        DetectionService.RunningStateChanged -= OnRunningStateChanged;
        ConfigService.ConfigurationChanged -= OnConfigChanged;
        PickerArmService.Armed -= OnPickerArmed;
        PickerArmService.Disarmed -= OnPickerDisarmed;
        PickerArmService.Triggered -= OnPickerTriggered;
        _regionPickerScreenshot?.Dispose();
    }

    private void LoadEditorData()
    {
        Monitors = CaptureService.GetMonitors();
        EnsureSelectedImage();
    }

    private void EnsureSelectedImage()
    {
        if (SelectedModuleData == null)
        {
            SelectedImageId = null;
            return;
        }

        if (SelectedImageId == null || !SelectedModuleData.Images.ContainsKey(SelectedImageId))
        {
            SelectedImageId = SelectedModuleData.Images.Keys.FirstOrDefault();
        }
    }

    private void OnRunningStateChanged(bool running)
    {
        if (running)
        {
            _liveRefreshTimer ??= new Timer(_ => InvokeAsync(StateHasChanged), null, 0, 500);
        }
        else
        {
            _liveRefreshTimer?.Dispose();
            _liveRefreshTimer = null;
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnConfigChanged()
    {
        InvokeAsync(() =>
        {
            LoadEditorData();
            StateHasChanged();
        });
    }

    private void SelectImage(string imageId)
    {
        SelectedImageId = imageId;
    }

    private static string TargetIcon(DetectionTargetType type) => type switch
    {
        DetectionTargetType.Meter => "heart-pulse",
        DetectionTargetType.Ocr => "type",
        _ => "image",
    };

    private static string TargetLabel(DetectionTargetType type) => type switch
    {
        DetectionTargetType.Meter => "Health bar",
        DetectionTargetType.Ocr => "Text / number",
        _ => "Image match",
    };

    private static string TargetDescription(DetectionTargetType type) => type switch
    {
        DetectionTargetType.Meter => "Health bar · reacts when the bar's fill level changes",
        DetectionTargetType.Ocr => "Text / number · reacts to keywords or number changes in a screen region",
        _ => "Image match · reacts when this image appears on screen",
    };

    private void OnImageEnabledChanged(bool enabled)
    {
        if (string.IsNullOrEmpty(ModuleId) || SelectedImageId == null) return;
        ConfigService.SetImageEnabled(ModuleId, SelectedImageId, enabled);
        StateHasChanged();
    }

    private void SaveImageConfig()
    {
        if (string.IsNullOrEmpty(ModuleId) || SelectedImageId == null || SelectedImage == null) return;
        ConfigService.UpdateImage(ModuleId, SelectedImage);
    }

    private Resolution? GetSelectedMonitorResolution()
    {
        var resolution = Monitors.FirstOrDefault(m => m.Index == SelectedMonitor)?.Resolution;
        return resolution == null ? null : new Resolution(resolution.Width, resolution.Height);
    }

    // ===== Upload flow =====

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(ModuleId)) return;

        try
        {
            var file = e.File;
            if (file.Size > 10 * 1024 * 1024)
            {
                PluginHost.ShowErrorToast("Upload Failed", "File too large. Maximum size is 10MB.");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            _pendingUploadBytes = ms.ToArray();
            _pendingUploadFileName = file.Name;

            var monitor = Monitors.FirstOrDefault(m => m.Index == SelectedMonitor);
            _pendingUploadResolution = monitor?.Resolution ?? new Resolution(1920, 1080);

            ShowResolutionDialog = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            PluginHost.ShowErrorToast("Upload Failed", $"Failed to read file: {ex.Message}");
        }
    }

    private async Task CompleteUpload(Resolution captureResolution)
    {
        if (string.IsNullOrEmpty(ModuleId) || _pendingUploadBytes == null || _pendingUploadFileName == null) return;

        try
        {
            var moduleDir = Path.GetDirectoryName(SelectedModuleData?.Images.Values.FirstOrDefault()?.FilePath)
                           ?? Path.Combine(ConfigService.ModulesDirectory, ModuleId);
            Directory.CreateDirectory(moduleDir);

            var fileName = Path.GetFileName(_pendingUploadFileName);
            var filePath = Path.Combine(moduleDir, fileName);

            var counter = 1;
            while (File.Exists(filePath))
            {
                var nameWithoutExt = Path.GetFileNameWithoutExtension(fileName);
                var ext = Path.GetExtension(fileName);
                filePath = Path.Combine(moduleDir, $"{nameWithoutExt}_{counter++}{ext}");
            }

            await File.WriteAllBytesAsync(filePath, _pendingUploadBytes);

            var imageId = Path.GetFileName(filePath);
            var image = new DetectionImage
            {
                Id = imageId,
                Name = Path.GetFileNameWithoutExtension(_pendingUploadFileName),
                FilePath = filePath,
                Enabled = true,
                Threshold = 0.8,
                CaptureResolution = captureResolution,
                AutoResize = true,
                Action = new ActionConfig { Enabled = true, Type = ActionType.Shock, Intensity = 50, DurationSeconds = 1 },
                Cooldown = new CooldownConfig { Type = CooldownType.Standard, DurationSeconds = 30 },
                Region = new RegionConfig { Type = RegionType.FullScreen }
            };

            ConfigService.AddImage(ModuleId, image);
            SelectedImageId = imageId;

            _pendingUploadBytes = null;
            _pendingUploadFileName = null;
            _pendingUploadResolution = null;

            LoadEditorData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            PluginHost.ShowErrorToast("Upload Failed", $"Failed to save image: {ex.Message}");
        }
    }

    private void CancelUpload()
    {
        _pendingUploadBytes = null;
        _pendingUploadFileName = null;
        _pendingUploadResolution = null;
        ShowResolutionDialog = false;
        StateHasChanged();
    }

    private async Task OnResolutionConfirmed(Resolution resolution)
    {
        ShowResolutionDialog = false;
        await CompleteUpload(resolution);
    }

    // ===== Target creation / deletion =====

    private void ConfirmDeleteImage()
    {
        if (SelectedImage == null) return;

        DeleteConfirmMessage = $"Delete \"{SelectedImage.Name}\"? This can't be undone.";
        DeleteAction = () =>
        {
            if (!string.IsNullOrEmpty(ModuleId) && SelectedImageId != null)
            {
                ConfigService.DeleteImage(ModuleId, SelectedImageId);
                SelectedImageId = null;
                LoadEditorData();
                SelectedImageId = SelectedModuleData?.Images.Keys.FirstOrDefault();
            }
        };
        ShowDeleteConfirmDialog = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        ShowDeleteConfirmDialog = false;
        DeleteAction = null;
    }

    private void ExecuteDelete()
    {
        ShowDeleteConfirmDialog = false;
        DeleteAction?.Invoke();
        DeleteAction = null;
        StateHasChanged();
    }

    private void CreateMeterTarget()
    {
        if (string.IsNullOrEmpty(ModuleId)) return;

        var id = $"meter-{DateTime.UtcNow:yyyyMMddHHmmss}";
        var image = new DetectionImage
        {
            Id = id,
            Name = "Health Bar",
            TargetType = DetectionTargetType.Meter,
            Enabled = true,
            Threshold = 0.8,
            CaptureResolution = Monitors.FirstOrDefault(m => m.Index == SelectedMonitor)?.Resolution ?? new Resolution(1920, 1080),
            AutoResize = false,
            Action = new ActionConfig { Enabled = true, Type = ActionType.Shock, Intensity = 50, DurationSeconds = 1 },
            Cooldown = new CooldownConfig { Type = CooldownType.Standard, DurationSeconds = 1 },
            Region = new RegionConfig
            {
                Type = RegionType.Custom,
                CustomRegion = new ScreenRegion(0, 0, 200, 30),
                ReferenceResolution = GetSelectedMonitorResolution()
            },
            Meter = new MeterDetectionConfig
            {
                Enabled = true,
                Direction = MeterFillDirection.LeftToRight,
                MinDeltaPercent = 2.0,
                SmoothingFrames = 3,
                EventCooldownMs = 300,
                DecreasesOnly = true
            }
        };

        ConfigService.AddImage(ModuleId, image);
        SelectedImageId = id;
        LoadEditorData();
        StateHasChanged();
    }

    private void CreateOcrTarget()
    {
        if (string.IsNullOrEmpty(ModuleId)) return;

        var id = $"ocr-{DateTime.UtcNow:yyyyMMddHHmmss}";
        var image = new DetectionImage
        {
            Id = id,
            Name = "Text Detector",
            TargetType = DetectionTargetType.Ocr,
            Enabled = true,
            Threshold = 0.8,
            CaptureResolution = Monitors.FirstOrDefault(m => m.Index == SelectedMonitor)?.Resolution ?? new Resolution(1920, 1080),
            AutoResize = false,
            Action = new ActionConfig { Enabled = true, Type = ActionType.Vibrate, Intensity = 50, DurationSeconds = 1 },
            Cooldown = new CooldownConfig { Type = CooldownType.Standard, DurationSeconds = 1 },
            Region = new RegionConfig
            {
                Type = RegionType.Custom,
                CustomRegion = new ScreenRegion(0, 0, 300, 80),
                ReferenceResolution = GetSelectedMonitorResolution()
            },
            Ocr = new OcrDetectionConfig
            {
                Enabled = true,
                Mode = OcrDetectionMode.KeywordOrNumber,
                Keywords = ["Eliminated"],
                NumberRegex = @"-?\d+(?:\.\d+)?",
                MinNumberDelta = 1,
                SmoothingFrames = 3,
                EventCooldownMs = 300,
                UseThresholding = true,
                PreprocessScale = 2.0,
                CharacterWhitelist = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+-"
            }
        };

        ConfigService.AddImage(ModuleId, image);
        SelectedImageId = id;
        LoadEditorData();
        StateHasChanged();
    }

    // ===== Visual grid-section selector =====

    private void OpenVisualSelector()
    {
        if (SelectedImage?.Region.Type == RegionType.Grid)
        {
            ShowVisualSelector = true;
            StateHasChanged();
        }
    }

    private void OnVisualSelectionChanged(bool[] sections)
    {
        if (SelectedImage?.Region.GridSections != null)
        {
            SelectedImage.Region.GridSections.Sections = sections;
            SaveImageConfig();
        }
    }

    private void CloseVisualSelector()
    {
        ShowVisualSelector = false;
        StateHasChanged();
    }

    // ===== Region picker plumbing =====

    private void CaptureAndOpenPicker()
    {
        if (string.IsNullOrEmpty(ModuleId) || string.IsNullOrEmpty(SelectedImageId) || SelectedImage == null) return;

        try
        {
            var screenshot = CaptureService.CaptureMonitor(SelectedMonitor);
            OpenRegionPicker(SelectedImageId, SelectedImage.Name, screenshot,
                SelectedImage.Region.Type == RegionType.Custom ? SelectedImage.Region.CustomRegion : null);
        }
        catch (Exception ex)
        {
            PluginHost.ShowErrorToast("Capture Failed", $"Failed to capture screenshot: {ex.Message}");
        }
    }

    private void OnPickerArmed(RegionPickerContext context)
    {
        if (context.ModuleId != ModuleId) return;
        InvokeAsync(StateHasChanged);
    }

    private void OnPickerDisarmed()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnPickerTriggered(RegionPickerTriggerArgs args)
    {
        if (args.Context.ModuleId != ModuleId) return;

        InvokeAsync(() =>
        {
            ScreenRegion? initialRegion = null;
            var image = ConfigService.GetImage(args.Context.ModuleId, args.Context.TargetId);
            if (image?.Region.Type == RegionType.Custom)
            {
                initialRegion = image.Region.CustomRegion;
            }

            OpenRegionPicker(args.Context.TargetId, args.Context.TargetName, args.Screenshot, initialRegion);
            StateHasChanged();
        });
    }

    private void OpenRegionPicker(string targetId, string targetName, Emgu.CV.Mat screenshot, ScreenRegion? initialRegion)
    {
        _regionPickerScreenshot?.Dispose();
        _regionPickerScreenshot = screenshot;
        _regionPickerTargetId = targetId;
        _regionPickerTargetName = targetName;
        _regionPickerInitialRegion = initialRegion;
        _showRegionPicker = true;

        _regionPickerModal?.SetScreenshot(screenshot);
    }

    /// <summary>
    /// Opens the region picker in template-capture mode: the dragged rectangle
    /// is saved as a new pixel-exact template image instead of a region.
    /// </summary>
    private void CaptureTemplateFromScreen()
    {
        if (string.IsNullOrEmpty(ModuleId)) return;

        try
        {
            var screenshot = CaptureService.CaptureMonitor(SelectedMonitor);
            _regionPickerCaptureMode = true;
            OpenRegionPicker(string.Empty, "New template — drag around the target", screenshot, null);
        }
        catch (Exception ex)
        {
            PluginHost.ShowErrorToast("Capture Failed", $"Failed to capture screenshot: {ex.Message}");
        }
    }

    private void SaveCapturedTemplate(ScreenRegion region)
    {
        if (string.IsNullOrEmpty(ModuleId) || _regionPickerScreenshot == null) return;

        try
        {
            int x = Math.Max(0, Math.Min(region.X, _regionPickerScreenshot.Width - 1));
            int y = Math.Max(0, Math.Min(region.Y, _regionPickerScreenshot.Height - 1));
            int width = Math.Min(region.Width, _regionPickerScreenshot.Width - x);
            int height = Math.Min(region.Height, _regionPickerScreenshot.Height - y);

            if (width < 4 || height < 4)
            {
                PluginHost.ShowErrorToast("Capture Failed", "The selected area is too small for a template.");
                return;
            }

            using var view = new Emgu.CV.Mat(_regionPickerScreenshot, new System.Drawing.Rectangle(x, y, width, height));
            using var crop = view.Clone();
            using var buffer = new Emgu.CV.Util.VectorOfByte();
            Emgu.CV.CvInvoke.Imencode(".png", crop, buffer);

            var resolution = new Resolution(_regionPickerScreenshot.Width, _regionPickerScreenshot.Height);
            var image = ConfigService.AddImage(ModuleId, $"capture-{DateTime.Now:yyyyMMdd-HHmmss}.png", buffer.ToArray(), resolution);

            SelectedImageId = image.Id;
            LoadEditorData();
            PluginHost.ShowSuccessToast("Template Captured", $"Saved \"{image.Name}\" ({width}x{height})");
        }
        catch (Exception ex)
        {
            PluginHost.ShowErrorToast("Capture Failed", ex.Message);
        }
    }

    private async Task OnRegionPickerApply(ScreenRegion region)
    {
        _showRegionPicker = false;

        if (_regionPickerCaptureMode)
        {
            _regionPickerCaptureMode = false;
            SaveCapturedTemplate(region);
            CleanupRegionPicker();
            StateHasChanged();
            return;
        }

        if (!string.IsNullOrEmpty(ModuleId) && !string.IsNullOrEmpty(_regionPickerTargetId))
        {
            var image = ConfigService.GetImage(ModuleId, _regionPickerTargetId);
            if (image != null)
            {
                image.Region.Type = RegionType.Custom;
                image.Region.CustomRegion = region;
                if (_regionPickerScreenshot != null)
                {
                    image.Region.ReferenceResolution = new Resolution(
                        _regionPickerScreenshot.Width, _regionPickerScreenshot.Height);
                }
                if ((image.TargetType == DetectionTargetType.Meter || image.TargetType == DetectionTargetType.Ocr) && _regionPickerScreenshot != null)
                {
                    var previewPath = ConfigService.SaveRegionPreview(ModuleId, _regionPickerTargetId, _regionPickerScreenshot, region);

                    if (previewPath != null)
                    {
                        if (image.TargetType == DetectionTargetType.Meter)
                        {
                            image.Meter.RegionPreviewPath = previewPath;
                            using var subMat = new Emgu.CV.Mat(_regionPickerScreenshot,
                                new System.Drawing.Rectangle(
                                    Math.Max(0, region.X), Math.Max(0, region.Y),
                                    Math.Min(region.Width, _regionPickerScreenshot.Width - Math.Max(0, region.X)),
                                    Math.Min(region.Height, _regionPickerScreenshot.Height - Math.Max(0, region.Y))));
                            using var roiClone = subMat.Clone();

                            var autoHsv = ImageDetection.Algorithms.MeterFillAlgorithm.ComputeDominantHsvRange(roiClone);
                            if (autoHsv != null)
                            {
                                image.Meter.ColorHint = autoHsv;
                                image.Meter.UseColorHint = true;
                            }
                        }
                        else if (image.TargetType == DetectionTargetType.Ocr)
                        {
                            image.Ocr.RegionPreviewPath = previewPath;
                        }
                    }
                }

                ConfigService.UpdateImage(ModuleId, image);
                LoadEditorData();
            }
        }

        CleanupRegionPicker();
        StateHasChanged();
    }

    private Task OnRegionPickerCancel()
    {
        _showRegionPicker = false;
        CleanupRegionPicker();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CleanupRegionPicker()
    {
        _regionPickerScreenshot?.Dispose();
        _regionPickerScreenshot = null;
        _regionPickerTargetId = null;
        _regionPickerTargetName = null;
        _regionPickerInitialRegion = null;
        _regionPickerCaptureMode = false;
    }
}
