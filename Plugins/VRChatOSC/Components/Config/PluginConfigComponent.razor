@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@using VRChatOSC.Services
@implements IDisposable

<div class="space-y-4">
    <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full @(ConnectionManager.IsConnected ? "bg-green-500" : "bg-gray-400")"></div>
        <span class="text-sm font-medium">
            @(ConnectionManager.IsConnected ? "Connected" : (ConnectionManager.IsConnecting ? "Connecting..." : "Disconnected"))
        </span>
    </div>

    <Toggle Label="Enable plugin"
            Value="Enabled"
            ValueChanged="ToggleEnabled" />

    <Toggle Label="Auto-start connection on app startup"
            Value="AutoStart"
            ValueChanged="ToggleAutoStart" />

    <Toggle Label="Enable OSCQuery advertisement and discovery"
            Value="OscQueryEnabled"
            ValueChanged="ToggleOscQueryEnabled" />

    <Toggle Label="Prefer OSCQuery discovered VRChat endpoint"
            Value="PreferOscQueryDiscoveredEndpoint"
            ValueChanged="TogglePreferOscQueryEndpoint" />

    <TextInput Label="OSCQuery Client Name Filter"
               Placeholder="VRChat-Client"
               Value="@OscQueryClientName"
               ValueChanged="@(value => OscQueryClientName = value?.Trim() ?? string.Empty)" />

    <div class="w-56">
        <NumberInput Label="OSCQuery Refresh (ms)"
                     Value="@((double)OscQueryRefreshIntervalMs)"
                     Min="500"
                     Max="30000"
                     Step="100"
                     ValueChanged="@(value => OscQueryRefreshIntervalMs = (int)Math.Clamp(value ?? 2500, 500, 30000))" />
    </div>

    <TextInput Label="VRChat Remote Host"
               Placeholder="127.0.0.1"
               Value="@RemoteHost"
               ValueChanged="@(value => RemoteHost = value?.Trim() ?? string.Empty)" />

    <div class="w-56">
        <NumberInput Label="VRChat Receive Port (send target)"
                     Value="@((double)SendPort)"
                     Min="1"
                     Max="65535"
                     Step="1"
                     ValueChanged="@(value => SendPort = (int)Math.Clamp(value ?? 9000, 1, 65535))" />
    </div>

    <Toggle Label="Use any available local receive port"
            Value="UseAnyAvailablePort"
            ValueChanged="ToggleUseAnyAvailablePort" />

    <TextInput Label="Local Bind Host"
               Placeholder="127.0.0.1 or any"
               Value="@ReceiveBindHost"
               ValueChanged="@(value => ReceiveBindHost = value?.Trim() ?? string.Empty)" />

    @if (!UseAnyAvailablePort)
    {
        <div class="w-56">
            <NumberInput Label="Local Receive Port"
                         Value="@((double)ReceivePort)"
                         Min="1"
                         Max="65535"
                         Step="1"
                         ValueChanged="@(value => ReceivePort = (int)Math.Clamp(value ?? 9001, 1, 65535))" />
        </div>
    }

    <div class="w-56">
        <NumberInput Label="Reconnect Delay (ms)"
                     Value="@((double)ReconnectDelayMs)"
                     Min="250"
                     Max="30000"
                     Step="50"
                     ValueChanged="@(value => ReconnectDelayMs = (int)Math.Clamp(value ?? 2000, 250, 30000))" />
    </div>

    <div class="w-56">
        <NumberInput Label="Receive Buffer Size"
                     Value="@((double)ReceiveBufferSize)"
                     Min="256"
                     Max="65535"
                     Step="256"
                     ValueChanged="@(value => ReceiveBufferSize = (int)Math.Clamp(value ?? 8192, 256, 65535))" />
    </div>

    <div class="flex gap-2">
        <Button Text="Save" Variant="secondary" OnClick="SaveSettings" />
        @if (ConnectionManager.IsRunning)
        {
            <Button Text="Stop" Variant="danger" OnClick="Stop" />
        }
        else
        {
            <Button Text="Start" Variant="primary" Disabled="@(!Enabled)" OnClick="Start" />
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="text-xs @(StatusIsError ? "text-red-400" : "text-gray-400")">@StatusMessage</div>
    }

    <div class="text-xs text-gray-500">
        Default mode sends to <code>127.0.0.1:9000</code> and prefers local receive port <code>9001</code>; if occupied, it automatically picks an available port.
    </div>
</div>

@code {
    private static readonly string PluginIdValue = VRChatOSCPlugin.PluginId;

    private VRChatOscSettingsService SettingsService =>
        PluginServiceLocator.GetRequiredService<VRChatOscSettingsService>(PluginIdValue);

    private VRChatOscConnectionManager ConnectionManager =>
        PluginServiceLocator.GetRequiredService<VRChatOscConnectionManager>(PluginIdValue);

    private bool Enabled;
    private bool AutoStart;
    private bool UseAnyAvailablePort = true;
    private bool OscQueryEnabled = true;
    private bool PreferOscQueryDiscoveredEndpoint = true;
    private string OscQueryClientName = "VRChat-Client";
    private int OscQueryRefreshIntervalMs = 2500;
    private string RemoteHost = "127.0.0.1";
    private int SendPort = 9000;
    private string ReceiveBindHost = "127.0.0.1";
    private int ReceivePort = 9001;
    private int ReconnectDelayMs = 2000;
    private int ReceiveBufferSize = 8192;

    private string? StatusMessage;
    private bool StatusIsError;

    [Parameter]
    public string? PluginId { get; set; }

    protected override void OnInitialized()
    {
        ReadSettings();

        ConnectionManager.StatusMessage += OnStatus;
        ConnectionManager.ErrorOccurred += OnError;
        ConnectionManager.ConnectionStateChanged += OnConnectionChanged;
    }

    private void ReadSettings()
    {
        Enabled = SettingsService.Enabled;
        AutoStart = SettingsService.AutoStart;
        UseAnyAvailablePort = SettingsService.UseAnyAvailablePort;
        OscQueryEnabled = SettingsService.OscQueryEnabled;
        PreferOscQueryDiscoveredEndpoint = SettingsService.PreferOscQueryDiscoveredEndpoint;
        OscQueryClientName = SettingsService.OscQueryClientName;
        OscQueryRefreshIntervalMs = SettingsService.OscQueryRefreshIntervalMs;
        RemoteHost = SettingsService.RemoteHost;
        SendPort = SettingsService.SendPort;
        ReceiveBindHost = SettingsService.ReceiveBindHost;
        ReceivePort = SettingsService.ReceivePort;
        ReconnectDelayMs = SettingsService.ReconnectDelayMs;
        ReceiveBufferSize = SettingsService.ReceiveBufferSize;
    }

    private async Task SaveSettings()
    {
        SettingsService.Enabled = Enabled;
        SettingsService.AutoStart = AutoStart;
        SettingsService.UseAnyAvailablePort = UseAnyAvailablePort;
        SettingsService.OscQueryEnabled = OscQueryEnabled;
        SettingsService.PreferOscQueryDiscoveredEndpoint = PreferOscQueryDiscoveredEndpoint;
        SettingsService.OscQueryClientName = OscQueryClientName;
        SettingsService.OscQueryRefreshIntervalMs = OscQueryRefreshIntervalMs;
        SettingsService.RemoteHost = RemoteHost;
        SettingsService.SendPort = SendPort;
        SettingsService.ReceiveBindHost = ReceiveBindHost;
        SettingsService.ReceivePort = ReceivePort;
        SettingsService.ReconnectDelayMs = ReconnectDelayMs;
        SettingsService.ReceiveBufferSize = ReceiveBufferSize;

        if (!Enabled || !AutoStart)
        {
            await ConnectionManager.StopAsync();
        }
        else if (ConnectionManager.IsRunning)
        {
            await ConnectionManager.ReconnectAsync();
        }

        StatusIsError = false;
        StatusMessage = "Settings saved";
    }

    private async Task Start()
    {
        await SaveSettings();
        await ConnectionManager.StartAsync();
    }

    private async Task Stop()
    {
        await ConnectionManager.StopAsync();
    }

    private Task ToggleEnabled(bool enabled)
    {
        Enabled = enabled;
        SettingsService.Enabled = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleAutoStart(bool enabled)
    {
        AutoStart = enabled;
        SettingsService.AutoStart = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleUseAnyAvailablePort(bool enabled)
    {
        UseAnyAvailablePort = enabled;
        SettingsService.UseAnyAvailablePort = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleOscQueryEnabled(bool enabled)
    {
        OscQueryEnabled = enabled;
        SettingsService.OscQueryEnabled = enabled;
        return Task.CompletedTask;
    }

    private Task TogglePreferOscQueryEndpoint(bool enabled)
    {
        PreferOscQueryDiscoveredEndpoint = enabled;
        SettingsService.PreferOscQueryDiscoveredEndpoint = enabled;
        return Task.CompletedTask;
    }

    private void OnStatus(string message)
    {
        InvokeAsync(() =>
        {
            StatusIsError = false;
            StatusMessage = message;
            StateHasChanged();
        });
    }

    private void OnError(string message)
    {
        InvokeAsync(() =>
        {
            StatusIsError = true;
            StatusMessage = message;
            StateHasChanged();
        });
    }

    private void OnConnectionChanged(bool _)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ConnectionManager.StatusMessage -= OnStatus;
        ConnectionManager.ErrorOccurred -= OnError;
        ConnectionManager.ConnectionStateChanged -= OnConnectionChanged;
    }
}
