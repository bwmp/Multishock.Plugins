@page "/plugins/com-multishock-imagedetection/imagedetection"
@inject ImageDetectionService DetectionService
@inject ImageConfigService ConfigService
@inject NavigationManager NavManager
@implements IDisposable

<div class="max-w-5xl space-y-4">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3 min-w-0">
            @if (!string.IsNullOrEmpty(SelectedModule))
            {
                <button class="p-2 rounded-lg bg-app-surface-2 hover:bg-app-surface-3 transition-colors"
                        @onclick="GoBack"
                        title="Back to modules">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
            }

            <h1 class="text-2xl font-bold truncate">@GetPageTitle()</h1>
        </div>

        <div class="flex items-center gap-3">
            <Button Text="Recent Detections"
                    Variant="secondary"
                    OnClick="OpenRecentDetections" />

            <div class="flex items-center gap-2 px-3 py-1.5 rounded-full @(IsRunning ? "bg-app-success/20" : "bg-app-danger/20")">
                <span class="w-2 h-2 rounded-full @(IsRunning ? "bg-app-success animate-pulse" : "bg-app-danger")"></span>
                <span class="text-sm font-medium @(IsRunning ? "text-app-success" : "text-app-danger")">
                    @(IsRunning ? "Running" : "Stopped")
                </span>
            </div>

            <Button Text="@(IsRunning ? "Stop Detection" : "Start Detection")"
                    Variant="@(IsRunning ? "danger" : "primary")"
                    OnClick="ToggleDetection" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mb-4 p-3 rounded-lg bg-app-danger/10 border border-app-danger/30 text-app-danger flex items-center justify-between">
            <span>@ErrorMessage</span>
            <button @onclick="ClearErrorMessage" class="text-app-danger hover:text-app-danger" title="Dismiss error">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }
</div>

@if (string.IsNullOrEmpty(SelectedModule))
{
    <HomeDashboard OnModuleSelected="SelectModule" />
}
else
{
    <HomeModuleEditor ModuleId="@(SelectedModule!)" />
}

@code {
    private const string RecentDetectionsRoute = "/plugins/com-multishock-imagedetection/recent-detections";

    private bool IsRunning => DetectionService?.IsRunning ?? false;
    private string? ErrorMessage;
    private string? SelectedModule;

    protected override void OnInitialized()
    {
        DetectionService.RunningStateChanged += OnRunningStateChanged;
        DetectionService.ErrorOccurred += OnError;
        ConfigService.ConfigurationChanged += OnConfigChanged;
    }

    public void Dispose()
    {
        DetectionService.RunningStateChanged -= OnRunningStateChanged;
        DetectionService.ErrorOccurred -= OnError;
        ConfigService.ConfigurationChanged -= OnConfigChanged;
    }

    private string GetPageTitle()
    {
        if (string.IsNullOrEmpty(SelectedModule))
        {
            return "Image Detection";
        }

        if (ConfigService.Modules.TryGetValue(SelectedModule, out var module))
        {
            return module.Name;
        }

        return "Image Detection";
    }

    private Task ToggleDetection() => DetectionService.ToggleAsync();

    private void OpenRecentDetections()
    {
        NavManager.NavigateTo(RecentDetectionsRoute);
    }

    private void SelectModule(string moduleId)
    {
        SelectedModule = moduleId;
        StateHasChanged();
    }

    private void GoBack()
    {
        SelectedModule = null;
        StateHasChanged();
    }

    private void ClearErrorMessage()
    {
        ErrorMessage = null;
        StateHasChanged();
    }

    private void OnRunningStateChanged(bool _)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnError(string error)
    {
        ErrorMessage = error;
        InvokeAsync(StateHasChanged);
    }

    private void OnConfigChanged()
    {
        InvokeAsync(() =>
        {
            if (!string.IsNullOrEmpty(SelectedModule) && !ConfigService.Modules.ContainsKey(SelectedModule))
            {
                SelectedModule = null;
            }

            StateHasChanged();
        });
    }
}
