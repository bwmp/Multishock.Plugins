@page "/plugins/com-multishock-throneintegration/throneintegration"
@using ThroneIntegration.Nodes
@implements IDisposable

<PageHeader Title="Throne" Icon="gift"
            Description="Fire a flow trigger when someone buys a gift from your Throne wishlist, contributes to a crowdfund or sends a tip.">
    <Meta>
        <ConnectionChip Connected="IsConnected" Connecting="ThroneService.IsConnecting"
                        Reconnecting="ThroneService.IsReconnecting" />
    </Meta>
    <Actions>
        @if (IsConnected)
        {
            <Button Variant="secondary" Icon="unplug" Text="Disconnect" OnClick="Disconnect" />
        }
        else if (IsRunning)
        {
            <Button Variant="secondary" Icon="x" Text="Cancel" OnClick="Disconnect" />
        }
        else
        {
            <Button Variant="primary" Icon="plug" Text="Connect"
                    Disabled="@string.IsNullOrWhiteSpace(_creatorId)"
                    Title="@(string.IsNullOrWhiteSpace(_creatorId) ? "Enter your Throne username first" : null)"
                    OnClick="Connect" />
        }
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!string.IsNullOrEmpty(_error) && !IsRunning)
    {
        <Alert Variant="danger" Title="Couldn't connect to Throne">@_error</Alert>
    }

    <Card Title="Connection"
          Description="Throne gifts are public, so no sign-in is needed: MultiShock only needs your creator username. Changes save automatically.">
        <SettingRow Label="Throne username" Description="The username in your Throne link, as in throne.com/username.">
            <Help>
                @if (IsRunning)
                {
                    <span>@(IsConnected || string.IsNullOrEmpty(_status) ? "Disconnect to change it." : _status)</span>
                }
                else if (string.IsNullOrWhiteSpace(_creatorId))
                {
                    <span class="inline-flex items-center gap-1.5">
                        <LucideIcon Name="info" Size="12" Class="shrink-0" />
                        Enter your username to connect.
                    </span>
                }
            </Help>
            <ChildContent>
                <TextInput Placeholder="username" Value="@_creatorId" ValueChanged="OnCreatorIdChanged"
                           Disabled="IsRunning" aria-label="Throne username" />
            </ChildContent>
        </SettingRow>
    </Card>

    <Card Title="Flow trigger"
          Description="Throne has no built-in reactions. Add this trigger to a flow and connect it to the shocker actions you want.">
        <SettingRow Label="Throne gift received" Description="@GiftTrigger.Description">
            <NavButton Href="/flows" Text="Open flows" />
        </SettingRow>
    </Card>

    <Card Title="Recent gifts" Description="The last 50 gifts, newest first. Kept between sessions." NoPadding="true">
        <Actions>
            @if (_recentEvents.Count > 0)
            {
                <Button Variant="ghost" Size="sm" Icon="trash-2" Text="Clear" OnClick="ClearRecent" />
            }
        </Actions>
        <ChildContent>
            @if (_recentEvents.Count == 0)
            {
                <div class="px-4 py-6">
                    <p class="text-sm text-app-muted">No gifts yet.</p>
                    <p class="mt-0.5 text-xs text-app-subtle">
                        @(IsConnected
                            ? "Gifts, crowdfund contributions and tips appear here as they arrive."
                            : "Gifts, crowdfund contributions and tips appear here once you connect.")
                    </p>
                </div>
            }
            else
            {
                <ol class="max-h-96 divide-y divide-app-border overflow-y-auto">
                    @foreach (var evt in _recentEvents)
                    {
                        var info = evt.OverlayInformation;
                        <li class="flex items-start justify-between gap-4 px-4 py-2.5 text-sm">
                            <div class="min-w-0">
                                <div class="font-medium text-app-text">@(info?.GifterUsername ?? "Anonymous")</div>
                                <div class="text-xs text-app-muted">
                                    @(info?.Type ?? "Unknown")
                                    @if (!string.IsNullOrEmpty(info?.ItemName))
                                    {
                                        <span> · @info.ItemName</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(info?.Message))
                                {
                                    <p class="mt-1 break-words text-app-muted">“@info.Message”</p>
                                }
                            </div>
                            <time class="shrink-0 text-xs text-app-subtle"
                                  datetime="@DateTimeOffset.FromUnixTimeMilliseconds(evt.CreatedAt).ToString("o")">
                                @FormatTimestamp(evt.CreatedAt)
                            </time>
                        </li>
                    }
                </ol>
            }
        </ChildContent>
    </Card>
</div>

@code {
    private static readonly ThroneGiftTriggerNode GiftTrigger = new();

    private string pluginId = ThroneIntegration.ThroneIntegrationPlugin.PluginId;
    private ThroneService ThroneService => PluginServiceLocator.GetRequiredService<ThroneService>(pluginId);
    private ThroneSettingsService SettingsService =>
        PluginServiceLocator.GetRequiredService<ThroneSettingsService>(pluginId);

    private string _creatorId = string.Empty;
    private bool IsConnected => ThroneService.IsConnected;
    private bool IsRunning => IsConnected || ThroneService.IsConnecting || ThroneService.IsReconnecting;
    private bool _userStopped;
    private string? _status;
    private string? _error;
    private List<ThroneEvent> _recentEvents = new();

    protected override void OnInitialized()
    {
        _creatorId = SettingsService.CreatorId;
        _recentEvents = SettingsService.GetRecentEvents().ToList();

        ThroneService.OnGiftReceived += OnGiftReceived;
        ThroneService.ConnectionStateChanged += OnConnectionStateChanged;
        ThroneService.StatusMessage += OnStatusMessage;
        ThroneService.ErrorOccurred += OnError;
    }

    private void OnCreatorIdChanged(string? value)
    {
        _creatorId = value ?? string.Empty;
        SettingsService.CreatorId = _creatorId;
    }

    private async Task Connect()
    {
        if (string.IsNullOrWhiteSpace(_creatorId))
        {
            return;
        }

        _error = null;
        _userStopped = false;
        try
        {
            SettingsService.Enabled = true;
            await ThroneService.StartAsync(_creatorId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Disconnect()
    {
        _userStopped = true;
        ThroneService.Stop();
        SettingsService.Enabled = false;
    }

    private void ClearRecent()
    {
        SettingsService.ClearRecentEvents();
        _recentEvents.Clear();
    }

    private void OnConnectionStateChanged(bool connected) => InvokeAsync(StateHasChanged);

    private void OnStatusMessage(string message) => InvokeAsync(() =>
    {
        _status = message;
        StateHasChanged();
    });

    // Stopping mid-start cancels the creator lookup, which the service reports as an error.
    private void OnError(string error) => InvokeAsync(() =>
    {
        if (_userStopped)
        {
            return;
        }
        _error = error;
        StateHasChanged();
    });

    private void OnGiftReceived(ThroneEvent evt)
    {
        SettingsService.AddRecentEvent(evt);
        InvokeAsync(() =>
        {
            _recentEvents = SettingsService.GetRecentEvents().ToList();
            StateHasChanged();
        });
    }

    private static string FormatTimestamp(long timestamp)
    {
        var dateTime = DateTimeOffset.FromUnixTimeMilliseconds(timestamp).ToLocalTime();
        var diff = DateTimeOffset.Now - dateTime;

        if (diff.TotalMinutes < 1)
            return "Just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours} h ago";

        return dateTime.ToString("MMM d, HH:mm");
    }

    public void Dispose()
    {
        ThroneService.OnGiftReceived -= OnGiftReceived;
        ThroneService.ConnectionStateChanged -= OnConnectionStateChanged;
        ThroneService.StatusMessage -= OnStatusMessage;
        ThroneService.ErrorOccurred -= OnError;
    }
}
