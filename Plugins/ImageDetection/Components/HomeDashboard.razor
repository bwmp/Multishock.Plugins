@using ImageDetection.Models
@using ImageDetection.Services
@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@inject ImageDetectionService DetectionService
@inject ImageConfigService ConfigService
@inject IScreenCaptureService CaptureService
@inject IPluginHost PluginHost
@implements IDisposable

<div class="max-w-4xl space-y-5">
    @if (!string.IsNullOrEmpty(CaptureService.DpiWarning))
    {
        <Alert Variant="warning" Title="Display scaling may shift detection regions">
            @CaptureService.DpiWarning
        </Alert>
    }

    <Card Title="Capture" Description="Which screen is scanned and how often. Changes save automatically.">
        <Actions>
            <span class="text-xs text-app-muted tabular-nums">
                <span class="text-app-text">@DetectionService.Stats.SuccessfulDetections</span> @(DetectionService.Stats.SuccessfulDetections == 1 ? "match" : "matches") of
                <span class="text-app-text">@DetectionService.Stats.TotalDetections</span> @(DetectionService.Stats.TotalDetections == 1 ? "check" : "checks")
            </span>
        </Actions>
        <ChildContent>
            @if (CaptureService is IScreenCaptureAccess { UsesSystemScreenPicker: true } screenAccess)
            {
                <SettingRow Label="Screen" Description="Your desktop's screen-sharing dialog decides which screen is captured when detection starts.">
                    <Button Text="Choose screen" Icon="monitor" Variant="secondary" OnClick="() => ChooseScreen(screenAccess)" />
                </SettingRow>
            }
            else
            {
                <SettingRow Label="Monitor" Description="@MonitorDescription">
                    <Select TValue="int"
                            Label="Monitor"
                            Class="[&_label]:sr-only"
                            Value="EffectiveMonitorIndex"
                            ValueChanged="OnMonitorChanged"
                            Options="MonitorOptions"
                            Disabled="@(Monitors.Count == 0)"
                            Placeholder="@(Monitors.Count == 0 ? "No monitors detected" : "Choose a connected monitor")"
                            Error="@(Monitors.Count == 0 ? "No monitors detected" : null)" />
                </SettingRow>
            }

            <SettingRow Label="Capture delay" Description="Wait between screen captures. Lower reacts faster but uses more CPU.">
                <NumberInput Label="Capture delay"
                             Class="w-full sm:w-36 [&_label]:sr-only"
                             Value="CaptureDelayMs"
                             Error="@CaptureDelayError"
                             ValueChanged="OnCaptureDelayChanged"
                             Min="MinCaptureDelayMs" Max="MaxCaptureDelayMs" Step="10" Suffix="ms" />
            </SettingRow>

            @if (OperatingSystem.IsWindows())
            {
                <SettingRow Label="Capture backend" Description="@BackendDescription">
                    <Select TValue="CaptureBackendType"
                            Label="Capture backend"
                            Class="[&_label]:sr-only"
                            Value="SelectedBackend"
                            ValueChanged="OnBackendChanged"
                            Options="BackendOptions" />
                </SettingRow>
            }
        </ChildContent>
    </Card>

    <Card Title="Modules" Description="Each module groups the targets for one game. Turn a module off to skip all of its targets." NoPadding="true">
        <Actions>
            <Button Text="Import" Icon="file-down" Variant="secondary" Size="sm" OnClick="ImportModule" />
            @if (Modules.Count > 0)
            {
                <Button Text="New module" Icon="plus" Variant="secondary" Size="sm" OnClick="CreateModule" />
            }
        </Actions>
        <ChildContent>
            @if (Modules.Count == 0)
            {
                <EmptyState Icon="scan-eye"
                            Title="No modules yet"
                            Description="Create a module for a game, then add the images, health bars or on-screen text it should react to.">
                    <Actions>
                        <Button Text="New module" Icon="plus" Variant="primary" OnClick="CreateModule" />
                    </Actions>
                </EmptyState>
            }
            else
            {
                <ul class="divide-y divide-app-border">
                    @foreach (var module in Modules.Values)
                    {
                        <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
                            <Toggle Value="@module.Enabled"
                                    AriaLabel="@($"Enable {module.Name}")"
                                    ValueChanged="@(value => ToggleModule(module.Id, value))" />
                            <div class="min-w-0 flex-1 basis-48">
                                <span class="block truncate text-sm font-medium text-app-text">@module.Name</span>
                                <span class="block truncate text-xs text-app-muted">
                                    @(module.Enabled ? "" : "Off ·") @DescribeTargets(module)@(string.IsNullOrWhiteSpace(module.Description) ? "" : $" · {module.Description}")
                                </span>
                            </div>
                            <div class="flex shrink-0 items-center gap-1">
                                <Button Text="Configure" Icon="sliders-horizontal" Variant="secondary" Size="sm"
                                        AriaLabel="@($"Configure {module.Name}")"
                                        OnClick="@(() => SelectModule(module.Id))" />
                                <Button Icon="download" Variant="ghost" Size="icon-sm"
                                        AriaLabel="@($"Export {module.Name}")" Title="Export to Downloads"
                                        OnClick="@(() => ExportModule(module.Id))" />
                                <Button Icon="trash-2" Variant="ghost" Size="icon-sm"
                                        AriaLabel="@($"Delete {module.Name}")" Title="Delete module"
                                        OnClick="@(() => ConfirmDeleteModule(module.Id))" />
                            </div>
                        </li>
                    }
                </ul>
            }
        </ChildContent>
    </Card>
</div>

<Modal IsOpen="ShowNewModuleDialog" Title="New module" Size="sm" OnClose="CloseNewModuleDialog">
    <ChildContent>
        <form class="space-y-4" @onsubmit="ConfirmCreateModule">
            <TextInput Label="Name"
                       Placeholder="e.g. Valorant"
                       Value="@NewModuleName"
                       ValueChanged="@(value => NewModuleName = value ?? string.Empty)"
                       autofocus />
            <TextArea Label="Description (optional)"
                      Placeholder="What does this module detect?"
                      Rows="2"
                      Resizable="false"
                      @bind-Value="NewModuleDescription" />
        </form>
    </ChildContent>
    <Footer>
        <Button Text="Cancel" Variant="ghost" OnClick="CloseNewModuleDialog" />
        <Button Text="Create module" Variant="primary"
                Disabled="@string.IsNullOrWhiteSpace(NewModuleName)"
                OnClick="ConfirmCreateModule" />
    </Footer>
</Modal>

<ConfirmDialog IsOpen="ShowDeleteConfirmDialog"
               Title="Delete module"
               Message="@DeleteConfirmMessage"
               ConfirmText="Delete module"
               OnCancel="CancelDelete"
               OnConfirm="ExecuteDelete" />

@code {
    [Parameter, EditorRequired] public EventCallback<string> OnModuleSelected { get; set; }

    private static readonly IEnumerable<Select<CaptureBackendType>.SelectOption<CaptureBackendType>> BackendOptions =
    [
        new(CaptureBackendType.Auto, "Auto (recommended)"),
        new(CaptureBackendType.WindowsGraphicsCapture, "Windows Graphics Capture"),
        new(CaptureBackendType.LegacyGdi, "Legacy GDI"),
    ];

    private const int MinCaptureDelayMs = 10;
    private const int MaxCaptureDelayMs = 5000;

    private List<MonitorInfo> Monitors = [];
    private int SelectedMonitor = 1;
    private double? CaptureDelayMs = 100;
    private string? CaptureDelayError;
    private CaptureBackendType SelectedBackend = CaptureBackendType.Auto;
    private Dictionary<string, DetectionModule> Modules = [];

    private bool ShowNewModuleDialog;
    private string NewModuleName = string.Empty;
    private string? NewModuleDescription;

    private bool ShowDeleteConfirmDialog;
    private string DeleteConfirmMessage = string.Empty;
    private string? PendingDeleteModuleId;

    private string BackendDescription => "Windows Graphics Capture supports fullscreen games. Legacy GDI may capture black frames."
        + (MonitorMissing && SelectedBackend == CaptureBackendType.Auto
            ? $" If Auto falls back to GDI, it uses {MonitorLabel(Monitors[0])}." : "");

    private bool MonitorMissing => Monitors.Count > 0 && Monitors.All(m => m.Index != SelectedMonitor);
    private MonitorInfo? FallbackMonitor => Monitors.Count == 0 ? null :
        Monitors[!OperatingSystem.IsWindows() || SelectedBackend == CaptureBackendType.LegacyGdi
            ? 0 : Math.Clamp(SelectedMonitor - 1, 0, Monitors.Count - 1)];
    private int EffectiveMonitorIndex => MonitorMissing ? FallbackMonitor!.Index : SelectedMonitor;
    private IEnumerable<Select<int>.SelectOption<int>> MonitorOptions =>
        Monitors.Select(m => new Select<int>.SelectOption<int>(
            m.Index, (MonitorMissing && m.Index == EffectiveMonitorIndex ? "Fallback: " : "") + MonitorLabel(m)));

    private static string MonitorLabel(MonitorInfo monitor) =>
        $"Monitor {monitor.Index} \u00b7 {monitor.Resolution.Width}\u00d7{monitor.Resolution.Height}";

    private string MonitorDescription => MonitorMissing
        ? $"Saved monitor {SelectedMonitor} isn't connected; using {MonitorLabel(FallbackMonitor!)}."
        : "The screen scanned for targets.";

    protected override void OnInitialized()
    {
        LoadData();
        ConfigService.ConfigurationChanged += OnConfigChanged;
    }

    public void Dispose()
    {
        ConfigService.ConfigurationChanged -= OnConfigChanged;
    }

    private void LoadData()
    {
        Monitors = CaptureService.GetMonitors();
        SelectedMonitor = ConfigService.CaptureConfig.MonitorIndex;
        if (CaptureDelayError == null)
            CaptureDelayMs = ConfigService.CaptureConfig.CaptureDelayMs;
        SelectedBackend = ConfigService.CaptureConfig.Backend;
        Modules = new Dictionary<string, DetectionModule>(ConfigService.Modules);
    }

    private void OnConfigChanged()
    {
        InvokeAsync(() =>
        {
            LoadData();
            StateHasChanged();
        });
    }

    private static string DescribeTargets(DetectionModule module)
    {
        var meterCount = module.Images.Values.Count(i => i.TargetType == DetectionTargetType.Meter);
        var ocrCount = module.Images.Values.Count(i => i.TargetType == DetectionTargetType.Ocr);
        var imageCount = module.Images.Count - meterCount - ocrCount;

        var parts = new List<string>();
        if (imageCount > 0) parts.Add(Plural(imageCount, "image", "images"));
        if (meterCount > 0) parts.Add(Plural(meterCount, "health bar", "health bars"));
        if (ocrCount > 0) parts.Add(Plural(ocrCount, "text reader", "text readers"));

        return parts.Count == 0 ? "No targets" : string.Join(", ", parts);
    }

    private static string Plural(int count, string singular, string plural)
        => $"{count} {(count == 1 ? singular : plural)}";

    private Task SelectModule(string moduleId)
        => OnModuleSelected.InvokeAsync(moduleId);

    private void OnMonitorChanged(int index)
    {
        SelectedMonitor = index;
        var config = ConfigService.CaptureConfig;
        config.MonitorIndex = index;
        ConfigService.CaptureConfig = config;
    }

    private void ChooseScreen(IScreenCaptureAccess screenAccess)
    {
        screenAccess.ResetScreenChoice();
        PluginHost.ShowInfoToast("Choose screen", "Your desktop will ask which screen to share the next time detection captures.");
    }

    private void OnBackendChanged(CaptureBackendType backend)
    {
        SelectedBackend = backend;
        var config = ConfigService.CaptureConfig;
        config.Backend = backend;
        ConfigService.CaptureConfig = config;
    }

    private void OnCaptureDelayChanged(double? value)
    {
        CaptureDelayMs = value;
        CaptureDelayError = value is { } delay && delay >= MinCaptureDelayMs && delay <= MaxCaptureDelayMs && delay == Math.Floor(delay)
            ? null
            : $"Enter a whole number from {MinCaptureDelayMs} to {MaxCaptureDelayMs} ms.";
        if (CaptureDelayError != null) return;

        var config = ConfigService.CaptureConfig;
        config.CaptureDelayMs = (int)value!.Value;
        ConfigService.CaptureConfig = config;
    }

    private void CreateModule()
    {
        NewModuleName = string.Empty;
        NewModuleDescription = string.Empty;
        ShowNewModuleDialog = true;
    }

    private void CloseNewModuleDialog()
    {
        ShowNewModuleDialog = false;
    }

    private void ConfirmCreateModule()
    {
        if (string.IsNullOrWhiteSpace(NewModuleName)) return;

        ConfigService.CreateModule(NewModuleName, NewModuleDescription ?? string.Empty);
        ShowNewModuleDialog = false;
        LoadData();
    }

    private async Task ImportModule()
    {
        var path = await PluginHost.PickFileAsync("Import module or legacy config", [".msmodule", ".zip", ".json"]);
        if (string.IsNullOrEmpty(path)) return;

        var module = ConfigService.ImportModule(path);
        if (module != null)
        {
            PluginHost.ShowSuccessToast("Module imported", $"Imported \"{module.Name}\" with {Plural(module.Images.Count, "target", "targets")}");
            LoadData();
        }
        else
        {
            PluginHost.ShowErrorToast("Import failed", "Could not import the selected module. Choose a .msmodule/.zip file, module.json, or a legacy config.json.");
        }
    }

    private void ToggleModule(string moduleId, bool enabled)
    {
        ConfigService.SetModuleEnabled(moduleId, enabled);
        LoadData();
    }

    private void ExportModule(string moduleId)
    {
        var downloadsPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads");
        Directory.CreateDirectory(downloadsPath);

        var result = ConfigService.ExportModule(moduleId, downloadsPath);
        if (result != null)
        {
            PluginHost.ShowSuccessToast("Module exported", $"Saved to {Path.GetFileName(result)} in Downloads");
        }
        else
        {
            PluginHost.ShowErrorToast("Export failed", "Could not export module");
        }
    }

    private void ConfirmDeleteModule(string moduleId)
    {
        var module = Modules.GetValueOrDefault(moduleId);
        DeleteConfirmMessage = $"Delete \"{module?.Name ?? moduleId}\" and all of its targets? This can't be undone.";
        PendingDeleteModuleId = moduleId;
        ShowDeleteConfirmDialog = true;
    }

    private void CancelDelete()
    {
        ShowDeleteConfirmDialog = false;
        PendingDeleteModuleId = null;
    }

    private void ExecuteDelete()
    {
        ShowDeleteConfirmDialog = false;
        if (PendingDeleteModuleId != null)
        {
            ConfigService.DeleteModule(PendingDeleteModuleId);
            PendingDeleteModuleId = null;
            LoadData();
        }
    }
}
