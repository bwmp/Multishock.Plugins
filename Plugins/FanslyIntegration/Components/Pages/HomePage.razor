@page "/plugins/com-multishock-fanslyintegration/fanslyintegration"
@implements IDisposable

<PageHeader Title="Fansly" Icon="heart"
            Description="Run shocker reactions from Fansly tips, follows and subscriptions while you stream.">
    <Meta>
        <ConnectionChip Connected="Connection.IsConnected" Connecting="Connection.IsConnecting" />
    </Meta>
    <Actions>
        @if (Connection.IsConnected)
        {
            <Button Variant="secondary" Icon="unplug" Text="Disconnect" OnClick="Disconnect" />
        }
        else
        {
            <Button Variant="primary" Icon="plug" Text="Connect" Loading="Connection.IsConnecting"
                    Disabled="@(!Settings.HasCredentials)"
                    Title="@(Settings.HasCredentials ? null : "Enter your account token and username first")"
                    OnClick="Connect" />
        }
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!string.IsNullOrEmpty(_error) && !Connection.IsConnected && !Connection.IsConnecting)
    {
        <Alert Variant="danger" Title="Couldn't connect to Fansly">@_error</Alert>
    }

    <Card Title="Connection"
          Description="Fansly has no bot API, so MultiShock connects with your own account token. Start your stream before connecting: the chat room only exists while you're live. Changes save automatically.">
        <SettingRow Label="Account token" Description="Gives access to your Fansly account. Keep it private.">
            <Help>
                Sign in at fansly.com, press <span class="kbd">F12</span>, open Network and refresh. Select any
                apiv3.fansly.com request and copy its <span class="font-mono">authorization</span> request header.
            </Help>
            <ChildContent>
                <TextInput InputType="password" Placeholder="Paste your token" Value="@_authToken"
                           ValueChanged="UpdateAuthToken" aria-label="Fansly account token" />
            </ChildContent>
        </SettingRow>
        <SettingRow Label="Username" Description="Your Fansly username, used to find your live chat room.">
            <TextInput Placeholder="username" Value="@_username" ValueChanged="UpdateUsername"
                       aria-label="Fansly username" />
        </SettingRow>
        <SettingRow Label="Connect on startup" Description="Connect when MultiShock starts, once a token and username are saved.">
            <Toggle AriaLabel="Connect on startup" Value="Settings.AutoConnect" ValueChanged="@(v => Settings.AutoConnect = v)" />
        </SettingRow>
        <SettingRow Label="Reconnect automatically" Description="Reconnect if the connection drops during a stream.">
            <Toggle AriaLabel="Reconnect automatically" Value="Settings.AutoReconnect" ValueChanged="@(v => Settings.AutoReconnect = v)" />
        </SettingRow>
        @if (!Settings.HasCredentials)
        {
            <p class="mt-3 flex items-center gap-1.5 text-xs text-app-muted">
                <LucideIcon Name="info" Size="12" Class="shrink-0" />
                <span>Enter your account token and username to connect.</span>
            </p>
        }
    </Card>

    <Card Title="Reactions"
          Description="Run shocker actions straight from Fansly events. For custom logic, use the Fansly triggers in a flow instead.">
        <SettingRow Label="Tip reactions" Description="Set intensity and duration by tip amount.">
            <Meta><SummaryChip Summary="TipSummary" /></Meta>
            <ChildContent>
                <NavButton Href="/plugins/com-multishock-fanslyintegration/tip-reactions" AriaLabel="Configure tip reactions" />
            </ChildContent>
        </SettingRow>
        <SettingRow Label="Follows and subscriptions" Description="React when someone follows or subscribes.">
            <Meta><SummaryChip Summary="EventsSummary" /></Meta>
            <ChildContent>
                <NavButton Href="/plugins/com-multishock-fanslyintegration/events-config" AriaLabel="Configure follow and subscription reactions" />
            </ChildContent>
        </SettingRow>
    </Card>

    <Card Title="Event log" Description="Events from this session, newest first." NoPadding="true">
        <Actions>
            @if (Log.Count > 0)
            {
                <Button Variant="ghost" Size="sm" Icon="trash-2" Text="Clear" OnClick="@(() => Log.Clear())" />
            }
        </Actions>
        <ChildContent>
            @if (Log.Count == 0)
            {
                <div class="px-4 py-6">
                    <p class="text-sm text-app-muted">No events yet.</p>
                    <p class="mt-0.5 text-xs text-app-subtle">
                        @(Connection.IsConnected
                            ? "Tips, follows and subscriptions appear here as they happen."
                            : "Tips, follows, subscriptions and connection messages appear here once you connect.")
                    </p>
                </div>
            }
            else
            {
                <ol class="max-h-80 divide-y divide-app-border overflow-y-auto">
                    @foreach (var entry in Log.Entries.Reverse())
                    {
                        <li class="flex items-start gap-3 px-4 py-2 text-sm">
                            <span class="shrink-0 pt-px font-mono text-xs text-app-subtle">@entry.Time.ToString("HH:mm:ss")</span>
                            @if (entry.IsError)
                            {
                                <span class="flex min-w-0 items-start gap-1.5 text-app-danger">
                                    <LucideIcon Name="alert-circle" Size="14" Class="mt-0.5 shrink-0" />
                                    <span class="break-words">@entry.Message</span>
                                </span>
                            }
                            else
                            {
                                <span class="min-w-0 break-words text-app-text">@entry.Message</span>
                            }
                        </li>
                    }
                </ol>
            }
        </ChildContent>
    </Card>
</div>

@code {
    private static readonly string PluginId = FanslyIntegrationPlugin.PluginId;
    private FanslySettingsService Settings => PluginServiceLocator.GetRequiredService<FanslySettingsService>(PluginId);
    private FanslyConnectionService Connection => PluginServiceLocator.GetRequiredService<FanslyConnectionService>(PluginId);
    private EventLogService Log => PluginServiceLocator.GetRequiredService<EventLogService>(PluginId);
    private TipReactionsConfigService Tips => PluginServiceLocator.GetRequiredService<TipReactionsConfigService>(PluginId);
    private EventsConfigService Events => PluginServiceLocator.GetRequiredService<EventsConfigService>(PluginId);

    private string _authToken = "";
    private string _username = "";
    private string? _error;

    private ReactionSummary TipSummary => ActionOptions.SummarizeBrackets(
        Tips.Config.Enabled, Tips.Config.Brackets.Count, Tips.Config.SelectedShockerIds.Count);

    private ReactionSummary EventsSummary =>
        ActionOptions.SummarizeEvents([Events.Config.Follow, Events.Config.Subscribe]);

    protected override void OnInitialized()
    {
        _authToken = Settings.AuthToken;
        _username = Settings.Username;
        Connection.ConnectionStateChanged += OnStateChanged;
        Connection.ErrorOccurred += OnError;
        Log.LogChanged += OnLogChanged;
    }

    private void UpdateAuthToken(string? value)
    {
        _authToken = value ?? "";
        Settings.AuthToken = _authToken;
    }

    private void UpdateUsername(string? value)
    {
        _username = value ?? "";
        Settings.Username = _username;
    }

    private void OnStateChanged(bool _) => InvokeAsync(StateHasChanged);
    private void OnLogChanged() => InvokeAsync(StateHasChanged);

    private void OnError(string error) => InvokeAsync(() =>
    {
        _error = error;
        StateHasChanged();
    });

    private async Task Connect()
    {
        _error = null;
        await Connection.ConnectAsync();
    }

    private async Task Disconnect() => await Connection.DisconnectAsync();

    public void Dispose()
    {
        Connection.ConnectionStateChanged -= OnStateChanged;
        Connection.ErrorOccurred -= OnError;
        Log.LogChanged -= OnLogChanged;
    }
}
