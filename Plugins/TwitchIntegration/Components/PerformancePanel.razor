@using System.Diagnostics
@using System.Globalization
@implements IAsyncDisposable

<details class="border-t border-app-border pt-4">
    <summary class="text-sm cursor-pointer text-app-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary">Performance profiler</summary>
    <div class="mt-3 space-y-3">
        <Toggle Label="Capture timings" Value="@Profiler.Enabled" ValueChanged="ToggleCapture" />
        <p class="text-sm text-app-muted">
            Enable capture while reproducing the lag. Timings are elapsed time, including waits;
            handler timings cover synchronous work and trigger dispatch timings cover filtering and callbacks,
            not downstream flow execution. UI queue delay measures how long this page waits to update.
            Slow counts include samples of 50 ms or more.
        </p>
        @if (_snapshot.Count == 0)
        {
            <p class="text-sm text-app-muted">No timings captured yet.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <caption class="sr-only">Twitch performance timings</caption>
                    <thead class="text-app-muted">
                        <tr>
                            <th scope="col" class="py-2 pr-4">Operation</th>
                            <th scope="col" class="pr-4">Samples</th>
                            <th scope="col" class="pr-4">Active</th>
                            <th scope="col" class="pr-4 whitespace-nowrap">Average ms</th>
                            <th scope="col" class="pr-4 whitespace-nowrap">Max ms</th>
                            <th scope="col">Slow</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _snapshot)
                        {
                            <tr @key="row.Operation" class="border-t border-app-border">
                                <th scope="row" class="py-2 pr-4 font-normal">@row.Operation</th>
                                <td class="pr-4">@row.Count</td>
                                <td class="pr-4">@row.Active</td>
                                <td class="pr-4">@row.AverageMilliseconds.ToString("F2")</td>
                                <td class="pr-4">@row.MaxMilliseconds.ToString("F2")</td>
                                <td>@row.SlowCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="flex flex-wrap gap-2">
            <Button Text="Reset timings" Variant="secondary" Size="sm" OnClick="Reset" />
            <Button Text="Prepare report" Variant="secondary" Size="sm" OnClick="PrepareReport" />
        </div>
        @if (_report != null)
        {
            <label class="block text-sm text-app-muted" for="twitch-performance-report">Copyable performance report</label>
            <textarea id="twitch-performance-report" readonly rows="8"
                      class="w-full p-3 text-xs font-mono bg-app-surface border border-app-border rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary">@_report</textarea>
        }
    </div>
</details>

@code {
    private TwitchPerformanceProfiler Profiler => PluginServiceLocator.GetRequiredService<TwitchPerformanceProfiler>(TwitchIntegrationPlugin.PluginId);
    private readonly CancellationTokenSource _refreshCts = new();
    private IReadOnlyList<PerformanceMeasurement> _snapshot = [];
    private Task? _refreshTask;
    private string? _report;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _snapshot = Profiler.Snapshot();
        _refreshTask = Task.Run(RefreshAsync);
    }

    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                if (!Profiler.Enabled) continue;
                var started = Stopwatch.GetTimestamp();
                await InvokeAsync(() =>
                {
                    if (_disposed) return;
                    Profiler.Record("UI queue delay", Stopwatch.GetElapsedTime(started));
                    _snapshot = Profiler.Snapshot();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_refreshCts.IsCancellationRequested) { }
    }

    private void ToggleCapture(bool enabled)
    {
        Profiler.Enabled = enabled;
        _snapshot = Profiler.Snapshot();
    }

    private void Reset()
    {
        Profiler.Reset();
        _snapshot = [];
        _report = null;
    }

    private void PrepareReport()
    {
        _snapshot = Profiler.Snapshot();
        _report = $"Twitch Integration {BuildStamp.Version}\nCaptured at {DateTime.UtcNow:O}\n" +
            "Elapsed timings include waits. Handler = synchronous work; trigger dispatch excludes downstream flow execution.\n" +
            "Operation\tSamples\tActive\tAverage ms\tMax ms\tSlow (>=50 ms)\n" +
            string.Join("\n", _snapshot.Select(row => string.Create(CultureInfo.InvariantCulture,
                $"{row.Operation}\t{row.Count}\t{row.Active}\t{row.AverageMilliseconds:F2}\t{row.MaxMilliseconds:F2}\t{row.SlowCount}")));
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _refreshCts.CancelAsync();
        if (_refreshTask != null) await _refreshTask;
        _refreshCts.Dispose();
    }
}
