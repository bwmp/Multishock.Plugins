@page "/plugins/com-multishock-throneintegration/throneintegration"
@using ThroneIntegration.Nodes
@inject IJSRuntime JS
@implements IDisposable

<PageHeader Title="Throne" Icon="gift"
            Description="Fire a flow trigger when someone buys a gift from your Throne wishlist or contributes to a crowdfund.">
    <Meta>
        <ConnectionChip State="State" />
    </Meta>
    <Actions>
        @if (ThroneService.IsRunning)
        {
            <Button Variant="secondary" Icon="unplug" Text="Disconnect" Loading="_busy" OnClick="Disconnect" />
        }
        else if (State == ThroneConnectionState.Stopped)
        {
            <Button Variant="primary" Icon="plug" Text="Connect" Loading="_busy" OnClick="Connect" />
        }
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!string.IsNullOrEmpty(_error))
    {
        <Alert Variant="danger" Title="Something went wrong">@_error</Alert>
    }

    @if (SettingsService.SecretsWarning is { } secretsWarning)
    {
        <Alert Variant="warning" Title="Secure storage">@secretsWarning</Alert>
    }

    @switch (State)
    {
        case ThroneConnectionState.Revoked:
            <Alert Variant="danger" Title="Connection no longer valid">
                <Actions>
                    <Button Variant="secondary" Size="sm" Text="Remove connection" OnClick="() => _confirmRemove = true" />
                </Actions>
                <ChildContent>@ThroneService.Problem</ChildContent>
            </Alert>
            break;
        case ThroneConnectionState.MissedEvents:
            <Alert Variant="warning" Title="Some gifts were missed">
                <Actions>
                    <Button Variant="secondary" Size="sm" Text="Skip and resume" Loading="_busy" OnClick="SkipMissed" />
                </Actions>
                <ChildContent>@ThroneService.Problem</ChildContent>
            </Alert>
            break;
        case ThroneConnectionState.Retrying:
            <Alert Variant="info">@ThroneService.Problem</Alert>
            break;
        case ThroneConnectionState.Stopped when !string.IsNullOrEmpty(ThroneService.Problem):
            <Alert Variant="danger" Title="Stopped">@ThroneService.Problem</Alert>
            break;
    }

    @if (State == ThroneConnectionState.NotSetUp)
    {
        <Card Title="Set up" MultiLineDescription="true"
              Description="Throne sends each gift to a webhook URL. MultiShock creates a private one on the Throne relay and collects gifts from it, so you don't need to sign in to Throne or open any ports.">
            <ol class="list-decimal space-y-1 pl-5 text-sm text-app-muted">
                <li>Create a webhook URL here.</li>
                <li>On Throne, open your creator settings, go to Integrations and turn on Webhooks.</li>
                <li>Paste the URL as the subscriber URL and save.</li>
            </ol>
            <div class="mt-4">
                <Button Variant="primary" Icon="link" Text="Create webhook URL" Loading="_busy" OnClick="CreateConnection" />
            </div>
        </Card>
    }
    else
    {
        <Card Title="Webhook" MultiLineDescription="true"
              Description="The relay keeps gifts for seven days, so gifts sent while MultiShock is closed still run your flows when you open it again.">
            <ChildContent>
                <SettingRow Label="Webhook URL"
                            Description="Paste this into Throne under Integrations, then Webhooks. Keep it private and off stream: it works like a password.">
                    <div class="flex min-w-0 items-center gap-2">
                        <code class="tile min-w-0 flex-1 truncate px-2.5 py-1.5 font-mono text-xs text-app-text">@DisplayedWebhookUrl</code>
                        <Button Variant="secondary" Size="icon" Icon="@(_revealUrl ? "eye-off" : "eye")"
                                AriaLabel="@(_revealUrl ? "Hide webhook URL" : "Show webhook URL")"
                                Title="@(_revealUrl ? "Hide" : "Show")" OnClick="() => _revealUrl = !_revealUrl" />
                        <Button Variant="secondary" Size="icon" Icon="@(_copied ? "check" : "copy")"
                                AriaLabel="@(_copied ? "Webhook URL copied" : "Copy webhook URL")" Title="Copy webhook URL"
                                OnClick="CopyWebhookUrl" />
                    </div>
                </SettingRow>
                <SettingRow Label="Throne account"
                            Description="Linked automatically by the first gift. A connection only ever accepts gifts for that account.">
                    <span class="text-sm @(ThroneService.CreatorUsername is null ? "text-app-subtle" : "text-app-text")">
                        @(ThroneService.CreatorUsername ?? (State == ThroneConnectionState.Receiving ? "Linked" : "Not linked yet"))
                    </span>
                </SettingRow>
            </ChildContent>
            <Footer>
                <Button Variant="danger" Size="sm" Icon="trash-2" Text="Remove connection" OnClick="() => _confirmRemove = true" />
            </Footer>
        </Card>
    }

    <Card Title="Flow trigger"
          Description="Throne has no built-in reactions. Add this trigger to a flow and connect it to the shocker actions you want.">
        <SettingRow Label="Throne gift received" Description="@GiftTrigger.Description">
            <NavButton Href="/flows" Text="Open flows" />
        </SettingRow>
    </Card>

    <Card Title="Recent gifts" Description="Gifts received since MultiShock started, newest first." NoPadding="true">
        <Actions>
            @if (_recentGifts.Count > 0)
            {
                <Button Variant="ghost" Size="sm" Icon="trash-2" Text="Clear" OnClick="ClearRecent" />
            }
        </Actions>
        <ChildContent>
            @if (_recentGifts.Count == 0)
            {
                <div class="px-4 py-6">
                    <p class="text-sm text-app-muted">No gifts yet.</p>
                    <p class="mt-0.5 text-xs text-app-subtle">Gifts and crowdfund contributions appear here as they arrive.</p>
                </div>
            }
            else
            {
                <ol class="max-h-96 divide-y divide-app-border overflow-y-auto">
                    @foreach (var gift in _recentGifts)
                    {
                        <li class="flex items-start justify-between gap-4 px-4 py-2.5 text-sm">
                            <div class="min-w-0">
                                <div class="font-medium text-app-text">@gift.GifterUsername</div>
                                <div class="text-xs text-app-muted">
                                    @gift.TypeLabel
                                    @if (!string.IsNullOrEmpty(gift.ItemName))
                                    {
                                        <span> · @gift.ItemName</span>
                                    }
                                    <span> · @gift.FormattedAmount</span>
                                </div>
                                @if (!string.IsNullOrEmpty(gift.Message))
                                {
                                    <p class="mt-1 break-words text-app-muted">“@gift.Message”</p>
                                }
                            </div>
                            <time class="shrink-0 text-xs text-app-subtle" datetime="@gift.ReceivedAt.ToString("o")">
                                @FormatTimestamp(gift.ReceivedAt)
                            </time>
                        </li>
                    }
                </ol>
            }
        </ChildContent>
    </Card>
</div>

<ConfirmDialog IsOpen="_confirmRemove" Title="Remove the Throne connection?"
               Message="The webhook URL stops working and any gifts still waiting on the relay are deleted. Remove the URL from Throne's Webhooks settings too. To use Throne again you'll need to create a new URL and paste it into Throne."
               ConfirmText="Remove connection" IsConfirming="_busy"
               OnCancel="() => _confirmRemove = false" OnConfirm="RemoveConnection" />

@code {
    private static readonly ThroneGiftTriggerNode GiftTrigger = new();

    private string pluginId = ThroneIntegration.ThroneIntegrationPlugin.PluginId;
    private ThroneService ThroneService => PluginServiceLocator.GetRequiredService<ThroneService>(pluginId);
    private ThroneSettingsService SettingsService =>
        PluginServiceLocator.GetRequiredService<ThroneSettingsService>(pluginId);

    private ThroneConnectionState State => ThroneService.State;
    private bool _busy;
    private bool _revealUrl;
    private bool _copied;
    private bool _confirmRemove;
    private string? _error;
    private List<ThroneGift> _recentGifts = [];

    private string DisplayedWebhookUrl
    {
        get
        {
            var url = SettingsService.WebhookUrl ?? string.Empty;
            if (_revealUrl)
            {
                return url;
            }

            const string secretPathStart = "/webhooks/throne/";
            var index = url.IndexOf(secretPathStart, StringComparison.Ordinal);
            return index < 0 ? "••••••••" : url[..(index + secretPathStart.Length)] + "••••••••";
        }
    }

    protected override void OnInitialized()
    {
        _recentGifts = SettingsService.GetRecentGifts().ToList();
        ThroneService.StateChanged += OnStateChanged;
        ThroneService.GiftReceived += OnGiftReceived;
    }

    private Task CreateConnection() => RunAsync(() => ThroneService.CreateConnectionAsync(), "Couldn't create a webhook URL");

    private Task Connect() => RunAsync(ThroneService.StartAsync, "Couldn't connect");

    private Task Disconnect() => RunAsync(ThroneService.StopAsync, "Couldn't disconnect");

    private Task SkipMissed() => RunAsync(ThroneService.SkipMissedEventsAsync, "Couldn't resume");

    private async Task RemoveConnection()
    {
        await RunAsync(ThroneService.RemoveConnectionAsync, "Couldn't remove the connection");
        _confirmRemove = false;
        _revealUrl = false;
    }

    private async Task RunAsync(Func<Task> action, string failure)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _error = $"{failure}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyWebhookUrl()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", SettingsService.WebhookUrl ?? string.Empty);
        }
        catch (JSException ex)
        {
            _error = $"Couldn't copy the webhook URL: {ex.Message}";
            return;
        }

        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private void ClearRecent()
    {
        SettingsService.ClearRecentGifts();
        _recentGifts.Clear();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnGiftReceived(ThroneGift gift) => InvokeAsync(() =>
    {
        _recentGifts = SettingsService.GetRecentGifts().ToList();
        StateHasChanged();
    });

    private static string FormatTimestamp(DateTimeOffset timestamp)
    {
        var dateTime = timestamp.ToLocalTime();
        var diff = DateTimeOffset.Now - dateTime;

        if (diff.TotalMinutes < 1)
            return "Just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours} h ago";

        return dateTime.ToString("MMM d, HH:mm");
    }

    public void Dispose()
    {
        ThroneService.StateChanged -= OnStateChanged;
        ThroneService.GiftReceived -= OnGiftReceived;
    }
}
