@page "/plugins/com-multishock-steamvroverlay/steamvroverlay"
@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@using Microsoft.Extensions.Logging
@using SteamVROverlay.Overlay
@using SteamVROverlay.Services
@implements IDisposable
@inject NavigationManager Navigation

<div class="space-y-5">
    <PageHeader Title="SteamVR overlay" Icon="watch" Description="Control shockers and view plugin information from your wrist in SteamVR.">
        <Meta><span class="chip @(Overlay.State == OverlayRuntimeState.Running ? "chip-ok" : Overlay.State == OverlayRuntimeState.WaitingForSteamVr ? "chip-info" : Overlay.State is OverlayRuntimeState.Error or OverlayRuntimeState.RuntimeNotInstalled ? "chip-danger" : "chip-neutral")" role="status"><span class="status-dot @StatusDotClass"></span> @StatusText</span></Meta>
        <Actions><Button Text="Settings" Icon="settings" Variant="ghost" OnClick="OpenSettings" />@if (Overlay.IsRunning) { <Button Text="Stop" Variant="secondary" OnClick="Stop" /> } else { <Button Text="Start" Disabled="@(!Settings.Enabled)" Title="@(!Settings.Enabled ? "Turn on Overlay enabled in Settings first" : null)" OnClick="Start" /> }</Actions>
    </PageHeader>

    @if (!Settings.Enabled) { <p class="text-sm text-app-muted">Turn on Overlay enabled in <a class="text-app-primary" href="@($"settings/plugins?open={PluginIdValue}")">Settings</a> to make Start available.</p> }
    @if (!string.IsNullOrWhiteSpace(Overlay.LastError))
    {
        <Alert Variant="danger" Title="SteamVR error">@Overlay.LastError</Alert>
    }
    else if (Overlay.State == OverlayRuntimeState.RuntimeNotInstalled)
    {
        <Alert Variant="warning" Title="SteamVR not found">
            Install SteamVR through Steam, then start the overlay again.
        </Alert>
    }
    else if (Overlay.State == OverlayRuntimeState.WaitingForSteamVr)
    {
        <Alert Variant="info" Title="Waiting for SteamVR">
            The overlay attaches automatically once SteamVR is running. It will not launch SteamVR for you.
        </Alert>
    }

    <div class="max-w-4xl grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-6">
        <div class="space-y-2">
            <h2 class="text-sm font-semibold text-app-text">Panel preview</h2>
            <div class="w-full max-w-xs space-y-2">
                <Tabs Items="PreviewViews" Value="@PreviewTarget" ValueChanged="OnPreviewTargetChanged" Variant="segmented" Class="w-full" />
                @if (PluginPages.Count > 0)
                {
                    <Select TValue="string"
                            Label="Plugin page"
                            Placeholder="Preview a page from another plugin"
                            Options="PluginPages"
                            Value="@(IsPluginPage ? PreviewTarget : null)"
                            ValueChanged="OnPreviewTargetChanged" />
                }
            </div>
            @if (PreviewDataUrl is not null)
            {
                @* The watch's height depends on the cards shown, so only the width is fixed. *@
                <img src="@PreviewDataUrl"
                     alt="Preview of the wrist panel as it appears in SteamVR"
                     width="320"
                     class="h-auto max-w-full" />
            }
            else
            {
                <Alert Variant="danger" Title="Preview unavailable">@(PreviewError ?? "Refresh the preview to try again.")</Alert>
            }
            <div class="flex flex-wrap gap-2">
                <Button Text="Refresh preview" Variant="secondary" Size="sm" Icon="refresh-cw" OnClick="RefreshPreview" />
                <Button Text="Send test notification"
                        Variant="secondary"
                        Size="sm"
                        Icon="bell"
                        Title="@(Overlay.State != OverlayRuntimeState.Running ? "Start the overlay and wait for SteamVR before sending a notification" : null)"
                        Disabled="@(Overlay.State != OverlayRuntimeState.Running)"
                        OnClick="SendTestNotification" />
            </div>
            @if (Overlay.State != OverlayRuntimeState.Running) { <p class="text-xs text-app-muted">Test notifications require the overlay to be running in SteamVR.</p> }
        </div>

        <div class="space-y-4 text-sm">
            <Card Title="Status">
                <dl class="space-y-1">
                    <div class="flex flex-wrap gap-2">
                        <dt class="text-app-muted w-40">Attached to</dt>
                        <dd>@(Settings.Hand == OverlayHand.Right ? "Right controller" : "Left controller")</dd>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <dt class="text-app-muted w-40">Panel visible</dt>
                        <dd>@(Overlay.IsOverlayVisible ? "Yes" : "No")</dd>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <dt class="text-app-muted w-40">Activation</dt>
                        <dd>@(Settings.GazeActivation ? $"Wrist turned within {Settings.GazeAngleDegrees:0}°" : "Always visible")</dd>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <dt class="text-app-muted w-40">Panel width</dt>
                        <dd>@($"{Settings.WidthMeters * 100:0.#} cm")</dd>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <dt class="text-app-muted w-40">Shock button</dt>
                        <dd>@(Settings.HoldToShock ? $"Hold {Settings.ShockHoldMs / 1000.0:0.#}s" : "Single press")</dd>
                    </div>
                </dl>
            </Card>

            <details class="panel group/advanced">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-panel px-4 py-3 [&::-webkit-details-marker]:hidden">
                    <span class="min-w-0"><span class="panel-title block">Using the panel</span><span class="panel-desc block">Learn wrist controls, placement and notifications.</span></span>
                    <LucideIcon Name="chevron-right" Size="16" Class="shrink-0 text-app-muted transition-transform group-open/advanced:rotate-90" />
                </summary>
                <div class="border-t border-app-border p-4">
                    <ul class="space-y-1 text-app-muted list-disc pl-5">
                        <li>Turn the wrist wearing the panel toward your face to reveal it.</li>
                        <li>Point the other controller at it and use the trigger to click.</li>
                        @if (Settings.GrabToMove)
                        {
                            <li>To move it, point at it, hold the grip, and let go where you want it. The new spot is saved.</li>
                        }
                        <li>Move watch at the bottom makes the whole watch grabbable with the trigger or grip until you tap Done.</li>
                        <li>The watch stacks the time, what's playing, volume and microphone, and the VR app's performance, with device batteries at the bottom that the Batteries button shows or hides.</li>
                        <li>Shockers near the bottom of the watch opens the shocker controls; Watch at the top goes back.</li>
                        <li>Other plugins can add their own cards to the watch and pages below Shockers.</li>
                        <li>After the wrist has been down for 10 seconds, raising it shows the watch again.</li>
                        <li>Flows can pop up notifications in your view with the Show VR Notification node.</li>
                    </ul>
                </div>
            </details>

        </div>
    </div>
</div>

@code {
    private void OpenSettings() => Navigation.NavigateTo($"settings/plugins?open={PluginIdValue}");
    private static readonly string PluginIdValue = SteamVROverlayPlugin.PluginId;

    private OverlaySettingsService Settings =>
        PluginServiceLocator.GetRequiredService<OverlaySettingsService>(PluginIdValue);

    private WristOverlayService Overlay =>
        PluginServiceLocator.GetRequiredService<WristOverlayService>(PluginIdValue);

    private WatchProviderService WatchProviders =>
        PluginServiceLocator.GetRequiredService<WatchProviderService>(PluginIdValue);

    private static readonly IReadOnlyList<Tabs.TabItem> PreviewViews =
    [
        new(nameof(PanelView.Watch), "Watch"),
        new(nameof(PanelView.Shockers), "Shockers"),
    ];

    private string? PreviewDataUrl;
    private string? PreviewError;

    /// <summary>A built-in view's name, or another plugin's page key.</summary>
    private string PreviewTarget = nameof(PanelView.Watch);

    private IReadOnlyList<Select<string>.SelectOption<string>> PluginPages = [];

    private bool IsPluginPage => PluginPages.Any(p => p.Value == PreviewTarget);

    protected override async Task OnInitializedAsync()
    {
        Overlay.StateChanged += OnStateChanged;
        await RefreshPreview();
    }

    private string StatusText => Overlay.State switch
    {
        OverlayRuntimeState.Running when Overlay.IsOverlayVisible => "Connected — panel visible",
        OverlayRuntimeState.Running => "Connected — panel hidden",
        OverlayRuntimeState.WaitingForSteamVr => "Waiting for SteamVR",
        OverlayRuntimeState.RuntimeNotInstalled => "SteamVR is not installed",
        OverlayRuntimeState.Error => "Error",
        _ => "Stopped"
    };

    private string StatusDotClass => Overlay.State switch
    {
        OverlayRuntimeState.Running => "bg-app-success",
        OverlayRuntimeState.WaitingForSteamVr => "bg-app-info",
        OverlayRuntimeState.Error or OverlayRuntimeState.RuntimeNotInstalled => "bg-app-danger",
        _ => "bg-app-subtle"
    };

    private async Task RefreshPreview()
    {
        try
        {
            PreviewError = null;
            PluginPages =
            [
                .. WatchProviders.Poll().SelectMany(c => c.Content.Pages.Select(page =>
                    new Select<string>.SelectOption<string>(WatchContent.PageKey(c.PluginId, page.Id), $"{page.Title} ({c.PluginName})")))
            ];

            if (!Enum.TryParse<PanelView>(PreviewTarget, out var view) && !IsPluginPage)
            {
                PreviewTarget = nameof(PanelView.Watch);
                view = PanelView.Watch;
            }

            var png = IsPluginPage
                ? await Overlay.RenderPreviewPngAsync(PanelView.Watch, PreviewTarget)
                : await Overlay.RenderPreviewPngAsync(view);
            PreviewDataUrl = "data:image/png;base64," + Convert.ToBase64String(png);
        }
        catch (Exception ex)
        {
            SteamVROverlayPlugin.Logger?.LogWarning(ex, "Failed to render SteamVR panel preview");
            PreviewError = "The panel could not be rendered. Refresh to retry; details are in the plugin log.";
            PreviewDataUrl = null;
        }
    }

    private async Task OnPreviewTargetChanged(string? target)
    {
        PreviewTarget = target ?? nameof(PanelView.Watch);
        await RefreshPreview();
    }

    private void SendTestNotification() =>
        Overlay.ShowNotification("MultiShock", "This is how flow notifications look in VR.", TimeSpan.FromSeconds(4), buzz: true);

    private async Task Start()
    {
        Overlay.Start();
        await RefreshPreview();
    }

    private void Stop() => Overlay.Stop();

    private void OnStateChanged(OverlayRuntimeState state) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Overlay.StateChanged -= OnStateChanged;
    }
}
