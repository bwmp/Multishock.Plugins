@page "/plugins/com-multishock-twitchintegration/twitchintegration"
@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@inject IPluginHost Host
@implements IDisposable

<PageHeader Title="Twitch" Icon="tv-minimal-play" Description="React to Twitch cheers, subscriptions, follows, hype trains and channel points with your shockers.">
    <Meta>
        <ConnectionChip Connected="TwitchService.IsConnected" WaitingForLogin="IsAuthenticating" Connecting="TwitchService.IsConnecting"
                        Reconnecting="TwitchService.IsReconnecting" Failed="@(!string.IsNullOrEmpty(ErrorMessage))" />
    </Meta>
    <Actions>
        <div data-guided-setup="twitch-home-login-button">
            @if (TwitchService.IsConnected)
            {
                <Button Variant="secondary" Icon="unplug" Text="Disconnect" OnClick="Disconnect" />
            }
            else
            {
                <Button Title="@ConnectBlockedReason" Variant="primary" Icon="plug" Text="Connect"
                        Loading="TwitchService.IsConnecting"
                        Disabled="@(ConnectBlockedReason != null)" OnClick="ConnectAccount" />
            }
        </div>
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    <div data-guided-setup="twitch-home-connection">
        <Card Title="Connection" Description="Changes save automatically.">
            <SettingRow Label="Account" Description="@AccountDescription">
                @if (TwitchService.IsConnected)
                {
                    <Button Text="Sign out" Variant="secondary" Size="sm" OnClick="LogoutAsync" />
                }
                else if (IsAuthenticating)
                {
                    <Button Text="Cancel login" Variant="secondary" Size="sm" OnClick="CancelLogin" />
                }
            </SettingRow>
            <div data-guided-setup="twitch-home-auto-connect">
                <SettingRow Label="Connect on startup" Description="Connect to Twitch when MultiShock starts.">
                    <Toggle AriaLabel="Connect on startup" Value="AutoConnectEnabled" ValueChanged="ToggleAutoConnect" />
                </SettingRow>
            </div>
            @if (IsAuthenticating && !string.IsNullOrEmpty(AuthService.PendingUserCode))
            {
                <div class="callout callout-info mt-3 space-y-2" role="status">
                    <p>Approve MultiShock on Twitch with this code: <strong class="font-mono">@AuthService.PendingUserCode</strong></p>
                    <a class="text-app-primary hover:underline" href="@AuthService.PendingVerificationUri" target="_blank" rel="noopener noreferrer">Open the Twitch activation page</a>
                </div>
            }
            else if (AuthService.LoginExpired && !TwitchService.IsConnected)
            {
                <Alert Variant="warning" Class="mt-3">Your Twitch login expired. Connect again to keep receiving events.</Alert>
            }
            else if (!string.IsNullOrEmpty(AuthStatus))
            {
                <p role="status" class="mt-3 text-sm text-app-muted">@AuthStatus</p>
            }
            @if (!string.IsNullOrEmpty(ErrorMessage) && TwitchService.IsReconnecting && !TwitchService.IsConnected)
            {
                <Alert Variant="info" Title="Reconnecting to Twitch" Class="mt-3">@ErrorMessage</Alert>
            }
            else if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <Alert Variant="danger" Title="Twitch reported a problem" Class="mt-3">
                    <ChildContent>@ErrorMessage</ChildContent>
                    <Actions><Button Text="Dismiss" Variant="ghost" Size="sm" OnClick="@(() => ErrorMessage = null)" /></Actions>
                </Alert>
            }
        </Card>
    </div>

    <Card Title="Reactions" Description="Run shocker actions straight from Twitch events. For custom logic, use the Twitch triggers in a flow instead.">
        <Actions>
            <Button Text="Guided setup" Icon="route" Variant="ghost" Size="sm" OnClick="@(() => Host.StartPluginGuidedSetup(TwitchIntegrationPlugin.PluginId))" />
        </Actions>
        <ChildContent>
            <SettingRow Label="Cheers" Description="Sections and bit brackets for cheers.">
                <Meta><SummaryChip Summary="CheerSummary" /></Meta>
                <ChildContent>
                    <NavButton Href="/plugins/com-multishock-twitchintegration/cheer-config" AriaLabel="Configure cheers" data-guided-setup="twitch-home-open-cheers" />
                </ChildContent>
            </SettingRow>
            <SettingRow Label="Subscriptions" Description="Brackets or scaling for each tier, including gifted subs.">
                <Meta><SummaryChip Summary="SubSummary" /></Meta>
                <ChildContent>
                    <NavButton Href="/plugins/com-multishock-twitchintegration/sub-config" AriaLabel="Configure subscriptions" />
                </ChildContent>
            </SettingRow>
            <SettingRow Label="Follows" Description="One action for each first-time follower.">
                <Meta><SummaryChip Summary="FollowSummary" /></Meta>
                <ChildContent>
                    <NavButton Href="/plugins/com-multishock-twitchintegration/follow-config" AriaLabel="Configure follows" />
                </ChildContent>
            </SettingRow>
            <SettingRow Label="Hype trains" Description="Actions while a train runs and when it ends.">
                <Meta><SummaryChip Summary="HypeSummary" /></Meta>
                <ChildContent>
                    <NavButton Href="/plugins/com-multishock-twitchintegration/hype-train-config" AriaLabel="Configure hype trains" />
                </ChildContent>
            </SettingRow>
            <SettingRow Label="Channel points" Description="Actions for channel point rewards.">
                <Meta><SummaryChip Summary="RedeemSummary" /></Meta>
                <ChildContent>
                    <NavButton Href="/plugins/com-multishock-twitchintegration/redeem-config" AriaLabel="Configure channel points" />
                </ChildContent>
            </SettingRow>
            <SettingRow Label="Chat messages" Description="Chat replies when reactions fire, and a repeating message.">
                <Meta><SummaryChip Summary="ChatSummary" /></Meta>
                <ChildContent>
                    <NavButton Href="/plugins/com-multishock-twitchintegration/chat-messages" AriaLabel="Configure chat messages" />
                </ChildContent>
            </SettingRow>
        </ChildContent>
    </Card>

    <TwitchIntegration.Components.EventLog />

    <details class="panel group/advanced">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-panel px-4 py-3 [&::-webkit-details-marker]:hidden">
            <span class="min-w-0">
                <span class="panel-title block">Advanced</span>
                <span class="panel-desc block">Flow triggers, manual token, local Twitch CLI, legacy import and performance timings.</span>
            </span>
            <LucideIcon Name="chevron-right" Size="16" Class="shrink-0 text-app-muted transition-transform group-open/advanced:rotate-90" />
        </summary>
        <div class="border-t border-app-border p-4">
            <div class="border-b border-app-border pb-4">
                <h3 class="text-sm font-medium text-app-text">Flow triggers</h3>
                <p class="mt-0.5 text-xs text-app-muted">Flow triggers this plugin adds. They fire in Flows whether or not the reactions above are on.</p>
                <ul class="mt-2 grid gap-x-4 gap-y-1 text-sm text-app-text sm:grid-cols-2">
                    @foreach (var trigger in FlowTriggers)
                    {
                        <li class="flex items-center gap-2"><LucideIcon Name="zap" Size="14" Class="shrink-0 text-app-muted" />@trigger</li>
                    }
                </ul>
            </div>
            <SettingRow Label="Manual OAuth token" Description="Optional. Connect uses this token instead of signing in through Twitch.">
                <Help>
                    <span class="block">Needs these scopes:</span>
                    <span class="mt-1 flex flex-wrap gap-1">
                        @foreach (var scope in TwitchConstants.RequiredScopes)
                        {
                            <Badge Class="font-mono">@scope</Badge>
                        }
                    </span>
                </Help>
                <ChildContent>
                    <div class="flex items-center gap-1">
                        <TextInput InputType="password" Placeholder="Optional" Value="@OAuthToken" ValueChanged="@(value => OAuthToken = value ?? string.Empty)"
                                   Disabled="@(TwitchService.IsConnected || IsAuthenticating)" aria-label="Manual OAuth token" Class="min-w-0 flex-1" />
                        <Button Variant="ghost" Size="icon-sm" Icon="trash-2" AriaLabel="Clear saved token" Title="Clear saved token"
                                Disabled="@(string.IsNullOrWhiteSpace(OAuthToken) || IsAuthenticating)" OnClick="ClearToken" />
                    </div>
                </ChildContent>
            </SettingRow>
            <SettingRow Label="Use local Twitch CLI" Description="Connect to a local Twitch CLI WebSocket server for testing. Reconnect after changing this.">
                <Toggle AriaLabel="Use local Twitch CLI" Value="UseLocalCliEnabled" ValueChanged="ToggleLocalCli" />
            </SettingRow>
            @if (UseLocalCliEnabled)
            {
                <SettingRow Label="CLI endpoint" Description="No Twitch login is needed for the local CLI.">
                    <TextInput Value="@LocalCliUrl" Error="@LocalCliUrlError" ValueChanged="UpdateLocalCliUrl" aria-label="Twitch CLI WebSocket URL" />
                </SettingRow>
            }
            <SettingRow Label="Legacy import" Description="Replace your Twitch reactions and chat messages with the ones in an older MultiShock config.json file.">
                <Help>
                    @if (!string.IsNullOrEmpty(LegacyImportMessage))
                    {
                        <Alert Variant="@(LegacyImportSuccess ? "success" : "danger")" Class="mt-2">
                            @LegacyImportMessage
                            @if (!string.IsNullOrWhiteSpace(LegacyImportDetails))
                            {
                                <pre class="mt-2 whitespace-pre-wrap text-xs">@LegacyImportDetails</pre>
                            }
                        </Alert>
                    }
                </Help>
                <ChildContent>
                    <div class="flex items-center gap-2">
                        <TextInput Value="@LegacyConfigPath" ValueChanged="@(value => LegacyConfigPath = value ?? string.Empty)" aria-label="Legacy config.json path" Class="min-w-0 flex-1" />
                        <Button Text="Import" Variant="secondary" Size="sm" Loading="IsImportingLegacyConfig"
                                Disabled="@string.IsNullOrWhiteSpace(LegacyConfigPath)" OnClick="@(() => ConfirmingImport = true)" />
                    </div>
                </ChildContent>
            </SettingRow>
            <TwitchIntegration.Components.PerformancePanel />
        </div>
    </details>
</div>

<ConfirmDialog IsOpen="ConfirmingImport" Title="Replace Twitch reactions?"
               Message="Importing replaces your current cheer, subscription, follow, hype train and channel point reactions with the ones in this file. This can't be undone."
               ConfirmText="Import and replace" OnCancel="@(() => ConfirmingImport = false)" OnConfirm="ImportLegacyConfigAsync" />

@code {
    // Use service locator instead of @inject for plugin-specific services
    // This survives hot-reload where the DI container has stale types
    private static readonly string PluginId = TwitchIntegrationPlugin.PluginId;
    private TwitchEventSubService TwitchService => PluginServiceLocator.GetRequiredService<TwitchEventSubService>(PluginId);
    private TwitchAuthService AuthService => PluginServiceLocator.GetRequiredService<TwitchAuthService>(PluginId);
    private LegacyTwitchImportService LegacyImportService => PluginServiceLocator.GetRequiredService<LegacyTwitchImportService>(PluginId);

    private string OAuthToken = "";
    private string? ErrorMessage;
    private string? AuthStatus;
    private bool IsAuthenticating;
    private bool AutoConnectEnabled;
    private bool UseLocalCliEnabled;
    private string LocalCliUrl = string.Empty;
    private string? LocalCliUrlError;
    private bool IsImportingLegacyConfig;
    private bool ConfirmingImport;
    private bool LegacyImportSuccess;
    private string LegacyConfigPath = string.Empty;
    private string? LegacyImportMessage;
    private string? LegacyImportDetails;

    private static readonly string[] FlowTriggers = TwitchIntegrationPlugin.CreateNodeTypes()
        .OfType<MultiShock.PluginSdk.Flow.IFlowTriggerNode>()
        .Select(node => node.DisplayName)
        .ToArray();

    private EventLogService EventLogService => PluginServiceLocator.GetRequiredService<EventLogService>(PluginId);

    private string? ConnectBlockedReason =>
        IsAuthenticating ? "Finish or cancel the pending Twitch login"
        : TwitchService.IsConnecting ? "A Twitch connection is in progress"
        : UseLocalCliEnabled && LocalCliUrlError != null ? "Correct the CLI endpoint in Advanced"
        : null;

    private string AccountDescription =>
        TwitchService.IsConnected
            ? string.IsNullOrEmpty(TwitchService.CurrentUserName) ? "Signed in." : $"Signed in as {TwitchService.CurrentUserName}."
        : IsAuthenticating ? "Waiting for you to approve MultiShock on Twitch."
        : UseLocalCliEnabled ? "Using the local Twitch CLI. No sign-in needed."
        : !string.IsNullOrWhiteSpace(AuthService.StoredToken) ? "Signed in. Connect to receive events."
        : "Not signed in. Connect opens the Twitch sign-in.";

    private ReactionSummary CheerSummary
    {
        get
        {
            var config = PluginServiceLocator.GetRequiredService<CheerConfigService>(PluginId).Config;
            var on = config.Sections.Where(s => s.Enabled).ToList();
            return ActionOptions.Summarize(config.Enabled, on.Count, "section", "sections",
                (on.Count(s => s.SelectedShockerIds.Count == 0), "shockers"),
                (on.Count(s => s.Brackets.Count == 0), "brackets"));
        }
    }

    private ReactionSummary SubSummary
    {
        get
        {
            var config = PluginServiceLocator.GetRequiredService<SubscriptionConfigService>(PluginId).Config;
            var on = config.Sections.Where(s => s.Enabled).ToList();
            return ActionOptions.Summarize(config.Enabled, on.Count, "tier", "tiers",
                (on.Count(s => s.SelectedShockerIds.Count == 0), "shockers"),
                (on.Count(s => s.Mode == SubscriptionMode.Brackets && s.Brackets.Count == 0), "brackets"));
        }
    }

    private ReactionSummary FollowSummary
    {
        get
        {
            var config = PluginServiceLocator.GetRequiredService<FollowConfigService>(PluginId).Config;
            if (!config.Enabled) return ReactionSummary.Off;
            return config.SelectedShockerIds.Count == 0
                ? new(ReactionStatus.Attention, "No shockers")
                : new(ReactionStatus.Ready, "On");
        }
    }

    private ReactionSummary HypeSummary
    {
        get
        {
            var config = PluginServiceLocator.GetRequiredService<HypeTrainConfigService>(PluginId).Config;
            var on = new[] { config.During, config.End }.Where(s => s.Enabled).ToList();
            return ActionOptions.Summarize(config.Enabled, on.Count, "stage", "stages",
                (on.Count(s => s.SelectedShockerIds.Count == 0), "shockers"));
        }
    }

    private ReactionSummary RedeemSummary
    {
        get
        {
            var config = PluginServiceLocator.GetRequiredService<RedeemConfigService>(PluginId).Config;
            var on = config.Redeems.Where(r => r.Enabled).ToList();
            return ActionOptions.Summarize(config.Enabled, on.Count, "reward", "rewards",
                (on.Count(r => r.SelectedShockerIds.Count == 0), "shockers"));
        }
    }

    private ReactionSummary ChatSummary
    {
        get
        {
            var chat = PluginServiceLocator.GetRequiredService<AutoMessageService>(PluginId).Config;
            var templates = new[] { chat.Cheer, chat.Redeem, chat.Subscription, chat.GiftSubscription, chat.Follow }
                .Where(m => m.Enabled).Select(m => m.Template).ToList();
            if (chat.Repeating.Enabled) templates.Add(chat.Repeating.Template);
            return ActionOptions.Summarize(chat.Enabled, templates.Count, "message", "messages",
                (templates.Count(string.IsNullOrWhiteSpace), "text"));
        }
    }

    protected override void OnInitialized()
    {
        TwitchService.ConnectionStateChanged += OnConnectionStateChanged;
        TwitchService.ErrorOccurred += OnError;
        AuthService.StatusChanged += OnAuthStatusChanged;

        OAuthToken = AuthService.StoredToken ?? "";
        AutoConnectEnabled = AuthService.AutoConnect;
        UseLocalCliEnabled = AuthService.UseLocalCli;
        LocalCliUrl = AuthService.LocalCliUrl;
        LegacyConfigPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "MultiShock", "config.json");
    }

    private async Task ImportLegacyConfigAsync()
    {
        ConfirmingImport = false;
        IsImportingLegacyConfig = true;
        LegacyImportMessage = null;
        LegacyImportDetails = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await LegacyImportService.ImportAsync(LegacyConfigPath);
            LegacyImportSuccess = result.Success;
            LegacyImportMessage = result.Message;
            LegacyImportDetails = result.Details;
            EventLogService.AddLog(result.Success ? "Legacy Twitch config imported" : $"Legacy import failed: {result.Message}", !result.Success);
        }
        catch (Exception ex)
        {
            LegacyImportSuccess = false;
            LegacyImportMessage = $"Legacy import failed: {ex.Message}";
            LegacyImportDetails = null;
            EventLogService.AddLog(LegacyImportMessage, true);
        }
        finally
        {
            IsImportingLegacyConfig = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoginWithTwitch()
    {
        IsAuthenticating = true;
        AuthStatus = null;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            EventLogService.AddLog("Starting Twitch login…");
            var token = await AuthService.AuthenticateAsync();

            if (!string.IsNullOrEmpty(token))
            {
                EventLogService.AddLog("Login successful, connecting to EventSub…");
                OAuthToken = token;
                await TwitchService.ConnectAsync();
            }
            else
            {
                EventLogService.AddLog("Login was cancelled or failed", isError: true);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Login failed: {ex.Message}";
            EventLogService.AddLog($"Login error: {ex.Message}", isError: true);
        }
        finally
        {
            IsAuthenticating = false;
            AuthStatus = null;
            StateHasChanged();
        }
    }

    private void CancelLogin()
    {
        AuthService.CancelAuthentication();
        IsAuthenticating = false;
        AuthStatus = null;
        EventLogService.AddLog("Login cancelled");
        StateHasChanged();
    }

    private void OnAuthStatusChanged(string status)
    {
        InvokeAsync(() =>
        {
            AuthStatus = status;
            EventLogService.AddLog(status);
            StateHasChanged();
        });
    }

    private async Task Connect()
    {
        ErrorMessage = null;
        EventLogService.AddLog("Connecting to Twitch…");

        var token = OAuthToken.Trim();
        // The field is prefilled with the stored login; saving it as a manual token would drop its refresh token.
        var isStoredLogin = token == AuthService.StoredToken;
        var success = await TwitchService.ConnectAsync(isStoredLogin ? null : token);
        if (!success)
        {
            EventLogService.AddLog("Connection failed", isError: true);

            // Check if it's a scope issue
            if (ErrorMessage?.Contains("scope", StringComparison.OrdinalIgnoreCase) == true)
            {
                EventLogService.AddLog("Detected missing scopes, clearing token and re-authenticating…");
                await LogoutAsync();
                await Task.Delay(500); // Brief delay to ensure UI updates
                await LoginWithTwitch();
            }
        }
        else if (!isStoredLogin && !string.IsNullOrWhiteSpace(token))
        {
            AuthService.SaveAuthToken(token);
        }
    }

    private async Task Disconnect()
    {
        await TwitchService.DisconnectAsync();
        ErrorMessage = null;
        EventLogService.AddLog("Disconnected");
    }

    private Task ConnectAccount() => UseLocalCliEnabled ? ConnectWithSavedToken()
        : !string.IsNullOrWhiteSpace(OAuthToken) ? Connect()
        : CanConnectWithoutLogin ? ConnectWithSavedToken() : LoginWithTwitch();

    private bool CanConnectWithoutLogin => UseLocalCliEnabled || !string.IsNullOrWhiteSpace(AuthService.StoredToken);

    private async Task ConnectWithSavedToken()
    {
        if (!CanConnectWithoutLogin) return;

        ErrorMessage = null;
        EventLogService.AddLog(UseLocalCliEnabled ? "Connecting to local Twitch CLI…" : "Connecting with saved token…");

        var success = await TwitchService.ConnectAsync();
        if (!success)
        {
            EventLogService.AddLog("Connection failed", isError: true);

            // Check if it's a scope issue
            if (ErrorMessage?.Contains("scope", StringComparison.OrdinalIgnoreCase) == true)
            {
                EventLogService.AddLog("Detected missing scopes, clearing token and re-authenticating…");
                await LogoutAsync();
                await Task.Delay(500); // Brief delay to ensure UI updates
                await LoginWithTwitch();
            }
        }
    }

    private void OnConnectionStateChanged(bool connected)
    {
        InvokeAsync(() =>
        {
            if (connected) ErrorMessage = null;
            StateHasChanged();
        });
    }

    private void OnError(string error)
    {
        InvokeAsync(() =>
        {
            ErrorMessage = error;
            StateHasChanged();
        });
    }

    private void ToggleAutoConnect(bool enabled)
    {
        AutoConnectEnabled = enabled;
        AuthService.AutoConnect = enabled;
        EventLogService.AddLog(enabled ? "Auto-connect enabled" : "Auto-connect disabled");
    }

    private void ToggleLocalCli(bool enabled)
    {
        UseLocalCliEnabled = enabled;
        AuthService.UseLocalCli = enabled;
        var target = enabled ? "local CLI" : "production";
        EventLogService.AddLog($"WebSocket target set to {target}");

        if (TwitchService.IsConnected)
        {
            EventLogService.AddLog("Note: Reconnect for the change to take effect");
        }
    }

    private void UpdateLocalCliUrl(string? value)
    {
        LocalCliUrl = value?.Trim() ?? string.Empty;
        if (!TwitchAuthService.IsValidLocalCliUrl(LocalCliUrl))
        {
            LocalCliUrlError = "Enter a ws:// or wss:// URL, e.g. " + TwitchConstants.DefaultLocalCliUrl;
            return;
        }

        LocalCliUrlError = null;
        AuthService.LocalCliUrl = LocalCliUrl;
    }

    private async Task LogoutAsync()
    {
        await TwitchService.DisconnectAsync();
        AuthService.ClearAuth();
        OAuthToken = "";
        AutoConnectEnabled = false;
        EventLogService.AddLog("Logged out and cleared saved token");
        StateHasChanged();
    }

    private void ClearToken()
    {
        AuthService.ClearAuth();
        OAuthToken = "";
        EventLogService.AddLog("Token cleared from config");
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthService.StatusChanged -= OnAuthStatusChanged;
        TwitchService.ConnectionStateChanged -= OnConnectionStateChanged;
        TwitchService.ErrorOccurred -= OnError;
    }
}
