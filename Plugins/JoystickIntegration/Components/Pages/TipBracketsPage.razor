@page "/plugins/com-multishock-joystickintegration/tip-brackets"
@implements IDisposable

<PageHeader Title="Tip brackets" Icon="coins"
            Description="Set how strongly each tip size reacts, without building a flow. Tips handled by a tip menu item rule can skip these brackets. Changes save automatically.">
    <Breadcrumb><BackLink /></Breadcrumb>
    <Actions>
        <Toggle Label="Enabled" Value="Config.Enabled" ValueChanged="@(v => Service.SetEnabled(v))" />
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!Config.Enabled)
    {
        <Alert Variant="neutral">Tip brackets are off. Tips still reach your flows through the Tip Received trigger.</Alert>
    }

    <Card Title="Action" Description="Applies to every bracket below.">
        <SettingRow Label="Shockers" Description="The shockers a tip can run on.">
            <Help>
                @if (Config.SelectedShockerIds.Count == 0)
                {
                    <span class="inline-flex items-center gap-1.5 text-app-warning">
                        <LucideIcon Name="alert-triangle" Size="12" Class="shrink-0" />
                        Select at least one shocker. Nothing runs until you do.
                    </span>
                }
            </Help>
            <ChildContent>
                <ShockerSelect Label="Shockers" Class="[&_label]:sr-only" MultiSelect="true" SelectedIds="Config.SelectedShockerIds"
                               SelectedIdsChanged="@(ids => Service.SetSelectedShockers(ids))" />
            </ChildContent>
        </SettingRow>
        <SettingRow Label="Command" Description="What the shockers do when a bracket fires.">
            <Select TValue="string" Label="Command" Class="[&_label]:sr-only" Value="@Config.CommandType" Options="ActionOptions.Commands"
                    ValueChanged="@(v => Service.SetCommandType(v ?? "Vibrate"))" />
        </SettingRow>
        @if (Config.CommandType == "Shock")
        {
            <SettingRow Label="Warning vibrate" Description="Vibrate briefly before each shock.">
                <Toggle AriaLabel="Warning vibrate" Value="Config.WarningVibrate"
                        ValueChanged="@(v => Service.SetWarningVibrate(v))" />
            </SettingRow>
        }
        <SettingRow Label="Match exact amounts"
                    Description="Only fire a bracket when the tip equals its amount, instead of using the highest bracket at or below the tip.">
            <Toggle AriaLabel="Match exact amounts" Value="Config.FixedAmount"
                    ValueChanged="@(v => Service.SetFixedAmount(v))" />
        </SettingRow>
    </Card>

    <Card Title="Brackets" Description="@BracketsDescription" NoPadding="@(Config.Brackets.Count > 0)">
        <Actions>
            @if (Config.Brackets.Count > 0)
            {
                <Button Variant="secondary" Size="sm" Icon="plus" Text="Add bracket" OnClick="@(() => Service.AddBracket())" />
            }
        </Actions>
        <ChildContent>
            @if (Config.Brackets.Count == 0)
            {
                <EmptyState Icon="coins" Title="No brackets yet"
                            Description="Add a bracket for each tip size you want to react to, from small tips to big ones.">
                    <Actions>
                        <Button Variant="primary" Icon="plus" Text="Add bracket" OnClick="@(() => Service.AddBracket())" />
                    </Actions>
                </EmptyState>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[36rem] text-sm">
                        <thead>
                            <tr class="border-b border-app-border text-left text-xs text-app-muted">
                                <th scope="col" class="w-36 py-2 pl-4 pr-3 font-medium">From</th>
                                <th scope="col" class="w-32 px-3 py-2 font-medium">Intensity</th>
                                <th scope="col" class="w-32 px-3 py-2 font-medium">Duration</th>
                                <th scope="col" class="w-52 px-3 py-2 font-medium">Mode</th>
                                <th scope="col" class="py-2 pl-3 pr-4"><span class="sr-only">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-app-border">
                            @foreach (var bracket in Config.Brackets.OrderBy(b => b.TokenAmount))
                            {
                                <tr @key="bracket.Id">
                                    <td class="py-2 pl-4 pr-3">
                                        <NumberField Label="Bracket starts at (tokens)" Class="[&_label]:sr-only" Suffix="tokens" Value="bracket.TokenAmount" Min="1" Max="1000000"
                                                     ValueChanged="@(v => UpdateBracket(bracket, b => b.TokenAmount = ActionOptions.ClampAmount(v)))" />
                                    </td>
                                    <td class="px-3 py-2">
                                        <NumberField Label="@($"Intensity for tips from {bracket.TokenAmount} tokens")" Class="[&_label]:sr-only" Value="bracket.Intensity" Suffix="%"
                                                     Min="ActionOptions.MinIntensity" Max="ActionOptions.MaxIntensity"
                                                     ValueChanged="@(v => UpdateBracket(bracket, b => b.Intensity = ActionOptions.ClampIntensity(v)))" />
                                    </td>
                                    <td class="px-3 py-2">
                                        <NumberField Label="@($"Duration for tips from {bracket.TokenAmount} tokens")" Class="[&_label]:sr-only" Value="bracket.Duration" Suffix="s" Step="0.1"
                                                     Min="ActionOptions.MinDuration" Max="ActionOptions.MaxDuration"
                                                     ValueChanged="@(v => UpdateBracket(bracket, b => b.Duration = ActionOptions.ClampDuration(v)))" />
                                    </td>
                                    <td class="px-3 py-2">
                                        <Select TValue="string" Label="@($"Mode for tips from {bracket.TokenAmount} tokens")" Class="[&_label]:sr-only" Value="@bracket.Mode.ToString()" Options="ActionOptions.Modes"
                                                ValueChanged="@(v => UpdateBracket(bracket, b => b.Mode = ActionOptions.ParseMode(v)))" />
                                    </td>
                                    <td class="py-2 pl-3 pr-4 text-right">
                                        <Button Variant="ghost" Size="icon-sm" Icon="trash-2" Title="Remove bracket"
                                                AriaLabel="@($"Remove bracket from {bracket.TokenAmount} tokens")"
                                                OnClick="@(() => _pendingRemoval = bracket)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </Card>
</div>

<ConfirmDialog IsOpen="@(_pendingRemoval is not null)" Title="Remove bracket?"
               Message="@($"The bracket from {_pendingRemoval?.TokenAmount:N0} tokens and its intensity, duration and mode will be removed.")"
               ConfirmText="Remove bracket" OnCancel="@(() => _pendingRemoval = null)" OnConfirm="ConfirmRemove" />

@code {
    private static readonly string PluginId = JoystickIntegrationPlugin.PluginId;
    private TipBracketsConfigService Service => PluginServiceLocator.GetRequiredService<TipBracketsConfigService>(PluginId);
    private TipBracketsConfig Config => Service.Config;

    private string BracketsDescription => Config.FixedAmount
        ? "A tip fires the bracket whose amount it matches exactly."
        : "A tip fires the highest bracket at or below its amount.";

    private TipBracket? _pendingRemoval;

    protected override void OnInitialized()
    {
        Service.ConfigChanged += OnConfigChanged;
    }

    private void OnConfigChanged() => InvokeAsync(StateHasChanged);

    private void ConfirmRemove()
    {
        if (_pendingRemoval is { } bracket)
        {
            _pendingRemoval = null;
            Service.RemoveBracket(bracket.Id);
        }
    }

    private void UpdateBracket(TipBracket bracket, Action<TipBracket> mutate)
    {
        mutate(bracket);
        Service.UpdateBracket(bracket);
    }

    public void Dispose()
    {
        Service.ConfigChanged -= OnConfigChanged;
    }
}
