@implements IDisposable

<div class="space-y-3">
    <ConnectionChip Connected="Connection.IsConnected" Connecting="Connection.IsConnecting" />
    <p class="text-sm text-app-muted">Set up the connection and reactions on the Fansly page.</p>
    <NavButton Href="/plugins/com-multishock-fanslyintegration/fanslyintegration" Text="Open Fansly page" />
</div>

@code {
    private static readonly string OwnPluginId = FanslyIntegrationPlugin.PluginId;
    private FanslyConnectionService Connection => PluginServiceLocator.GetRequiredService<FanslyConnectionService>(OwnPluginId);

    [Parameter]
    public string? PluginId { get; set; }

    protected override void OnInitialized()
    {
        Connection.ConnectionStateChanged += OnConnectionChanged;
    }

    private void OnConnectionChanged(bool connected) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connection.ConnectionStateChanged -= OnConnectionChanged;
    }
}
