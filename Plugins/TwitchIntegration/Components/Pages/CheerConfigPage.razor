@page "/plugins/com-multishock-twitchintegration/cheer-config"
@using MultiShock.PluginSdk
@implements IDisposable
@using global::TwitchIntegration.Components.Config

<PageHeader Title="Cheers" Icon="coins" Description="Set how bit amounts control your shockers. Changes save automatically.">
    <Breadcrumb><BackLink /></Breadcrumb>
    <Actions>
        <div class="flex flex-wrap items-center gap-3" data-guided-setup="twitch-cheers-toolbar">
            <Toggle Label="Enabled" AriaLabel="Enable cheer reactions" Value="ConfigService.Config.Enabled" ValueChanged="ToggleMasterEnabled" />
            <Button Text="Add section" Icon="plus" Variant="secondary" OnClick="AddNewSection" />
        </div>
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!ConfigService.Config.Enabled)
    {
        <Alert Variant="neutral">Cheer reactions are off. You can set up sections now; nothing runs until you switch on Enabled. Cheers still reach your flows.</Alert>
    }
    <p class="text-sm text-app-muted">
        A cheer whose message contains a section's keyword uses that section when one of its brackets matches the amount.
        Otherwise the first section without a keyword handles it.
    </p>

    <div class="space-y-3" data-guided-setup="twitch-cheers-sections">
        @foreach (var sec in ConfigService.Config.Sections)
        {
            var expanded = ExpandedSections.Contains(sec.Id);
            var index = ConfigService.Config.Sections.IndexOf(sec);
            var name = SectionName(sec);
            var issue = SectionIssue(sec);
            <section class="panel" @key="sec.Id" aria-label="@name">
                <div class="@($"flex flex-wrap items-center gap-x-2 gap-y-1 px-3 py-2 {(expanded ? "border-b border-app-border" : "")}")">
                    <button type="button" class="flex min-w-0 flex-1 items-center gap-2 rounded-ctl py-1 text-left"
                            aria-expanded="@(expanded ? "true" : "false")" aria-controls="@(expanded ? $"section-{sec.Id}" : null)"
                            @onclick="@(() => ToggleSectionExpanded(sec.Id))">
                        <LucideIcon Name="chevron-right" Size="16" Class="@($"shrink-0 text-app-muted transition-transform {(expanded ? "rotate-90" : "")}")" />
                        <span class="min-w-0">
                            <span class="block truncate text-sm font-medium text-app-text">@name</span>
                            <span class="block truncate text-xs text-app-subtle">@SectionDetail(sec)</span>
                        </span>
                    </button>
                    @if (sec.Enabled && issue != null)
                    {
                        <SummaryChip Summary="@(new ReactionSummary(ConfigService.Config.Enabled ? ReactionStatus.Attention : ReactionStatus.Off, issue))" />
                    }
                    <Toggle AriaLabel="@($"Enable section {name}")" Value="sec.Enabled" ValueChanged="@(v => ToggleSectionEnabled(sec, v))" />
                    <div class="flex items-center">
                        <Button Variant="ghost" Size="icon-sm" Icon="arrow-up" AriaLabel="@($"Move {name} up")" Title="Move section up" Disabled="@(index == 0)" OnClick="@(() => MoveSection(sec, -1))" />
                        <Button Variant="ghost" Size="icon-sm" Icon="arrow-down" AriaLabel="@($"Move {name} down")" Title="Move section down" Disabled="@(index == ConfigService.Config.Sections.Count - 1)" OnClick="@(() => MoveSection(sec, 1))" />
                        <Button Variant="ghost" Size="icon-sm" Icon="copy" AriaLabel="@($"Duplicate {name}")" Title="Duplicate section" OnClick="@(() => DuplicateSection(sec))" />
                        <Button Variant="ghost" Size="icon-sm" Icon="trash-2" AriaLabel="@($"Delete {name}")" Title="Delete section" OnClick="@(() => RequestRemoveSection(sec))" />
                    </div>
                </div>

                @if (expanded)
                {
                    <div id="@($"section-{sec.Id}")" data-guided-setup="twitch-cheers-editor">
                        <div class="panel-body grid gap-4 sm:grid-cols-2">
                            <TextInput Label="Section name" Value="@sec.Name" ValueChanged="@(value => UpdateSectionName(sec, value ?? ""))" />
                            <TextInput Label="Keyword (optional)" Placeholder="Any cheer" Value="@sec.Keyword"
                                       ValueChanged="@(value => UpdateSectionKeyword(sec, value ?? ""))" />
                            <Select TValue="string" Label="Command" Value="@sec.CommandType" Options="ActionOptions.Commands"
                                    ValueChanged="@(value => UpdateSectionCommandType(sec, value ?? "Vibrate"))" />
                            <Select TValue="string" Label="Matching" Value="@(sec.FixedAmount ? "exact" : "round")" Options="ActionOptions.Matching"
                                    ValueChanged="@(value => UpdateSectionFixedAmount(sec, value == "exact"))" />
                            <div class="sm:col-span-2">
                                <ShockerSelect Label="Shockers" MultiSelect="true" SelectedIds="sec.SelectedShockerIds"
                                               SelectedIdsChanged="@(ids => UpdateSectionShockers(sec, ids))" />
                                @if (sec.SelectedShockerIds.Count == 0)
                                {
                                    <NoShockersHint Class="mt-1.5" />
                                }
                            </div>
                            @if (sec.CommandType == "Shock")
                            {
                                <div class="sm:col-span-2">
                                    <Toggle Label="Vibrate as a warning before each shock" Value="sec.WarningVibrate"
                                            ValueChanged="@(v => UpdateSectionWarningVibrate(sec, v))" />
                                </div>
                            }
                        </div>

                        <div class="border-t border-app-border" data-guided-setup="twitch-cheers-brackets">
                            <div class="flex items-start justify-between gap-3 px-4 py-3">
                                <div>
                                    <h3 class="text-sm font-medium text-app-text">Bit brackets</h3>
                                    <p class="text-xs text-app-muted">
                                        @(sec.FixedAmount
                                            ? "A cheer fires the bracket whose amount matches its bits exactly."
                                            : "A cheer fires the highest bracket at or below its bits.")
                                    </p>
                                </div>
                                <Button Text="Add bracket" Variant="secondary" Size="sm" Icon="plus" OnClick="@(() => AddBracketToSection(sec))" />
                            </div>

                            <BracketList TBracket="CheerBracket" CountLabel="Bits" Brackets="sec.Brackets"
                                         CountSelector="@(b => b.BitAmount)" IntensitySelector="@(b => b.Intensity)"
                                         DurationSelector="@(b => b.Duration)" ModeSelector="@(b => b.Mode.ToString())"
                                         OnCountChanged="@(change => UpdateBracketBitAmount(sec, change.Bracket, change.Value))"
                                         OnIntensityChanged="@(change => UpdateBracketIntensity(sec, change.Bracket, change.Value))"
                                         OnDurationChanged="@(change => UpdateBracketDuration(sec, change.Bracket, change.Value))"
                                         OnModeChanged="@(change => UpdateBracketMode(sec, change.Bracket, ActionOptions.ParseMode(change.Value)))"
                                         OnRemove="@(bracket => RemoveBracket(sec, bracket))"
                                         EmptyText="No brackets yet. This section won't run until you add one." />
                        </div>
                    </div>
                }
            </section>
        }

        @if (!ConfigService.Config.Sections.Any())
        {
            <Card>
                <EmptyState Icon="coins" Title="No sections yet" Description="A section sets which shockers react to cheers and how strongly for each bit amount.">
                    <Actions><Button Text="Add section" Icon="plus" Variant="primary" OnClick="AddNewSection" /></Actions>
                </EmptyState>
            </Card>
        }
    </div>

    <p class="text-sm text-app-muted">
        Gifted subs and subscriptions have their own brackets.
        <a href="/plugins/com-multishock-twitchintegration/sub-config" class="text-app-primary hover:underline" data-guided-setup="twitch-cheers-open-subs">Configure subscriptions</a>
    </p>
</div>

<ConfirmDialog IsOpen="@(PendingRemoval != null)" Title="Delete section?"
               Message="@($"{(PendingRemoval == null ? "" : SectionName(PendingRemoval))} will be removed with its keyword, shocker selection and {ActionOptions.Count(PendingRemoval?.Brackets.Count ?? 0, "bracket", "brackets")}.")"
               ConfirmText="Delete section" OnCancel="@(() => PendingRemoval = null)" OnConfirm="ConfirmRemoveSection" />

@code {
    private string pluginId = TwitchIntegration.TwitchIntegrationPlugin.PluginId;
    private CheerConfigService ConfigService => PluginServiceLocator.GetRequiredService<CheerConfigService>(pluginId);

    private HashSet<string> ExpandedSections = new();
    private CheerSection? PendingRemoval;

    protected override void OnInitialized()
    {
        ConfigService.ConfigChanged += OnConfigChanged;
        foreach (var sec in ConfigService.Config.Sections)
        {
            ExpandedSections.Add(sec.Id);
        }
    }

    private static string SectionName(CheerSection sec) =>
        string.IsNullOrWhiteSpace(sec.Name) ? "Unnamed section" : sec.Name;

    private static string SectionDetail(CheerSection sec)
    {
        var match = string.IsNullOrEmpty(sec.Keyword) ? "Any cheer" : $"Keyword \"{sec.Keyword}\"";
        return $"{match} · {sec.CommandType} · {ActionOptions.Count(sec.Brackets.Count, "bracket", "brackets")}";
    }

    private static string? SectionIssue(CheerSection sec) => (sec.Brackets.Count == 0, sec.SelectedShockerIds.Count == 0) switch
    {
        (true, true) => "No brackets or shockers",
        (true, false) => "No brackets",
        (false, true) => "No shockers",
        _ => null,
    };

    private void OnConfigChanged() => InvokeAsync(StateHasChanged);

    private void ToggleMasterEnabled(bool enabled) => ConfigService.SetEnabled(enabled);

    private void ToggleSectionExpanded(string sectionId)
    {
        if (!ExpandedSections.Remove(sectionId))
            ExpandedSections.Add(sectionId);
    }

    private void ToggleSectionEnabled(CheerSection sec, bool enabled)
    {
        sec.Enabled = enabled;
        ConfigService.UpdateSection(sec);
    }

    private void UpdateSectionName(CheerSection sec, string name)
    {
        sec.Name = name;
        ConfigService.UpdateSection(sec);
    }

    private void UpdateSectionKeyword(CheerSection sec, string keyword)
    {
        sec.Keyword = keyword;
        ConfigService.UpdateSection(sec);
    }

    private void UpdateSectionCommandType(CheerSection sec, string commandType)
    {
        sec.CommandType = commandType;
        ConfigService.UpdateSection(sec);
    }

    private void UpdateSectionWarningVibrate(CheerSection sec, bool enabled)
    {
        sec.WarningVibrate = enabled;
        ConfigService.UpdateSection(sec);
    }

    private void UpdateSectionFixedAmount(CheerSection sec, bool fixedAmount)
    {
        sec.FixedAmount = fixedAmount;
        ConfigService.UpdateSection(sec);
    }

    private void UpdateSectionShockers(CheerSection sec, List<string> ids)
    {
        sec.SelectedShockerIds = ids;
        ConfigService.UpdateSection(sec);
    }

    private void AddNewSection()
    {
        var newSection = new CheerSection
        {
            Name = $"Section {ConfigService.Config.Sections.Count + 1}",
            Keyword = "",
            Enabled = true,
            CommandType = "Vibrate"
        };
        ConfigService.AddSection(newSection);
        ExpandedSections.Add(newSection.Id);
    }

    private void RequestRemoveSection(CheerSection sec)
    {
        if (sec.Brackets.Count > 0 || sec.SelectedShockerIds.Count > 0 || !string.IsNullOrWhiteSpace(sec.Keyword))
        {
            PendingRemoval = sec;
            return;
        }

        RemoveSection(sec);
    }

    private void ConfirmRemoveSection()
    {
        if (PendingRemoval != null) RemoveSection(PendingRemoval);
        PendingRemoval = null;
    }

    private void RemoveSection(CheerSection sec)
    {
        ExpandedSections.Remove(sec.Id);
        ConfigService.RemoveSection(sec.Id);
    }

    private void AddBracketToSection(CheerSection sec)
    {
        var newBracket = new CheerBracket
        {
            BitAmount = 100,
            Intensity = 50,
            Duration = 1.0,
            Mode = SelectionMode.All
        };
        ConfigService.AddBracket(sec.Id, newBracket);
    }

    private void UpdateBracketBitAmount(CheerSection sec, CheerBracket bracket, int bitAmount)
    {
        bracket.BitAmount = bitAmount;
        ConfigService.UpdateBracket(sec.Id, bracket);
    }

    private void UpdateBracketIntensity(CheerSection sec, CheerBracket bracket, int intensity)
    {
        bracket.Intensity = intensity;
        ConfigService.UpdateBracket(sec.Id, bracket);
    }

    private void UpdateBracketDuration(CheerSection sec, CheerBracket bracket, double duration)
    {
        bracket.Duration = duration;
        ConfigService.UpdateBracket(sec.Id, bracket);
    }

    private void UpdateBracketMode(CheerSection sec, CheerBracket bracket, SelectionMode mode)
    {
        bracket.Mode = mode;
        ConfigService.UpdateBracket(sec.Id, bracket);
    }

    private void RemoveBracket(CheerSection sec, CheerBracket bracket)
    {
        ConfigService.RemoveBracket(sec.Id, bracket.Id);
    }

    private void MoveSection(CheerSection sec, int direction)
    {
        ConfigService.MoveSection(sec.Id, direction);
    }

    private void DuplicateSection(CheerSection sec)
    {
        var duplicate = ConfigService.DuplicateSection(sec.Id);
        if (duplicate != null)
        {
            ExpandedSections.Add(duplicate.Id);
        }
    }

    public void Dispose()
    {
        ConfigService.ConfigChanged -= OnConfigChanged;
    }
}
