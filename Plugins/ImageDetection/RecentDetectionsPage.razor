@page "/plugins/com-multishock-imagedetection/recent-detections"
@inject ImageDetectionService DetectionService
@implements IDisposable

<PageHeader Title="Recent detections"
            Icon="history"
            Description="Matches found on screen, newest first, with the action each one sent."
            Breadcrumb="BackToDashboard">
    <Meta>
        @if (IsRunning)
        {
            <span role="status" class="chip chip-ok"><span class="status-dot bg-app-success"></span> Running</span>
        }
        else
        {
            <span role="status" class="chip chip-neutral"><span class="status-dot bg-app-subtle"></span> Stopped</span>
        }
    </Meta>
    <Actions>
        <Button Text="@(IsRunning ? "Stop detection" : "Start detection")"
                Icon="@(IsRunning ? "square" : "play")"
                Variant="@(IsRunning ? "secondary" : "primary")"
                OnClick="ToggleDetection" />
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <Alert Variant="danger" Class="mb-4">
        <ChildContent>@ErrorMessage</ChildContent>
        <Actions>
            <Button Icon="x" Size="icon-sm" Variant="ghost" AriaLabel="Dismiss error" Title="Dismiss error" OnClick="ClearErrorMessage" />
        </Actions>
    </Alert>
}

<div class="max-w-4xl"><RecentDetections /></div>

@code {
    private const string HomeRoute = "plugins/com-multishock-imagedetection/imagedetection";

    private bool IsRunning => DetectionService?.IsRunning ?? false;
    private string? ErrorMessage;

    protected override void OnInitialized()
    {
        DetectionService.RunningStateChanged += OnRunningStateChanged;
        DetectionService.ErrorOccurred += OnError;
    }

    public void Dispose()
    {
        DetectionService.RunningStateChanged -= OnRunningStateChanged;
        DetectionService.ErrorOccurred -= OnError;
    }

    private Task ToggleDetection() => DetectionService.ToggleAsync();

    private RenderFragment BackToDashboard => __builder =>
    {
        <a href="@HomeRoute" class="inline-flex items-center gap-1 rounded-ctl hover:text-app-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary">
            <LucideIcon Name="arrow-left" Size="12" />
            Image detection
        </a>
    };

    private void ClearErrorMessage()
    {
        ErrorMessage = null;
        StateHasChanged();
    }

    private void OnRunningStateChanged(bool _)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnError(string error)
    {
        ErrorMessage = error;
        InvokeAsync(StateHasChanged);
    }
}
