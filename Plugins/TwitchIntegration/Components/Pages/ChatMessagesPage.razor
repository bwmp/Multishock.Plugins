@page "/plugins/com-multishock-twitchintegration/chat-messages"
@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@inject IPluginHost Host
@implements IDisposable

<PageHeader Title="Chat messages" Icon="messages-square" Description="Post a chat message when a reaction fires, or repeat a message on a timer. Changes save automatically.">
    <Breadcrumb><BackLink /></Breadcrumb>
    <Actions>
        <Toggle Label="Enabled" AriaLabel="Enable chat messages" Value="Config.Enabled" ValueChanged="@(enabled => AutoMessages.SetEnabled(enabled))" />
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!Config.Enabled)
    {
        <Alert Variant="neutral">Chat messages are off. You can write messages now; nothing is posted until you switch on Enabled.</Alert>
    }
    else if (!TwitchService.IsConnected)
    {
        <Alert Variant="info">Messages are posted while MultiShock is connected to Twitch.</Alert>
    }

    <Card Title="Repeating message" Description="Posts the same message on a timer while connected.">
        <SettingRow Label="Post on a timer" Description="Turn the repeating message on or off.">
            <Toggle AriaLabel="Post the repeating message on a timer" Value="Config.Repeating.Enabled" ValueChanged="@(enabled => AutoMessages.SetRepeatingEnabled(enabled))" />
        </SettingRow>
        <SettingRow Label="Interval" Description="Whole minutes between messages, from 1 to 1440.">
            <NumberField Label="Repeating message interval" Class="w-28 [&_label]:sr-only" Suffix="min"
                         Value="@(Config.Repeating.IntervalSeconds / 60.0)" Min="@(AutoMessageService.MinIntervalSeconds / 60.0)" Max="@(AutoMessageService.MaxIntervalSeconds / 60.0)"
                         ValueChanged="@(minutes => AutoMessages.SetRepeatingInterval((int)(minutes * 60)))" />
        </SettingRow>
        <div class="mt-3 space-y-3">
            <TextArea Label="Message" Rows="3" Value="@Config.Repeating.Template" ValueChanged="@(v => AutoMessages.SetRepeatingTemplate(v ?? string.Empty))" />
            @PlaceholderHint(RepeatingPlaceholders)
            @MessagePreview(AutoMessages.RenderRepeating())
            <div class="flex items-center justify-end gap-3 border-t border-app-border pt-3">
                @if (SendBlockedReason != null)
                {
                    <span class="text-xs text-app-muted">@SendBlockedReason</span>
                }
                <Button Title="@SendBlockedReason" Text="Send now" Icon="send" Variant="secondary" Size="sm"
                        Disabled="@(SendBlockedReason != null)" Loading="_sendingRepeating" OnClick="SendRepeatingNow" />
            </div>
        </div>
    </Card>

    <Card Title="Reaction messages" Description="Each message is posted only when its reaction runs a shocker action.">
        <div class="divide-y divide-app-border">
            @foreach (var trigger in Triggers)
            {
                var template = Config.Get(trigger.Trigger);
                <section class="space-y-3 py-4 first:pt-0 last:pb-0" aria-label="@trigger.Title">
                    <SettingRow Label="@trigger.Title" Description="@trigger.When">
                        <Toggle AriaLabel="@($"Post a message for {trigger.Title.ToLowerInvariant()}")" Value="template.Enabled" ValueChanged="@(enabled => AutoMessages.SetTriggerEnabled(trigger.Trigger, enabled))" />
                    </SettingRow>
                    <TextInput Placeholder="Message text" aria-label="@($"{trigger.Title} message")" Value="@template.Template" ValueChanged="@(v => AutoMessages.SetTriggerTemplate(trigger.Trigger, v ?? string.Empty))" />
                    @PlaceholderHint(AutoMessageService.GetPlaceholders(trigger.Trigger))
                    @MessagePreview(AutoMessageService.RenderSample(trigger.Trigger, template.Template))
                </section>
            }
        </div>
    </Card>
</div>

@code {
    private static readonly string PluginId = TwitchIntegrationPlugin.PluginId;
    private AutoMessageService AutoMessages => PluginServiceLocator.GetRequiredService<AutoMessageService>(PluginId);
    private TwitchEventSubService TwitchService => PluginServiceLocator.GetRequiredService<TwitchEventSubService>(PluginId);
    private CheerConfigService CheerConfig => PluginServiceLocator.GetRequiredService<CheerConfigService>(PluginId);

    private AutoMessageConfig Config => AutoMessages.Config;

    private static readonly IReadOnlyList<string> RepeatingPlaceholders = ["brackets"];

    private sealed record TriggerInfo(AutoMessageTrigger Trigger, string Title, string When);

    private static readonly TriggerInfo[] Triggers =
    [
        new(AutoMessageTrigger.Cheer, "Cheer bracket", "Sent when a cheer matches a bracket and its action fires."),
        new(AutoMessageTrigger.Redeem, "Channel point redeem", "Sent when a configured channel point reward fires its action."),
        new(AutoMessageTrigger.Subscription, "Subscription", "Sent when a new sub or shared resub fires its tier's action."),
        new(AutoMessageTrigger.GiftSubscription, "Gifted subs", "Sent once per gift, with the number of subs gifted."),
        new(AutoMessageTrigger.Follow, "Follow", "Sent when a first-time follower fires the follow action."),
    ];

    private bool _sendingRepeating;

    private string? SendBlockedReason =>
        !Config.Enabled ? "Switch on Enabled to send."
        : !Config.Repeating.Enabled ? "Turn on Post on a timer to send."
        : !TwitchService.IsConnected ? "Connect to Twitch to send."
        : null;

    protected override void OnInitialized()
    {
        AutoMessages.ConfigChanged += OnChanged;
        CheerConfig.ConfigChanged += OnChanged;
        TwitchService.ConnectionStateChanged += OnConnectionChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnConnectionChanged(bool _) => InvokeAsync(StateHasChanged);

    private async Task SendRepeatingNow()
    {
        _sendingRepeating = true;
        try
        {
            if (await AutoMessages.SendRepeatingNowAsync())
            {
                Host.ShowSuccessToast("Message sent", "The repeating message was posted in chat.");
            }
            else
            {
                Host.ShowErrorToast("Message not sent", "Twitch rejected the message or the connection dropped. Check the event log.");
            }
        }
        finally
        {
            _sendingRepeating = false;
        }
    }

    private static RenderFragment PlaceholderHint(IReadOnlyList<string> names) => __builder =>
    {
        <div class="flex flex-wrap items-center gap-1.5 text-xs text-app-muted">
            <span>Placeholders:</span>
            @foreach (var name in names)
            {
                <code class="rounded bg-app-surface-2 px-1.5 py-0.5 font-mono text-app-text">{@name}</code>
            }
        </div>
    };

    private static RenderFragment MessagePreview(string text) => __builder =>
    {
        <div class="rounded-ctl border border-app-border bg-app-surface-2 px-3 py-2 text-sm">
            <div class="section-label mb-1">Preview</div>
            @if (string.IsNullOrWhiteSpace(text))
            {
                <span class="text-app-subtle">Nothing is posted while the message is empty.</span>
            }
            else
            {
                <span class="break-words text-app-text">@text</span>
            }
        </div>
    };

    public void Dispose()
    {
        AutoMessages.ConfigChanged -= OnChanged;
        CheerConfig.ConfigChanged -= OnChanged;
        TwitchService.ConnectionStateChanged -= OnConnectionChanged;
    }
}
