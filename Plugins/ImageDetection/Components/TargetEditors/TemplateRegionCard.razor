@inject ImageConfigService ConfigService
@inject IScreenCaptureService CaptureService

@* Detection region + image preview for template targets. The visual grid
   selector and region picker modals live in HomeModuleEditor. *@

@{
    var showImagePreview = !string.IsNullOrEmpty(Image.FilePath) && File.Exists(Image.FilePath);
}

<div class="grid grid-cols-1 items-start gap-4 @(showImagePreview ? "2xl:grid-cols-2" : "")">
    <Card Title="Detection region" Description="Where on screen to look for this image.">
        <div class="space-y-4">
            <Select Label="Search area" TValue="RegionType"
                    Value="Image.Region.Type"
                    ValueChanged="OnRegionTypeSelect"
                    Options="RegionTypeOptions" />

            <RegionPickerControls ModuleId="@ModuleId" TargetId="@Image.Id" OnCaptureRequested="OnPickRegion" />

            @if (Image.Region.Type == RegionType.Grid)
            {
                <fieldset>
                    <legend class="mb-2 text-xs font-medium text-app-muted">Sections to search</legend>
                    <div class="inline-block">
                        <div class="grid grid-cols-3 gap-1">
                            @for (var i = 0; i < 9; i++)
                            {
                                var index = i;
                                var isActive = Image.Region.GridSections?.Sections[index] ?? true;
                                <button type="button"
                                        class="h-12 w-16 rounded-ctl border text-xs font-medium transition-colors @(isActive ? "border-app-primary bg-app-primary/15 text-app-text hover:bg-app-primary/25" : "border-app-border bg-app-surface-2 text-app-subtle hover:border-app-border-strong")"
                                        aria-pressed="@(isActive ? "true" : "false")"
                                        aria-label="@($"Section {index + 1}")"
                                        @onclick="@(() => ToggleSection(index))">
                                    @(index + 1) · @(isActive ? "On" : "Off")
                                </button>
                            }
                        </div>
                        <div class="flex gap-2 mt-3">
                            <Button Text="All on" Size="sm" Variant="secondary" OnClick="EnableAllSections" />
                            <Button Text="All off" Size="sm" Variant="secondary" OnClick="DisableAllSections" />
                            <Button Text="Pick on screenshot" Icon="grid-3x3" Size="sm" Variant="secondary" OnClick="OnOpenVisualSelector" />
                        </div>
                    </div>
                </fieldset>
            }

            @if (Image.Region.Type == RegionType.Custom)
            {
                <ManualRegionInputs ModuleId="@ModuleId" Image="Image" />
            }
        </div>
    </Card>
    @if (showImagePreview)
    {
        <Card Title="Image preview">
            <div class="overflow-hidden rounded-ctl border border-app-border bg-app-surface-2">
                <img src="@EditorUi.GetImageDataUri(Image.FilePath)"
                     alt="@Image.Name"
                     class="max-w-full max-h-64 mx-auto object-contain" />
            </div>
            <div class="mt-3 flex flex-col gap-2 text-xs">
                <div class="flex items-center gap-2">
                    <span class="text-app-muted">Captured at</span>
                    <span class="font-mono text-app-text">@Image.CaptureResolution.Width&times;@Image.CaptureResolution.Height</span>
                    @if (IsResolutionMismatch())
                    {
                        <span class="chip chip-warn">Differs from monitor</span>
                    }
                </div>
                @if (IsResolutionMismatch())
                {
                    <Checkbox Label="Resize to match monitor"
                              Description="@($"Scales the image to {GetCurrentMonitorResolution()?.Width}×{GetCurrentMonitorResolution()?.Height} before matching.")"
                              Value="Image.AutoResize" ValueChanged="OnAutoResizeChanged" />
                }
            </div>
        </Card>
    }
</div>

@code {
    [Parameter, EditorRequired] public string ModuleId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public DetectionImage Image { get; set; } = default!;

    /// <summary>Asks the host editor to capture a screenshot and open the region picker.</summary>
    [Parameter] public EventCallback OnPickRegion { get; set; }

    /// <summary>Asks the host editor to open the visual grid-section selector.</summary>
    [Parameter] public EventCallback OnOpenVisualSelector { get; set; }

    private static readonly IEnumerable<Select<RegionType>.SelectOption<RegionType>> RegionTypeOptions =
    [
        new(RegionType.FullScreen, "Full screen"),
        new(RegionType.Grid, "Grid sections"),
        new(RegionType.Custom, "Custom region"),
    ];

    private List<MonitorInfo> _monitors = [];

    protected override void OnInitialized()
    {
        _monitors = CaptureService.GetMonitors();
    }

    private void Save() => ConfigService.UpdateImage(ModuleId, Image);

    private Resolution? GetCurrentMonitorResolution()
        => _monitors.FirstOrDefault(m => m.Index == ConfigService.CaptureConfig.MonitorIndex)?.Resolution;

    private bool IsResolutionMismatch()
    {
        var current = GetCurrentMonitorResolution();
        if (current == null) return false;

        return Image.CaptureResolution.Width != current.Width
            || Image.CaptureResolution.Height != current.Height;
    }

    private void OnRegionTypeSelect(RegionType type)
    {
        Image.Region.Type = type;

        if (type == RegionType.Grid && Image.Region.GridSections == null)
            Image.Region.GridSections = GridSections.All();
        if (type == RegionType.Custom && Image.Region.CustomRegion == null)
        {
            Image.Region.CustomRegion = new ScreenRegion { X = 0, Y = 0, Width = 100, Height = 100 };
            var current = GetCurrentMonitorResolution();
            Image.Region.ReferenceResolution = current == null
                ? null
                : new Resolution(current.Width, current.Height);
        }

        Save();
    }

    private void OnAutoResizeChanged(bool value)
    {
        Image.AutoResize = value;
        Save();
    }

    private void ToggleSection(int index)
    {
        if (Image.Region.GridSections == null) return;
        Image.Region.GridSections.Sections[index] = !Image.Region.GridSections.Sections[index];
        Save();
    }

    private void EnableAllSections()
    {
        Image.Region.GridSections = GridSections.All();
        Save();
    }

    private void DisableAllSections()
    {
        Image.Region.GridSections = GridSections.None();
        Save();
    }
}
