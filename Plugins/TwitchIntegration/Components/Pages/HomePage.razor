@page "/plugins/com-multishock-twitchintegration/twitchintegration"
@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@inject IDeviceActions Actions
@inject IPluginHost Host
@implements IDisposable

@* The host page header carries title, status and primary action, so this page
   uses the same band as every MultiShock screen instead of a bespoke toolbar.
   The Twitch mark stays as identity only. *@
<PageHeader Title="Twitch Integration"
            Description="React to cheers, subscriptions, follows, hype trains and channel point redeems from a flow.">
    <Meta>
        @if (TwitchService.IsConnected)
        {
            <span class="chip chip-ok"><span class="status-dot bg-app-success"></span> Connected</span>
            <span class="text-xs text-app-subtle">@TwitchService.CurrentUserName</span>
        }
        else if (TwitchService.IsConnecting || IsAuthenticating)
        {
            <span class="chip chip-warn">
                <span class="status-dot bg-app-warning"></span>
                @(IsAuthenticating ? "Waiting for login" : "Connecting")
            </span>
        }
        else
        {
            <span class="chip chip-neutral"><span class="status-dot bg-app-subtle"></span> Disconnected</span>
        }
    </Meta>
    <Actions>
        @if (TwitchService.IsConnected)
        {
            <Button Variant="secondary" Icon="log-out" Text="Disconnect" OnClick="Disconnect" />
        }
        else if (CanConnectWithoutLogin)
        {
            <Button Variant="primary" Icon="plug" Text="Connect"
                    Disabled="@(IsAuthenticating || TwitchService.IsConnecting)"
                    OnClick="ConnectWithSavedToken" />
        }
        else
        {
            <Button Variant="primary" Icon="log-in" Text="Sign in with Twitch"
                    Disabled="@(IsAuthenticating || TwitchService.IsConnecting)"
                    OnClick="LoginWithTwitch" />
        }
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">

    <div class="space-y-4">
        <div class="twitch-card" data-guided-setup="twitch-home-connection">
            <div class="twitch-card-header">
                <span>Connection</span>
                @if (IsAuthenticating)
                {
                    <Button Text="Cancel" Variant="secondary" Size="sm" OnClick="CancelLogin" />
                }
            </div>
            <div class="twitch-card-body">
                @if (!TwitchService.IsConnected)
                {
                    <div class="flex flex-col items-center gap-4 py-4">
                        @if (CanConnectWithoutLogin)
                        {
                            <div data-guided-setup="twitch-home-login-button">
                                <Button Disabled="@(TwitchService.IsConnecting)" OnClick="ConnectWithSavedToken"
                                    Variant="none"
                                    Class="bg-[#9146FF]! hover:bg-[#772ce8]!">
                                    <LucideIcon Name="twitch" Class="w-5 h-5" />
                                    @if (TwitchService.IsConnecting)
                                    {
                                        <span>Connecting...</span>
                                    }
                                    else
                                    {
                                        <span>Connect</span>
                                    }
                                </Button>
                            </div>
                        }
                        else
                        {
                            <div data-guided-setup="twitch-home-login-button">
                                <Button Disabled="@(IsAuthenticating || TwitchService.IsConnecting)" OnClick="LoginWithTwitch"
                                    Variant="none"
                                    Class="bg-[#9146FF]! hover:bg-[#772ce8]!">
                                    <LucideIcon Name="twitch" Class="w-5 h-5" />
                                    @if (IsAuthenticating)
                                    {
                                        <span>Waiting for login...</span>
                                    }
                                    else if (TwitchService.IsConnecting)
                                    {
                                        <span>Connecting...</span>
                                    }
                                    else
                                    {
                                        <span>Login with Twitch</span>
                                    }
                                </Button>
                            </div>
                        }

                        <div class="flex flex-col gap-2" data-guided-setup="twitch-home-auto-connect">
                            <Toggle Label="Auto-connect on app startup" Value="AutoConnectEnabled"
                                ValueChanged="@((enabled) => ToggleAutoConnect(enabled))" />

                            <Toggle Label="Use local Twitch CLI (testing)" Value="UseLocalCliEnabled"
                                ValueChanged="@((enabled) => ToggleLocalCli(enabled))" />

                            @if (UseLocalCliEnabled)
                            {
                                <TextInput Label="Twitch CLI WebSocket URL" Value="@LocalCliUrl"
                                    Placeholder="@TwitchConstants.DefaultLocalCliUrl"
                                    Description="No Twitch login is needed while using the local CLI."
                                    Error="@LocalCliUrlError"
                                    ValueChanged="@((value) => UpdateLocalCliUrl(value))" />
                            }
                        </div>

                        @if (IsAuthenticating && !string.IsNullOrEmpty(AuthService.PendingUserCode))
                        {
                            <div class="flex flex-col items-center gap-1 text-center">
                                <p class="text-sm text-app-muted">Approve MultiShock on Twitch with this code:</p>
                                <span class="font-mono text-2xl font-semibold tracking-widest">@AuthService.PendingUserCode</span>
                                <a class="text-sm text-app-primary" href="@AuthService.PendingVerificationUri" target="_blank">
                                    Open the Twitch activation page
                                </a>
                            </div>
                        }
                        else if (AuthService.LoginExpired)
                        {
                            <p class="text-sm text-app-warning">Your Twitch login expired. Log in again to keep receiving events.</p>
                        }
                        else if (!string.IsNullOrEmpty(AuthStatus))
                        {
                            <p class="text-sm text-app-muted">@AuthStatus</p>
                        }
                    </div>
                    <details class="mt-4 pt-4 border-t border-app-border">
                        <summary class="text-sm cursor-pointer text-app-muted">
                            Or enter token manually
                        </summary>
                        <div class="mt-4 space-y-3">
                            <div class="flex gap-2">
                                <TextInput InputType="password" Placeholder="Enter your Twitch OAuth token" Value="@OAuthToken"
                                    ValueChanged="@((value) => OAuthToken = value ?? "")" Class="flex-1" />
                                <Button Text="Connect" Variant="primary"
                                    Disabled="@(string.IsNullOrWhiteSpace(OAuthToken) || TwitchService.IsConnecting)"
                                    OnClick="Connect" />
                                <Button Text="Clear" Variant="secondary" Disabled="@(string.IsNullOrWhiteSpace(OAuthToken))"
                                    OnClick="ClearToken" />
                            </div>
                            <p class="text-xs text-app-muted">
                                Get your token from
                                <a class="text-app-primary" href="https://twitchtokengenerator.com/" target="_blank">
                                    TwitchTokenGenerator.com
                                </a>
                            </p>
                        </div>
                    </details>
                }
                else
                {
                    <div class="flex flex-col gap-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="twitch-status twitch-status-connected">
                                    <span class="twitch-status-dot"></span>
                                    Connected as <strong>@TwitchService.CurrentUserName</strong>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <Button Text="Disconnect" Variant="secondary" OnClick="Disconnect" />
                                <Button Text="Logout" Variant="secondary" OnClick="LogoutAsync" />
                            </div>
                        </div>

                        <div class="flex flex-col gap-2" data-guided-setup="twitch-home-auto-connect">
                            <Toggle Label="Auto-connect on app startup" Value="AutoConnectEnabled"
                                ValueChanged="@((enabled) => ToggleAutoConnect(enabled))" />

                            <Toggle Label="Use local Twitch CLI (testing)" Value="UseLocalCliEnabled"
                                ValueChanged="@((enabled) => ToggleLocalCli(enabled))" />

                            @if (UseLocalCliEnabled)
                            {
                                <TextInput Label="Twitch CLI WebSocket URL" Value="@LocalCliUrl"
                                    Placeholder="@TwitchConstants.DefaultLocalCliUrl"
                                    Description="No Twitch login is needed while using the local CLI."
                                    Error="@LocalCliUrlError"
                                    ValueChanged="@((value) => UpdateLocalCliUrl(value))" />
                            }
                        </div>
                    </div>
                }

                <details class="mt-4 pt-4 border-t border-app-border">
                    <summary class="text-sm cursor-pointer text-app-muted">
                        Required OAuth Scopes
                    </summary>
                    <div class="mt-2 flex flex-wrap gap-2">
                        @foreach (var scope in TwitchConstants.RequiredScopes)
                        {
                            <span class="twitch-badge font-mono">@scope</span>
                        }
                    </div>
                </details>
            </div>
        </div>

        <div class="twitch-card">
            <div class="twitch-card-header">
                <span>Setup Path</span>
            </div>
            <div class="twitch-card-body space-y-3">
                <p class="text-sm text-app-muted">
                    Use these shortcuts when you are walking through first-time setup for cheers and subscriptions.
                </p>
                <div class="flex flex-wrap gap-2">
                    <Button Text="Start Guided Setup" Variant="primary"
                        OnClick="@(() => Host.StartPluginGuidedSetup(TwitchIntegrationPlugin.PluginId))" />
                    <a href="/plugins/com-multishock-twitchintegration/cheer-config"
                        class="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm font-medium transition-colors border-app-border text-app-text bg-app-surface"
                        data-guided-setup="twitch-home-open-cheers">
                        <LucideIcon Name="coins" Size="16" />
                        <span>Open Bits/Cheers</span>
                    </a>
                    <a href="/plugins/com-multishock-twitchintegration/sub-config"
                        class="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm font-medium transition-colors border-app-border text-app-text bg-app-surface">
                        <LucideIcon Name="user-plus" Size="16" />
                        <span>Open Subs / Gifted Subs</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="twitch-card">
            <div class="twitch-card-header">
                <span>Legacy Import</span>
            </div>
            <div class="twitch-card-body space-y-3">
                <p class="text-sm text-app-muted">
                    Import Twitch cheer, redeem, sub, hype train, and follow settings from the legacy MultiShock
                    `config.json` format.
                </p>
                <div class="flex flex-wrap items-end gap-2">
                    <div class="grow min-w-[20rem]">
                        <TextInput Label="Legacy config path" Value="@LegacyConfigPath"
                            ValueChanged="@((value) => LegacyConfigPath = value ?? string.Empty)" />
                    </div>
                    <Button Text="Import" Variant="primary" Disabled="@IsImportingLegacyConfig"
                        OnClick="ImportLegacyConfigAsync">
                        @if (IsImportingLegacyConfig)
                        {
                            <span>Importing...</span>
                        }
                        else
                        {
                            <span>Import</span>
                        }
                    </Button>
                </div>

                @if (!string.IsNullOrEmpty(LegacyImportMessage))
                {
                    <div class="text-sm px-4 py-3 rounded"
                        style="background: @(LegacyImportSuccess ? "rgba(74, 158, 255, 0.1)" : "rgba(220, 38, 38, 0.1)"); color: @(LegacyImportSuccess ? "rgb(var(--ms-primary-rgb))" : "rgb(var(--ms-danger-rgb))");">
                        <div>@LegacyImportMessage</div>
                        @if (!string.IsNullOrWhiteSpace(LegacyImportDetails))
                        {
                            <pre class="mt-2 text-xs whitespace-pre-wrap" style="color: inherit;">@LegacyImportDetails</pre>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="twitch-card" style="border-color: rgb(var(--ms-danger-rgb));">
                <div class="twitch-card-body">
                    <div class="flex items-center gap-2" style="color: rgb(var(--ms-danger-rgb));">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>@ErrorMessage</span>
                    </div>
                </div>
            </div>
        }

        <TwitchIntegration.Components.EventLog />

        <TwitchIntegration.Components.PerformancePanel />

        <div class="twitch-card">
            <div class="twitch-card-header">
                <span>Available Flow Triggers</span>
            </div>
            <div class="twitch-card-body">
                <div class="grid gap-2 text-sm">
                    @foreach (var trigger in FlowTriggers)
                    {
                        <div class="flex items-center gap-2">
                            <span class="twitch-status-dot bg-app-primary"></span>
                            <span><strong class="text-app-text">@trigger.Name</strong></span>
                            <span class="text-app-muted">- @trigger.Description</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Use service locator instead of @inject for plugin-specific services
    // This survives hot-reload where the DI container has stale types
    private static readonly string PluginId = TwitchIntegrationPlugin.PluginId;
    private TwitchEventSubService TwitchService => PluginServiceLocator.GetRequiredService<TwitchEventSubService>(PluginId);
    private TwitchAuthService AuthService => PluginServiceLocator.GetRequiredService<TwitchAuthService>(PluginId);
    private LegacyTwitchImportService LegacyImportService => PluginServiceLocator.GetRequiredService<LegacyTwitchImportService>(PluginId);
    
    private string OAuthToken = "";
    private string? ErrorMessage;
    private string? AuthStatus;
    private bool IsAuthenticating;
    private bool AutoConnectEnabled;
    private bool UseLocalCliEnabled;
    private string LocalCliUrl = string.Empty;
    private string? LocalCliUrlError;
    private bool IsImportingLegacyConfig;
    private bool LegacyImportSuccess;
    private string LegacyConfigPath = string.Empty;
    private string? LegacyImportMessage;
    private string? LegacyImportDetails;

    private EventLogService EventLogService => PluginServiceLocator.GetRequiredService<EventLogService>(PluginId);

    private static readonly (string Name, string Description)[] FlowTriggers =
    [
    ("Twitch Cheer", "Triggers when someone cheers bits"),
("Twitch Subscribe", "Triggers on new subscriptions"),
("Twitch Gift Subs", "Triggers when someone gifts subs"),
("Twitch Resub", "Triggers on resubscription messages"),
("Twitch Follow", "Triggers when someone follows"),
("Hype Train Start/Progress/End", "Hype train events"),
("Twitch Raid", "Triggers when someone raids"),
("Channel Point Redemption", "Triggers on point redeems")
    ];

    protected override void OnInitialized()
    {
        TwitchService.ConnectionStateChanged += OnConnectionStateChanged;
        TwitchService.ErrorOccurred += OnError;
        AuthService.StatusChanged += OnAuthStatusChanged;

        OAuthToken = AuthService.StoredToken ?? "";
        AutoConnectEnabled = AuthService.AutoConnect;
        UseLocalCliEnabled = AuthService.UseLocalCli;
        LocalCliUrl = AuthService.LocalCliUrl;
        LegacyConfigPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "MultiShock", "config.json");
    }

    private async Task ImportLegacyConfigAsync()
    {
        IsImportingLegacyConfig = true;
        LegacyImportMessage = null;
        LegacyImportDetails = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await LegacyImportService.ImportAsync(LegacyConfigPath);
            LegacyImportSuccess = result.Success;
            LegacyImportMessage = result.Message;
            LegacyImportDetails = result.Details;
            EventLogService.AddLog(result.Success ? "Legacy Twitch config imported" : $"Legacy import failed: {result.Message}", !result.Success);
        }
        catch (Exception ex)
        {
            LegacyImportSuccess = false;
            LegacyImportMessage = $"Legacy import failed: {ex.Message}";
            LegacyImportDetails = null;
            EventLogService.AddLog(LegacyImportMessage, true);
        }
        finally
        {
            IsImportingLegacyConfig = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoginWithTwitch()
    {
        IsAuthenticating = true;
        AuthStatus = null;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            EventLogService.AddLog("Starting Twitch login...");
            var token = await AuthService.AuthenticateAsync();

            if (!string.IsNullOrEmpty(token))
            {
                EventLogService.AddLog("Login successful, connecting to EventSub...");
                OAuthToken = token;
                await TwitchService.ConnectAsync();
            }
            else
            {
                EventLogService.AddLog("Login was cancelled or failed", isError: true);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Login failed: {ex.Message}";
            EventLogService.AddLog($"Login error: {ex.Message}", isError: true);
        }
        finally
        {
            IsAuthenticating = false;
            AuthStatus = null;
            StateHasChanged();
        }
    }

    private void CancelLogin()
    {
        AuthService.CancelAuthentication();
        IsAuthenticating = false;
        AuthStatus = null;
        EventLogService.AddLog("Login cancelled");
        StateHasChanged();
    }

    private void OnAuthStatusChanged(string status)
    {
        InvokeAsync(() =>
        {
            AuthStatus = status;
            EventLogService.AddLog(status);
            StateHasChanged();
        });
    }

    private async Task Connect()
    {
        ErrorMessage = null;
        EventLogService.AddLog("Connecting to Twitch...");

        var token = OAuthToken.Trim();
        // The field is prefilled with the stored login; saving it as a manual token would drop its refresh token.
        var isStoredLogin = token == AuthService.StoredToken;
        var success = await TwitchService.ConnectAsync(isStoredLogin ? null : token);
        if (!success)
        {
            EventLogService.AddLog("Connection failed", isError: true);
            
            // Check if it's a scope issue
            if (ErrorMessage?.Contains("scope", StringComparison.OrdinalIgnoreCase) == true)
            {
                EventLogService.AddLog("Detected missing scopes, clearing token and re-authenticating...");
                await LogoutAsync();
                await Task.Delay(500); // Brief delay to ensure UI updates
                await LoginWithTwitch();
            }
        }
        else if (!isStoredLogin && !string.IsNullOrWhiteSpace(token))
        {
            AuthService.SaveAuthToken(token);
        }
    }

    private async Task Disconnect()
    {
        await TwitchService.DisconnectAsync();
        EventLogService.AddLog("Disconnected");
    }

    private bool CanConnectWithoutLogin => UseLocalCliEnabled || !string.IsNullOrWhiteSpace(AuthService.StoredToken);

    private async Task ConnectWithSavedToken()
    {
        if (!CanConnectWithoutLogin) return;

        ErrorMessage = null;
        EventLogService.AddLog(UseLocalCliEnabled ? "Connecting to local Twitch CLI..." : "Connecting with saved token...");

        var success = await TwitchService.ConnectAsync();
        if (!success)
        {
            EventLogService.AddLog("Connection failed", isError: true);
            
            // Check if it's a scope issue
            if (ErrorMessage?.Contains("scope", StringComparison.OrdinalIgnoreCase) == true)
            {
                EventLogService.AddLog("Detected missing scopes, clearing token and re-authenticating...");
                await LogoutAsync();
                await Task.Delay(500); // Brief delay to ensure UI updates
                await LoginWithTwitch();
            }
        }
    }

    private void OnConnectionStateChanged(bool connected)
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    private void OnError(string error)
    {
        InvokeAsync(() =>
        {
            ErrorMessage = error;
            StateHasChanged();
        });
    }

    private void ToggleAutoConnect(bool enabled)
    {
        AutoConnectEnabled = enabled;
        AuthService.AutoConnect = enabled;
        EventLogService.AddLog(enabled ? "Auto-connect enabled" : "Auto-connect disabled");
    }

    private void ToggleLocalCli(bool enabled)
    {
        UseLocalCliEnabled = enabled;
        AuthService.UseLocalCli = enabled;
        var target = enabled ? "local CLI" : "production";
        EventLogService.AddLog($"WebSocket target set to {target}");
        
        if (TwitchService.IsConnected)
        {
            EventLogService.AddLog("Note: Reconnect for the change to take effect");
        }
    }

    private void UpdateLocalCliUrl(string? value)
    {
        LocalCliUrl = value?.Trim() ?? string.Empty;
        if (!TwitchAuthService.IsValidLocalCliUrl(LocalCliUrl))
        {
            LocalCliUrlError = "Enter a ws:// or wss:// URL, e.g. " + TwitchConstants.DefaultLocalCliUrl;
            return;
        }

        LocalCliUrlError = null;
        AuthService.LocalCliUrl = LocalCliUrl;
    }

    private async Task LogoutAsync()
    {
        await TwitchService.DisconnectAsync();
        AuthService.ClearAuth();
        OAuthToken = "";
        AutoConnectEnabled = false;
        EventLogService.AddLog("Logged out and cleared saved token");
        StateHasChanged();
    }

    private void ClearToken()
    {
        AuthService.ClearAuth();
        OAuthToken = "";
        EventLogService.AddLog("Token cleared from config");
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthService.StatusChanged -= OnAuthStatusChanged;
        TwitchService.ConnectionStateChanged -= OnConnectionStateChanged;
        TwitchService.ErrorOccurred -= OnError;
    }
}
