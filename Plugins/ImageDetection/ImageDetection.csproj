<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.22621.0</TargetFramework>
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFramework>
        <!-- Plugin still runs on Windows 10 1809+; WGC availability is checked at runtime. -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">18.0</SupportedOSPlatformVersion>
        <UseRidGraph>true</UseRidGraph>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <UseWindowsForms>false</UseWindowsForms>
        
        <AssemblyName>ImageDetection</AssemblyName>
        <RootNamespace>ImageDetection</RootNamespace>
        
        <RazorLangVersion>Latest</RazorLangVersion>
        <PluginBuildStamp>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</PluginBuildStamp>
        <PluginVersion>1.3.0</PluginVersion> <!-- x-release-please-version -->
        <Version>$(PluginVersion)</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

        <!-- Copy all NuGet dependency DLLs to output so the .msplugin package can include them -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- Release optimizations -->
    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <!-- Dependencies -->
    <ItemGroup>
        <PackageReference Include="Emgu.CV" Version="4.12.0.5764" />
        <PackageReference Include="Emgu.CV.runtime.windows" Version="4.12.0.5764" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
        <PackageReference Include="Emgu.CV.runtime.maui.mini.macos" Version="4.12.0.5764" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
        <PackageReference Include="Emgu.CV.runtime.ubuntu-x64" Version="4.12.0.5764" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''" />
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="9.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
        <!-- Coordinated development against the sibling SDK. Restore the PackageReference
             below once the matching SDK version is published. -->
        <!-- <PackageReference Include="PiShock.MultiShock.PluginSdk" Version="1.13.0" /> -->
        <ProjectReference Include="..\..\..\PluginSdk\PluginSdk.csproj" Private="false" ExcludeAssets="runtime" />
    </ItemGroup>

    <!-- Version with a build stamp for local builds and stable metadata for releases -->
    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <InformationalVersion>$(PluginVersion)+$(PluginBuildStamp)</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <InformationalVersion>$(PluginVersion)</InformationalVersion>
    </PropertyGroup>

    <!-- Exclude generated file from default compilation -->
    <ItemGroup>
        <Compile Remove="Generated\BuildStamp.g.cs" />
    </ItemGroup>

    <!-- Generate build stamp for runtime version display -->
    <Target Name="GenerateBuildStamp" BeforeTargets="BeforeCompile">
        <MakeDir Directories="$(MSBuildProjectDirectory)\Generated" />
        <PropertyGroup>
            <VersionOutput Condition="'$(Configuration)'=='Debug'">$(PluginVersion)+$(PluginBuildStamp)</VersionOutput>
            <VersionOutput Condition="'$(Configuration)'=='Release'">$(PluginVersion)</VersionOutput>
        </PropertyGroup>
        <ItemGroup>
        <StampLines Include="namespace ImageDetection%3B" />
        <StampLines Include=" " />
        <StampLines Include="public static class BuildStamp" />
        <StampLines Include="{" />
        <StampLines Include="    public const string Stamp = &quot;$(PluginBuildStamp)&quot;%3B" />
        <StampLines Include="    public const string Version = &quot;$(VersionOutput)&quot;%3B" />
        <StampLines Include="}" />
        </ItemGroup>
        <WriteLinesToFile File="$(MSBuildProjectDirectory)\Generated\BuildStamp.g.cs" Lines="@(StampLines)" Overwrite="true" />
        <ItemGroup>
        <Compile Include="Generated\BuildStamp.g.cs" />
        </ItemGroup>
    </Target>

    <!-- 
        Build .msplugin package: zip containing the plugin DLL, managed dependencies,
        native libraries (in runtimes/ layout), and a plugin.json manifest.
        This replaces the old Costura.Fody single-file approach.
    -->
    <Target Name="PackPluginPackage" AfterTargets="Build" Condition="'$(SkipPluginPackaging)' != 'true'">
        <PropertyGroup>
            <LocalPluginDir Condition="$([MSBuild]::IsOSPlatform('windows'))">$(LOCALAPPDATA)\PiShock\MultiShock\Plugins</LocalPluginDir>
            <LocalPluginDir Condition="$([MSBuild]::IsOSPlatform('osx'))">$(HOME)/Library/Application Support/PiShock/MultiShock/Plugins</LocalPluginDir>
            <LocalPluginDir Condition="$([MSBuild]::IsOSPlatform('linux'))">$(HOME)/.local/share/PiShock/MultiShock/Plugins</LocalPluginDir>
            <PluginStagingDir>$(IntermediateOutputPath)msplugin-staging</PluginStagingDir>
            <PluginPackagePath>$(LocalPluginDir)\$(AssemblyName).msplugin</PluginPackagePath>
            <PluginManifestPath>$(MSBuildProjectDirectory)\plugin.json</PluginManifestPath>
            <PluginManifestPath Condition="$([MSBuild]::IsOSPlatform('osx'))">$(MSBuildProjectDirectory)\plugin.macos.json</PluginManifestPath>
            <PluginManifestPath Condition="$([MSBuild]::IsOSPlatform('linux'))">$(MSBuildProjectDirectory)\plugin.linux.json</PluginManifestPath>
        </PropertyGroup>

        <!-- Clean staging directory -->
        <RemoveDir Directories="$(PluginStagingDir)" />
        <MakeDir Directories="$(PluginStagingDir)" />
        <MakeDir Directories="$(LocalPluginDir)" />

        <!-- Copy plugin.json manifest -->
        <Copy SourceFiles="$(PluginManifestPath)" DestinationFiles="$(PluginStagingDir)\plugin.json" />

        <!-- Copy main plugin DLL and PDB -->
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginStagingDir)" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginStagingDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(PluginStagingDir)" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />

        <!-- Copy managed dependencies (all DLLs from output except the SDK and framework assemblies) -->
        <ItemGroup>
            <ManagedDeps Include="$(TargetDir)*.dll"
                         Exclude="$(TargetPath);$(TargetDir)MultiShock.PluginSdk.dll;$(TargetDir)PiShock.MultiShock.PluginSdk.dll;$(TargetDir)Microsoft.*.dll;$(TargetDir)System.*.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(ManagedDeps)" DestinationFolder="$(PluginStagingDir)" />

        <!-- Keep WinRT projection assembly required for Windows OCR -->
        <ItemGroup>
            <WinSdkManaged Include="$(TargetDir)Microsoft.Windows.SDK.NET.dll" Condition="Exists('$(TargetDir)Microsoft.Windows.SDK.NET.dll')" />
        </ItemGroup>
        <Copy SourceFiles="@(WinSdkManaged)" DestinationFolder="$(PluginStagingDir)" SkipUnchangedFiles="true" />

        <!-- Stage native libraries in NuGet runtimes/ layout -->
        <MakeDir Directories="$(PluginStagingDir)\runtimes\win-x64\native" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
        <ItemGroup>
            <NativeLibs Include="$(NuGetPackageRoot)emgu.cv.runtime.windows\4.12.0.5764\runtimes\win-x64\native\cvextern.dll" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
            <NativeLibs Include="$(NuGetPackageRoot)emgu.cv.runtime.windows\4.12.0.5764\runtimes\win-x64\native\libusb-1.0.dll" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
            <NativeLibs Include="$(NuGetPackageRoot)emgu.cv.runtime.windows\4.12.0.5764\runtimes\win-x64\native\opencv_videoio_ffmpeg4120_64.dll" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
        </ItemGroup>
        <Copy SourceFiles="@(NativeLibs)" DestinationFolder="$(PluginStagingDir)\runtimes\win-x64\native" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />

        <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
            <RuntimeNativeLibs Include="$(TargetDir)runtimes\**\native\*" />
        </ItemGroup>
        <Copy SourceFiles="@(RuntimeNativeLibs)"
              DestinationFiles="@(RuntimeNativeLibs->'$(PluginStagingDir)\runtimes\%(RecursiveDir)native\%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"
              Condition="'@(RuntimeNativeLibs)' != ''" />

        <!-- Remove old package if exists, then create the .msplugin zip -->
        <Delete Files="$(PluginPackagePath)" Condition="Exists('$(PluginPackagePath)')" />
        <ZipDirectory SourceDirectory="$(PluginStagingDir)" DestinationFile="$(PluginPackagePath)" Overwrite="true" />

        <!-- Also remove any old single-file DLL from plugins dir to avoid double-loading -->
        <Delete Files="$(LocalPluginDir)\$(AssemblyName).dll" Condition="Exists('$(LocalPluginDir)\$(AssemblyName).dll')" />

        <Message Importance="High" Text="Created plugin package: $(PluginPackagePath)" />
    </Target>
</Project>
