@implements IDisposable

<div class="space-y-3">
    <div class="flex flex-wrap items-center gap-2">
        <ConnectionChip Connected="Connection.IsConnected" Connecting="Connection.IsConnecting"
                        WaitingForLive="Connection.IsWaitingForLive" />
        @if (Connection.IsConnected && !string.IsNullOrEmpty(Connection.ConnectedUsername))
        {
            <span class="text-sm text-app-muted">@@@Connection.ConnectedUsername</span>
        }
    </div>
    <p class="text-sm text-app-muted">Set up the connection and reactions on the TikTok Live page.</p>
    <NavButton Href="/plugins/com-multishock-tiktokintegration/tiktokintegration" Text="Open TikTok Live page" />
</div>

@code {
    private static readonly string OwnPluginId = TikTokIntegrationPlugin.PluginId;
    private TikTokConnectionService Connection => PluginServiceLocator.GetRequiredService<TikTokConnectionService>(OwnPluginId);

    [Parameter]
    public string? PluginId { get; set; }

    protected override void OnInitialized()
    {
        Connection.ConnectionStateChanged += OnConnectionChanged;
    }

    private void OnConnectionChanged(bool connected) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connection.ConnectionStateChanged -= OnConnectionChanged;
    }
}
