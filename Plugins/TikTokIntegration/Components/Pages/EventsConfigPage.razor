@page "/plugins/com-multishock-tiktokintegration/events-config"
@implements IDisposable

<PageHeader Title="Follows, shares and subs" Icon="user-plus"
            Description="Run a shocker action for follows, shares, subscriptions, viewer joins and likes. Each reaction runs only while its switch is on; you can set it up first. Changes save automatically.">
    <Breadcrumb><BackLink /></Breadcrumb>
</PageHeader>

<div class="max-w-4xl space-y-4">
    <Card Title="Event reactions">
        <div class="divide-y divide-app-border">
            <EventReactionRow Title="New follower" Icon="user-plus" Config="Service.Config.Follow"
                              Description="The first time each viewer follows during a stream." OnChanged="Save" />
            <EventReactionRow Title="Stream shared" Icon="share-2" Config="Service.Config.Share"
                              Description="When a viewer shares the live stream." OnChanged="Save" />
            <EventReactionRow Title="New subscriber" Icon="star" Config="Service.Config.Subscribe"
                              Description="When a viewer subscribes to you." OnChanged="Save" />
            <EventReactionRow Title="Viewer joined" Icon="log-in" Config="Service.Config.Join"
                              Description="When a viewer joins the room. This can fire very often on busy streams." OnChanged="Save" />
            <EventReactionRow Title="Likes" Icon="heart" Config="Service.Config.Likes"
                              Description="TikTok sends likes in batches, so this fires once each time the total passes another threshold."
                              OnChanged="Save">
                <NumberField Label="Fire every" Suffix="likes" Min="1" Max="100000"
                             Value="Service.Config.Likes.EveryNLikes" ValueChanged="UpdateLikeThreshold" />
            </EventReactionRow>
        </div>
    </Card>
</div>

@code {
    private static readonly string PluginId = TikTokIntegrationPlugin.PluginId;
    private EventsConfigService Service => PluginServiceLocator.GetRequiredService<EventsConfigService>(PluginId);

    protected override void OnInitialized()
    {
        Service.ConfigChanged += OnConfigChanged;
    }

    private void OnConfigChanged() => InvokeAsync(StateHasChanged);

    private void Save() => Service.SaveConfig();

    private void UpdateLikeThreshold(double value)
    {
        Service.Config.Likes.EveryNLikes = (int)Math.Clamp(Math.Round(value), 1, 100000);
        Service.SaveConfig();
    }

    public void Dispose()
    {
        Service.ConfigChanged -= OnConfigChanged;
    }
}
