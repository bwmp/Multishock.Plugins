@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@using VRChatOSC.Services
@implements IDisposable

<div class="max-w-4xl space-y-4">
<fieldset disabled="@IsSaving" class="space-y-4">
<Card Title="Connection">
    <SettingRow Label="OSC enabled" Description="Allow OSC listening and sending. Turning this off stops OSC after saving; turning it on makes Start available."><Toggle AriaLabel="OSC enabled" Value="Enabled" ValueChanged="@(value => Enabled = value)" /></SettingRow>
    <SettingRow Label="Auto-start connection on app startup" Description="Startup policy only. Turning this off does not stop a manually started listener."><Toggle AriaLabel="Auto-start connection on app startup"
            Value="AutoStart"
            ValueChanged="ToggleAutoStart" /></SettingRow>

    <SettingRow Label="VRChat host" Description="Destination computer used when no preferred endpoint is discovered."><TextInput Class="[&_label]:sr-only" Label="VRChat host"
               Placeholder="127.0.0.1"
               Value="@RemoteHost"
               ValueChanged="@(value => RemoteHost = value?.Trim() ?? string.Empty)" /></SettingRow>
    <SettingRow Label="VRChat port (send target)" Description="UDP port where VRChat receives outgoing OSC messages."><NumberInput Class="[&_label]:sr-only" Label="VRChat port (send target)"
                     Value="SendPort"
                     Min="1"
                     Max="65535"
                     Step="1"
                     ValueChanged="@(value => SendPort = value)" Error="@SendPortError" /></SettingRow>
    <SettingRow Label="Use any available local receive port" Description="Let the operating system choose a free listening port."><Toggle AriaLabel="Use any available local receive port"
            Value="UseAnyAvailablePort"
            ValueChanged="ToggleUseAnyAvailablePort" /></SettingRow>
    <SettingRow Label="Local bind host" Description="Local interface to listen on; use any to listen on all interfaces."><TextInput Class="[&_label]:sr-only" Label="Local bind host"
               Placeholder="127.0.0.1 or any"
               Value="@ReceiveBindHost"
               ValueChanged="@(value => ReceiveBindHost = value?.Trim() ?? string.Empty)" /></SettingRow>
@if (!UseAnyAvailablePort) {
    <SettingRow Label="Local receive port" Description="UDP port for incoming OSC messages when a free port is not selected."><NumberInput Class="[&_label]:sr-only" Label="Local receive port"
                         Value="ReceivePort"
                         Min="1"
                         Max="65535"
                         Step="1"
                         ValueChanged="@(value => ReceivePort = value)" Error="@ReceivePortError" /></SettingRow>
}
</Card>
<Card Title="OSCQuery">
    <SettingRow Label="Enable OSCQuery advertisement and discovery" Description="Advertise this listener and discover VRChat on the local network."><Toggle AriaLabel="Enable OSCQuery advertisement and discovery"
            Value="OscQueryEnabled"
            ValueChanged="ToggleOscQueryEnabled" /></SettingRow>
    <SettingRow Label="Prefer OSCQuery discovered VRChat endpoint" Description="Use a discovered VRChat destination instead of the configured host and port."><Toggle AriaLabel="Prefer OSCQuery discovered VRChat endpoint"
            Value="PreferOscQueryDiscoveredEndpoint"
            ValueChanged="TogglePreferOscQueryEndpoint" /></SettingRow>
    <SettingRow Label="OSCQuery client name" Description="Match the advertised VRChat client name during discovery."><TextInput Class="[&_label]:sr-only" Label="OSCQuery client name"
               Placeholder="VRChat-Client"
               Value="@OscQueryClientName"
               ValueChanged="@(value => OscQueryClientName = value?.Trim() ?? string.Empty)" /></SettingRow>
    <SettingRow Label="OSCQuery refresh interval" Description="How often to refresh discovered endpoints."><NumberInput Class="[&_label]:sr-only" Label="OSCQuery refresh interval"
                     Value="OscQueryRefreshIntervalMs"
                     Min="500"
                     Max="30000"
                     Step="100"
                     ValueChanged="@(value => OscQueryRefreshIntervalMs = value)" Error="@OscQueryRefreshIntervalMsError" Suffix="ms" /></SettingRow>
</Card>

<details class="panel group/advanced">
<summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-panel px-4 py-3 [&::-webkit-details-marker]:hidden">
    <span class="min-w-0"><span class="panel-title block">Advanced</span><span class="panel-desc block">Tune connection recovery and incoming message size.</span></span>
    <LucideIcon Name="chevron-right" Size="16" Class="shrink-0 text-app-muted transition-transform group-open/advanced:rotate-90" />
</summary>
<div class="border-t border-app-border p-4">
    <SettingRow Label="Reconnect delay" Description="Wait this long before retrying a failed connection."><NumberInput Class="[&_label]:sr-only" Label="Reconnect delay"
                     Value="ReconnectDelayMs"
                     Min="250"
                     Max="30000"
                     Step="50"
                     ValueChanged="@(value => ReconnectDelayMs = value)" Error="@ReconnectDelayMsError" Suffix="ms" /></SettingRow>
    <SettingRow Label="Receive buffer size" Description="Maximum incoming UDP message size in bytes."><NumberInput Class="[&_label]:sr-only" Label="Receive buffer size"
                     Value="ReceiveBufferSize"
                     Min="256"
                     Max="65535"
                     Step="256"
                     ValueChanged="@(value => ReceiveBufferSize = value)" Error="@ReceiveBufferSizeError" Suffix="B" /></SettingRow>
</div>
</details>
</fieldset>
<p class="text-sm text-app-muted">Saving reconnects a running listener. A stopped listener stays stopped.</p>
<div class="flex items-center justify-end gap-3 border-t border-app-border pt-3">
<p class="text-sm text-app-muted" role="status">@(IsSaving ? "Applying settings…" : IsDirty ? "Unsaved changes" : HasSaved ? "Saved" : null)</p>
<Button Text="@(IsSaving ? "Applying…" : "Save changes")" Disabled="@(!IsDirty || HasInvalidNumbers || IsSaving)" Title="@(HasInvalidNumbers ? "Correct invalid values before saving" : IsSaving ? "Applying settings" : IsDirty ? null : "No unsaved changes")" OnClick="SaveSettings" />
</div>
@if (!string.IsNullOrWhiteSpace(StatusMessage)) {
@if (StatusIsError) { <Alert Variant="danger">@StatusMessage</Alert> } else { <p class="text-sm text-app-muted" role="status">@StatusMessage</p> }
}
</div>

@code {
    private string? SendPortError => SendPort is { } value && double.IsFinite(value) && value >= 1 && value <= 65535 && value == Math.Truncate(value) ? null : "Enter a whole number from 1 to 65535.";
    private string? ReceivePortError => ReceivePort is { } value && double.IsFinite(value) && value >= 1 && value <= 65535 && value == Math.Truncate(value) ? null : "Enter a whole number from 1 to 65535.";
    private string? OscQueryRefreshIntervalMsError => OscQueryRefreshIntervalMs is { } value && double.IsFinite(value) && value >= 500 && value <= 30000 && value == Math.Truncate(value) ? null : "Enter a whole number from 500 to 30000.";
    private string? ReconnectDelayMsError => ReconnectDelayMs is { } value && double.IsFinite(value) && value >= 250 && value <= 30000 && value == Math.Truncate(value) ? null : "Enter a whole number from 250 to 30000.";
    private string? ReceiveBufferSizeError => ReceiveBufferSize is { } value && double.IsFinite(value) && value >= 256 && value <= 65535 && value == Math.Truncate(value) ? null : "Enter a whole number from 256 to 65535.";
    private bool HasInvalidNumbers => SendPortError != null || (!UseAnyAvailablePort && ReceivePortError != null) || OscQueryRefreshIntervalMsError != null || ReconnectDelayMsError != null || ReceiveBufferSizeError != null;
    private bool IsDirty => Enabled != SettingsService.Enabled || AutoStart != SettingsService.AutoStart ||
        OscQueryEnabled != SettingsService.OscQueryEnabled ||
        PreferOscQueryDiscoveredEndpoint != SettingsService.PreferOscQueryDiscoveredEndpoint ||
        OscQueryClientName != SettingsService.OscQueryClientName ||
        OscQueryRefreshIntervalMs != SettingsService.OscQueryRefreshIntervalMs ||
        RemoteHost != SettingsService.RemoteHost ||
        SendPort != SettingsService.SendPort ||
        UseAnyAvailablePort != SettingsService.UseAnyAvailablePort ||
        ReceiveBindHost != SettingsService.ReceiveBindHost ||
        ReceivePort != SettingsService.ReceivePort ||
        ReconnectDelayMs != SettingsService.ReconnectDelayMs ||
        ReceiveBufferSize != SettingsService.ReceiveBufferSize;

    private static readonly string PluginIdValue = VRChatOSCPlugin.PluginId;

    private VRChatOscSettingsService SettingsService =>
        PluginServiceLocator.GetRequiredService<VRChatOscSettingsService>(PluginIdValue);

    private VRChatOscConnectionManager ConnectionManager =>
        PluginServiceLocator.GetRequiredService<VRChatOscConnectionManager>(PluginIdValue);

    private bool Enabled;
    private bool AutoStart;
    private bool UseAnyAvailablePort = true;
    private bool OscQueryEnabled = true;
    private bool PreferOscQueryDiscoveredEndpoint = true;
    private string OscQueryClientName = "VRChat-Client";
    private double? OscQueryRefreshIntervalMs = 2500;
    private string RemoteHost = "127.0.0.1";
    private double? SendPort = 9000;
    private string ReceiveBindHost = "127.0.0.1";
    private double? ReceivePort = 9001;
    private double? ReconnectDelayMs = 2000;
    private double? ReceiveBufferSize = 8192;

    private string? StatusMessage;
    private bool StatusIsError;
    private bool IsSaving;
    private bool HasSaved;

    [Parameter]
    public string? PluginId { get; set; }

    protected override void OnInitialized()
    {
        ReadSettings();

        ConnectionManager.StatusMessage += OnStatus;
        ConnectionManager.ErrorOccurred += OnError;
        ConnectionManager.ConnectionStateChanged += OnConnectionChanged;
    }

    private void ReadSettings()
    {
        Enabled = SettingsService.Enabled;
        AutoStart = SettingsService.AutoStart;
        UseAnyAvailablePort = SettingsService.UseAnyAvailablePort;
        OscQueryEnabled = SettingsService.OscQueryEnabled;
        PreferOscQueryDiscoveredEndpoint = SettingsService.PreferOscQueryDiscoveredEndpoint;
        OscQueryClientName = SettingsService.OscQueryClientName;
        OscQueryRefreshIntervalMs = SettingsService.OscQueryRefreshIntervalMs;
        RemoteHost = SettingsService.RemoteHost;
        SendPort = SettingsService.SendPort;
        ReceiveBindHost = SettingsService.ReceiveBindHost;
        ReceivePort = SettingsService.ReceivePort;
        ReconnectDelayMs = SettingsService.ReconnectDelayMs;
        ReceiveBufferSize = SettingsService.ReceiveBufferSize;
    }

    private async Task SaveSettings()
    {
        if (IsSaving || HasInvalidNumbers) return;
        IsSaving = true;
        try
        {
            SettingsService.Enabled = Enabled;
            SettingsService.AutoStart = AutoStart;
            SettingsService.UseAnyAvailablePort = UseAnyAvailablePort;
            SettingsService.OscQueryEnabled = OscQueryEnabled;
            SettingsService.PreferOscQueryDiscoveredEndpoint = PreferOscQueryDiscoveredEndpoint;
            SettingsService.OscQueryClientName = OscQueryClientName;
            SettingsService.OscQueryRefreshIntervalMs = (int)OscQueryRefreshIntervalMs!.Value;
            SettingsService.RemoteHost = RemoteHost;
            SettingsService.SendPort = (int)SendPort!.Value;
            SettingsService.ReceiveBindHost = ReceiveBindHost;
            if (ReceivePortError == null) SettingsService.ReceivePort = (int)ReceivePort!.Value;
            SettingsService.ReconnectDelayMs = (int)ReconnectDelayMs!.Value;
            SettingsService.ReceiveBufferSize = (int)ReceiveBufferSize!.Value;

            if (!SettingsService.Enabled)
            {
                await ConnectionManager.StopAsync();
            }
            else if (ConnectionManager.IsRunning)
            {
                await ConnectionManager.ReconnectAsync();
            }

            StatusIsError = !string.IsNullOrWhiteSpace(ConnectionManager.LastError);
            StatusMessage = StatusIsError ? ConnectionManager.LastError : null;
            HasSaved = !StatusIsError;
        }
        finally { IsSaving = false; }
    }


    private Task ToggleAutoStart(bool enabled)
    {
        AutoStart = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleUseAnyAvailablePort(bool enabled)
    {
        UseAnyAvailablePort = enabled;
        return Task.CompletedTask;
    }

    private Task ToggleOscQueryEnabled(bool enabled)
    {
        OscQueryEnabled = enabled;
        return Task.CompletedTask;
    }

    private Task TogglePreferOscQueryEndpoint(bool enabled)
    {
        PreferOscQueryDiscoveredEndpoint = enabled;
        return Task.CompletedTask;
    }

    private void OnStatus(string message)
    {
        InvokeAsync(() =>
        {
            StatusIsError = false;
            StatusMessage = message;
            StateHasChanged();
        });
    }

    private void OnError(string message)
    {
        InvokeAsync(() =>
        {
            StatusIsError = true;
            StatusMessage = message;
            StateHasChanged();
        });
    }

    private void OnConnectionChanged(bool _)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ConnectionManager.StatusMessage -= OnStatus;
        ConnectionManager.ErrorOccurred -= OnError;
        ConnectionManager.ConnectionStateChanged -= OnConnectionChanged;
    }
}
