<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <!-- The Windows TFM provides the WinRT media session API. -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PluginVersion>0.1.0</PluginVersion> <!-- x-release-please-version -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NAudio.Wasapi" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
        <PackageReference Include="VolcanicArts.Libs.OpenVR" />
        <PackageReference Include="Vortice.Direct3D11" />
    </ItemGroup>

    <!--
        Production plugins load into the default context, where the host's native resolver covers only
        the plugin assembly itself. SkiaSharp.dll falls back to searching its own folder, so libSkiaSharp
        also ships beside it in the package root.
    -->
    <ItemGroup>
        <PluginPackageFile Include="$(TargetDir)runtimes\win-x64\native\libSkiaSharp.dll" />
    </ItemGroup>
</Project>
