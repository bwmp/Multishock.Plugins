@implements IDisposable

<div class="space-y-3">
    <ConnectionChip Connected="Connection.IsConnected" Connecting="Connection.IsConnecting" />
    <p class="text-sm text-app-muted">Set up the connection and reactions on the Joystick.tv page.</p>
    <NavButton Href="/plugins/com-multishock-joystickintegration/joystickintegration" Text="Open Joystick.tv page" />
</div>

@code {
    private static readonly string OwnPluginId = JoystickIntegrationPlugin.PluginId;
    private JoystickConnectionService Connection => PluginServiceLocator.GetRequiredService<JoystickConnectionService>(OwnPluginId);

    [Parameter]
    public string? PluginId { get; set; }

    protected override void OnInitialized()
    {
        Connection.ConnectionStateChanged += OnConnectionChanged;
    }

    private void OnConnectionChanged(bool connected) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connection.ConnectionStateChanged -= OnConnectionChanged;
    }
}
