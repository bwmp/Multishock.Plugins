@using ImageDetection.Models
@using MultiShock.PluginSdk.Components
@using MultiShock.PluginSdk.JSInterop
@inject IDomInterop DomInterop
@implements IDisposable

<Modal IsOpen="@(IsVisible && _screenshotDataUrl != null)" Title="Select region" Size="xl" Class="!w-auto !max-w-[90vw]" CloseOnBackdrop="false" OnClose="Cancel">
    <ChildContent>
        <div class="flex flex-col gap-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="min-w-0 truncate text-xs text-app-muted">
                    <span class="font-mono">@_actualResolution</span>
                    @if (!string.IsNullOrEmpty(TargetName))
                    {
                        <span> &mdash; @TargetName</span>
                    }
                </span>
                @if (_hasSelection)
                {
                    <span class="chip chip-info font-mono">
                        @(_selX), @(_selY) &mdash; @(_selW)&times;@(_selH)
                    </span>
                }
                else
                {
                    <span class="chip chip-neutral">No region selected</span>
                }
            </div>

            <div class="relative self-center overflow-hidden rounded-ctl border border-app-border cursor-crosshair select-none"
                 style="width: @((int)_displayWidth)px; height: @((int)_displayHeight)px;"
                 @onmousedown="OnMouseDown"
                 @onmousemove="OnMouseMove"
                 @onmouseup="OnMouseUp"
                 @onmouseleave="OnMouseUp"
                 @onmousedown:preventDefault
                 @ref="_containerRef">

                <img src="@_screenshotDataUrl" alt="Screen capture"
                     width="@((int)_displayWidth)" height="@((int)_displayHeight)"
                     class="block pointer-events-none"
                     style="width: @((int)_displayWidth)px; height: @((int)_displayHeight)px;" />

                @if (_hasSelection)
                {
                    <div class="absolute left-0 right-0 top-0 bg-black/50 pointer-events-none"
                         style="height: @(_displaySelY)px;"></div>
                    <div class="absolute left-0 right-0 bottom-0 bg-black/50 pointer-events-none"
                         style="height: @(Math.Max(0, (int)_displayHeight - _displaySelY - _displaySelH))px;"></div>
                    <div class="absolute left-0 bg-black/50 pointer-events-none"
                         style="top: @(_displaySelY)px; width: @(_displaySelX)px; height: @(_displaySelH)px;"></div>
                    <div class="absolute bg-black/50 pointer-events-none"
                         style="top: @(_displaySelY)px; left: @(_displaySelX + _displaySelW)px; right: 0; height: @(_displaySelH)px;"></div>

                    <div class="absolute border-2 border-app-info pointer-events-none"
                         style="left: @(_displaySelX)px; top: @(_displaySelY)px; width: @(_displaySelW)px; height: @(_displaySelH)px;">
                        <div class="absolute -top-1 -left-1 w-2.5 h-2.5 bg-app-info rounded-sm"></div>
                        <div class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-app-info rounded-sm"></div>
                        <div class="absolute -bottom-1 -left-1 w-2.5 h-2.5 bg-app-info rounded-sm"></div>
                        <div class="absolute -bottom-1 -right-1 w-2.5 h-2.5 bg-app-info rounded-sm"></div>
                    </div>
                }
            </div>

            <div class="flex flex-wrap items-end justify-center gap-3">
                <NumberInput Label="X" Class="w-24" Value="_draftX" Error="@FieldError("x", _draftX, 0, _screenshotWidth - 1)" Min="0" Max="@(_screenshotWidth - 1)" Suffix="px"
                             ValueChanged="@(v => UpdateManualCoord("x", v))" />
                <NumberInput Label="Y" Class="w-24" Value="_draftY" Error="@FieldError("y", _draftY, 0, _screenshotHeight - 1)" Min="0" Max="@(_screenshotHeight - 1)" Suffix="px"
                             ValueChanged="@(v => UpdateManualCoord("y", v))" />
                <NumberInput Label="Width" Class="w-24" Value="_draftW" Error="@FieldError("w", _draftW, 1, _screenshotWidth)" Min="1" Max="_screenshotWidth" Suffix="px"
                             ValueChanged="@(v => UpdateManualCoord("w", v))" />
                <NumberInput Label="Height" Class="w-24" Value="_draftH" Error="@FieldError("h", _draftH, 1, _screenshotHeight)" Min="1" Max="_screenshotHeight" Suffix="px"
                             ValueChanged="@(v => UpdateManualCoord("h", v))" />
                <Button Text="Clear" Variant="ghost" Disabled="@(_draftX == null && _draftY == null && _draftW == null && _draftH == null)" OnClick="ClearSelection" />
            </div>

            @if (BoundsError != null)
            {
                <p class="text-xs text-app-danger" role="status">@BoundsError</p>
            }
            <p class="text-xs text-app-muted">
                Drag on the screenshot or enter coordinates. Values are in actual screen pixels.
            </p>
        </div>
    </ChildContent>
    <Footer>
        <Button Text="Cancel" Variant="ghost" OnClick="Cancel" />
        <Button Text="Apply region" Variant="primary" Disabled="@(!_hasSelection || !RegionValid)" OnClick="Apply" />
    </Footer>
</Modal>

@code {
    private double? _draftX, _draftY, _draftW, _draftH;
    private Timer? _resizeTimer;
    private bool _disposed;
    private readonly HashSet<string> _editedCoordinates = [];
    private double _encodedScale = 1;
    private bool CoordinatesValid => ValidCoordinate(_draftX, 0, _screenshotWidth - 1)
        && ValidCoordinate(_draftY, 0, _screenshotHeight - 1)
        && ValidCoordinate(_draftW, 1, _screenshotWidth)
        && ValidCoordinate(_draftH, 1, _screenshotHeight);
    private bool RegionValid => CoordinatesValid
        && _draftX + _draftW <= _screenshotWidth && _draftY + _draftH <= _screenshotHeight;
    private string? BoundsError => _editedCoordinates.Count > 0 && CoordinatesValid && !RegionValid
        ? "The region must fit inside the screenshot." : null;

    private string? FieldError(string field, double? value, int min, int max) =>
        !_editedCoordinates.Contains(field) || ValidCoordinate(value, min, max)
            ? null : $"Enter a whole pixel value from {min} to {max}.";

    private static bool ValidCoordinate(double? value, int min, int max) =>
        value is { } v && double.IsFinite(v) && v == Math.Truncate(v) && v >= min && v <= max;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshViewport();
        if (_disposed) return;
        _resizeTimer = new Timer(_ => InvokeAsync(RefreshViewport), null, 500, 500);
    }

    private async Task RefreshViewport()
    {
        if (_disposed || !IsVisible || _screenshotWidth == 0) return;
        var viewport = await DomInterop.GetViewportAsync();
        if (_disposed) return;
        var scale = Math.Min(_encodedScale, Math.Min(Math.Max(1, viewport.Width * 0.9 - 64) / _screenshotWidth,
            Math.Max(1, viewport.Height - 340) / _screenshotHeight));
        if (Math.Abs(scale - _scale) < 0.0001) return;
        _scale = scale;
        _displayWidth = Math.Max(1, Math.Floor(_screenshotWidth * scale));
        _displayHeight = Math.Max(1, Math.Floor(_screenshotHeight * scale));
        _containerRect = null;
        _isDragging = false;
        UpdateDisplaySelection();
        StateHasChanged();
    }

    private void SyncDrafts()
    {
        _draftX = _hasSelection ? _selX : null; _draftY = _hasSelection ? _selY : null;
        _draftW = _hasSelection ? _selW : null; _draftH = _hasSelection ? _selH : null;
    }

    private ElementReference _containerRef;
    private string? _screenshotDataUrl;
    private string _actualResolution = "";

    private int _screenshotWidth;
    private int _screenshotHeight;

    private double _displayWidth;
    private double _displayHeight;
    private double _scale = 1.0;

    private BoundingClientRect? _containerRect;

    private bool _isDragging;
    private double _dragStartX;
    private double _dragStartY;

    private bool _hasSelection;
    private int _selX;
    private int _selY;
    private int _selW;
    private int _selH;

    private int _displaySelX;
    private int _displaySelY;
    private int _displaySelW;
    private int _displaySelH;

    private const int MaxDisplayWidth = 1200;
    private const int MaxDisplayHeight = 700;

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string? TargetName { get; set; }
    [Parameter] public ScreenRegion? InitialRegion { get; set; }
    [Parameter] public EventCallback<ScreenRegion> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Sets the screenshot data from an Emgu.CV Mat (called by parent).
    /// </summary>
    public void SetScreenshot(Emgu.CV.Mat screenshot)
    {
        if (screenshot == null || screenshot.IsEmpty) return;

        _screenshotWidth = screenshot.Width;
        _screenshotHeight = screenshot.Height;
        _actualResolution = $"{_screenshotWidth}x{_screenshotHeight}";

        _scale = Math.Min(
            (double)MaxDisplayWidth / _screenshotWidth,
            (double)MaxDisplayHeight / _screenshotHeight);
        _scale = Math.Min(_scale, 1.0);
        _encodedScale = _scale;
        _editedCoordinates.Clear();

        _displayWidth = Math.Round(_screenshotWidth * _scale);
        _displayHeight = Math.Round(_screenshotHeight * _scale);

        try
        {
            using var resized = new Emgu.CV.Mat();
            if (_scale < 1.0)
            {
                var newW = (int)_displayWidth;
                var newH = (int)_displayHeight;
                Emgu.CV.CvInvoke.Resize(screenshot, resized, new System.Drawing.Size(newW, newH),
                    interpolation: Emgu.CV.CvEnum.Inter.Linear);
            }
            else
            {
                screenshot.CopyTo(resized);
            }

            var bytes = resized.ToImage<Emgu.CV.Structure.Bgra, byte>().ToJpegData(85);
            _screenshotDataUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            _screenshotDataUrl = null;
        }

        _containerRect = null;

        // Apply initial region if provided
        if (InitialRegion != null && InitialRegion.Width > 0 && InitialRegion.Height > 0)
        {
            _selX = InitialRegion.X;
            _selY = InitialRegion.Y;
            _selW = InitialRegion.Width;
            _selH = InitialRegion.Height;
            _hasSelection = true;
            UpdateDisplaySelection();
        }
        else
        {
            _hasSelection = false;
            _selX = _selY = _selW = _selH = 0;
        }

        SyncDrafts();
        StateHasChanged();
    }

    /// <summary>
    /// Converts a ClientX/ClientY mouse position to display-space coordinates
    /// relative to the container element.
    /// </summary>
    private async Task<(double x, double y)> ClientToDisplay(double clientX, double clientY)
    {
        _containerRect ??= await DomInterop.GetBoundingClientRectAsync(_containerRef);

        if (_containerRect == null)
            return (clientX, clientY);

        return (clientX - _containerRect.Left, clientY - _containerRect.Top);
    }

    private async Task OnMouseDown(MouseEventArgs e)
    {

        _containerRect = await DomInterop.GetBoundingClientRectAsync(_containerRef);

        var (x, y) = await ClientToDisplay(e.ClientX, e.ClientY);

        _isDragging = true;
        _dragStartX = x;
        _dragStartY = y;

        _displaySelX = (int)x;
        _displaySelY = (int)y;
        _displaySelW = 0;
        _displaySelH = 0;
        _hasSelection = false;
    }

    private async Task OnMouseMove(MouseEventArgs e)
    {
        if (!_isDragging) return;

        var (curX, curY) = await ClientToDisplay(e.ClientX, e.ClientY);

        var x1 = Math.Min(_dragStartX, curX);
        var y1 = Math.Min(_dragStartY, curY);
        var x2 = Math.Max(_dragStartX, curX);
        var y2 = Math.Max(_dragStartY, curY);

        x1 = Math.Clamp(x1, 0, _displayWidth);
        y1 = Math.Clamp(y1, 0, _displayHeight);
        x2 = Math.Clamp(x2, 0, _displayWidth);
        y2 = Math.Clamp(y2, 0, _displayHeight);

        _displaySelX = (int)x1;
        _displaySelY = (int)y1;
        _displaySelW = (int)(x2 - x1);
        _displaySelH = (int)(y2 - y1);

        MapDisplayToReal();

        _hasSelection = _selW > 2 && _selH > 2;
        _editedCoordinates.Clear();
        SyncDrafts();
    }

    private void OnMouseUp(MouseEventArgs e)
    {
        if (!_isDragging) return;
        _isDragging = false;

        if (_selW < 3 || _selH < 3)
        {
            _hasSelection = false;
        }
    }

    /// <summary>
    /// Maps display-space selection to real pixel coordinates.
    /// </summary>
    private void MapDisplayToReal()
    {
        if (_scale <= 0) return;

        _selX = (int)Math.Round(_displaySelX / _scale);
        _selY = (int)Math.Round(_displaySelY / _scale);
        _selW = (int)Math.Round(_displaySelW / _scale);
        _selH = (int)Math.Round(_displaySelH / _scale);

        _selX = Math.Clamp(_selX, 0, _screenshotWidth - 1);
        _selY = Math.Clamp(_selY, 0, _screenshotHeight - 1);
        _selW = Math.Clamp(_selW, 1, _screenshotWidth - _selX);
        _selH = Math.Clamp(_selH, 1, _screenshotHeight - _selY);
    }

    /// <summary>
    /// Maps real pixel coordinates to display-space for rendering.
    /// </summary>
    private void UpdateDisplaySelection()
    {
        _displaySelX = (int)Math.Round(_selX * _scale);
        _displaySelY = (int)Math.Round(_selY * _scale);
        _displaySelW = (int)Math.Round(_selW * _scale);
        _displaySelH = (int)Math.Round(_selH * _scale);
    }

    private void UpdateManualCoord(string coordinate, double? value)
    {
        _editedCoordinates.Add(coordinate);
        switch (coordinate)
        {
            case "x": _draftX = value; break;
            case "y": _draftY = value; break;
            case "w": _draftW = value; break;
            case "h": _draftH = value; break;
        }
        if (!RegionValid) return;
        _selX = (int)_draftX!.Value;
        _selY = (int)_draftY!.Value;
        _selW = (int)_draftW!.Value;
        _selH = (int)_draftH!.Value;
        _hasSelection = true;
        UpdateDisplaySelection();
    }

    private void ClearSelection()
    {
        _hasSelection = false;
        _editedCoordinates.Clear();
        _selX = _selY = _selW = _selH = 0;
        SyncDrafts();
        _displaySelX = _displaySelY = _displaySelW = _displaySelH = 0;
    }

    private async Task Apply()
    {
        if (!_hasSelection || !RegionValid) return;

        var region = new ScreenRegion(_selX, _selY, _selW, _selH);
        await OnApply.InvokeAsync(region);
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _resizeTimer?.Dispose();
        _screenshotDataUrl = null;
    }
}
