@using System.Globalization

@* Keeps an empty, out-of-range or off-step entry visible with an error instead of saving a clamped or rounded value. *@
<NumberInput Label="@Label" Class="@Class" Description="@Description" Suffix="@Suffix" Min="Min" Max="Max" Step="Step" Disabled="Disabled"
             Value="@(_error is null ? Value : _draft)" Error="@_error" ValueChanged="OnValueChanged" />

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public double Value { get; set; }
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public EventCallback<double> ValueChanged { get; set; }

    private double? _draft;
    private string? _error;

    private async Task OnValueChanged(double? value)
    {
        _draft = value;
        var error = Validate(value, Min, Max, Step);
        if (error is not null)
        {
            _error = $"{error} Not saved.";
            return;
        }

        _error = null;
        await ValueChanged.InvokeAsync(value!.Value);
    }

    internal static string? Validate(double? value, double? min, double? max, double step)
    {
        if (value is not { } number)
        {
            return "Enter a value.";
        }
        if (number < min || number > max)
        {
            return (min, max) switch
            {
                ({ } low, { } high) => $"Enter {Format(low)} to {Format(high)}.",
                ({ } low, null) => $"Enter {Format(low)} or more.",
                (null, { } high) => $"Enter {Format(high)} or less.",
                _ => null,
            };
        }
        var steps = number / step;
        if (Math.Abs(steps - Math.Round(steps)) >= 1e-9)
        {
            return step % 1 == 0 ? "Enter a whole number." : $"Enter a multiple of {Format(step)}.";
        }
        return null;
    }

    private static string Format(double value) => value.ToString("#,0.##", CultureInfo.InvariantCulture);
}
