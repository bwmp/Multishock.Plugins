<span role="status" class="inline-flex">
    @switch (State)
    {
        case ThroneConnectionState.Receiving:
            <span class="chip chip-ok"><span class="status-dot bg-app-success"></span>Receiving gifts</span>
            break;
        case ThroneConnectionState.AwaitingWebhook:
            <span class="chip chip-info"><span class="status-dot bg-app-info"></span>Waiting for first gift</span>
            break;
        case ThroneConnectionState.Connecting:
            <span class="chip chip-info"><span class="status-dot bg-app-info"></span>Connecting…</span>
            break;
        case ThroneConnectionState.Retrying:
            <span class="chip chip-info"><span class="status-dot bg-app-info"></span>Reconnecting…</span>
            break;
        case ThroneConnectionState.MissedEvents:
        case ThroneConnectionState.Revoked:
            <span class="chip chip-neutral"><span class="status-dot bg-app-danger"></span>Needs attention</span>
            break;
        case ThroneConnectionState.NotSetUp:
            <span class="chip chip-neutral"><span class="status-dot bg-app-subtle"></span>Not set up</span>
            break;
        default:
            <span class="chip chip-neutral"><span class="status-dot bg-app-subtle"></span>Disconnected</span>
            break;
    }
</span>

@code {
    [Parameter] public ThroneConnectionState State { get; set; }
}
