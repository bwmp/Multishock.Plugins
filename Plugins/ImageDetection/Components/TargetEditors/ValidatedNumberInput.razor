@using MultiShock.PluginSdk.Components

<NumberInput Label="@Label" Value="Draft" ValueChanged="Update" Min="Min" Max="Max" Step="Step"
             Suffix="@Suffix" Class="@Class" Description="@Description" Error="@Error" />

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public double? Value { get; set; }
    [Parameter] public EventCallback<double?> ValueChanged { get; set; }
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public double Step { get; set; } = 1;
    private double? Draft;
    private double? Previous;
    private bool Initialized;
    private string? Error
    {
        get
        {
            if (Draft is not { } value) return "Enter a value. Not saved.";
            if (!double.IsFinite(value) || (Min.HasValue && value < Min) || (Max.HasValue && value > Max))
                return $"Enter {Min} to {Max}. Not saved.";
            if (Step == Math.Truncate(Step) && value != Math.Truncate(value))
                return "Enter a whole number. Not saved.";
            if (Math.Abs(value / Step - Math.Round(value / Step)) > 1e-9)
                return $"Enter a multiple of {Step}. Not saved.";
            return null;
        }
    }

    protected override void OnParametersSet()
    {
        if (!Initialized || Value != Previous) Draft = Value;
        Previous = Value;
        Initialized = true;
    }

    private async Task Update(double? value)
    {
        Draft = value;
        if (Error != null) return;
        await ValueChanged.InvokeAsync(value);
        Previous = value;
    }
}
