@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@implements IDisposable

<div class="space-y-3">
    <span class="chip @ConnectionChip" role="status">
        <span class="status-dot @ConnectionDot"></span>
        @ConnectionLabel
    </span>
    <p class="text-sm text-app-muted">Set up the connection and reactions on the StreamElements page.</p>
    <NavButton Href="/plugins/com-multishock-streamelementsintegration/streamelementsintegration" Text="Open StreamElements page" />
</div>

@code {
    private static readonly string OwnPluginId = StreamElementsIntegrationPlugin.PluginId;
    private StreamElementsConnectionService Connection => PluginServiceLocator.GetRequiredService<StreamElementsConnectionService>(OwnPluginId);

    private EventLogService Log => PluginServiceLocator.GetRequiredService<EventLogService>(OwnPluginId);
    private string ConnectionLabel => Connection.IsConnected ? "Connected" : Log.IsReconnecting ? "Reconnecting…" : Connection.IsConnecting ? "Connecting…" : Log.LastConnectionError != null ? "Error" : "Disconnected";
    private string ConnectionChip => Connection.IsConnected ? "chip-ok" : Log.IsReconnecting ? "chip-info" : Connection.IsConnecting ? "chip-info" : Log.LastConnectionError != null ? "chip-danger" : "chip-neutral";
    private string ConnectionDot => Connection.IsConnected ? "bg-app-success" : Log.IsReconnecting ? "bg-app-info" : Connection.IsConnecting ? "bg-app-info" : Log.LastConnectionError != null ? "bg-app-danger" : "bg-app-subtle";

    [Parameter]
    public string? PluginId { get; set; }

    protected override void OnInitialized()
    {
        Connection.ConnectionStateChanged += OnConnectionChanged;
        Log.LogChanged += OnLogChanged;
    }

    private void OnLogChanged() => InvokeAsync(StateHasChanged);

    private void OnConnectionChanged(bool connected) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connection.ConnectionStateChanged -= OnConnectionChanged;
        Log.LogChanged -= OnLogChanged;
    }
}
