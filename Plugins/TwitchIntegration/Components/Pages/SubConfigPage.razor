@page "/plugins/com-multishock-twitchintegration/sub-config"
@using MultiShock.PluginSdk
@implements IDisposable
@using global::TwitchIntegration.Components.Config

<PageHeader Title="Subscriptions" Icon="users" Description="Set how subscriptions and gifted subs control your shockers, per tier. Changes save automatically.">
    <Breadcrumb><BackLink /></Breadcrumb>
    <Actions>
        <Toggle Label="Enabled" AriaLabel="Enable subscription reactions" Value="SubConfigService.Config.Enabled" ValueChanged="ToggleMasterEnabled" />
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!SubConfigService.Config.Enabled)
    {
        <Alert Variant="neutral">Subscription reactions are off. You can set up tiers now; nothing runs until you switch on Enabled. Subscriptions still reach your flows.</Alert>
    }

    <div class="space-y-3" data-guided-setup="twitch-subs-sections">
        @foreach (var sec in SubConfigService.Config.Sections.OrderBy(s => s.Tier))
        {
            var expanded = ExpandedSections.Contains(sec.Id);
            var name = $"Tier {sec.Tier}";
            var issue = SectionIssue(sec);
            <section class="panel" @key="sec.Id" aria-label="@name">
                <div class="@($"flex flex-wrap items-center gap-x-2 gap-y-1 px-3 py-2 {(expanded ? "border-b border-app-border" : "")}")">
                    <button type="button" class="flex min-w-0 flex-1 items-center gap-2 rounded-ctl py-1 text-left"
                            aria-expanded="@(expanded ? "true" : "false")" aria-controls="@(expanded ? $"section-{sec.Id}" : null)"
                            @onclick="@(() => ToggleSectionExpanded(sec.Id))">
                        <LucideIcon Name="chevron-right" Size="16" Class="@($"shrink-0 text-app-muted transition-transform {(expanded ? "rotate-90" : "")}")" />
                        <span class="min-w-0">
                            <span class="block truncate text-sm font-medium text-app-text">@name</span>
                            <span class="block truncate text-xs text-app-subtle">@SectionDetail(sec)</span>
                        </span>
                    </button>
                    @if (sec.Enabled && issue != null)
                    {
                        <SummaryChip Summary="@(new ReactionSummary(SubConfigService.Config.Enabled ? ReactionStatus.Attention : ReactionStatus.Off, issue))" />
                    }
                    <Toggle AriaLabel="@($"Enable {name.ToLowerInvariant()} reactions")" Value="sec.Enabled" ValueChanged="@(e => ToggleSectionEnabled(sec, e))" />
                </div>

                @if (expanded)
                {
                    <div id="@($"section-{sec.Id}")">
                        <div class="panel-body grid gap-4 sm:grid-cols-2" data-guided-setup="twitch-subs-mode">
                            <Select TValue="string" Label="Scaling" Value="@sec.Mode.ToString()" Options="SubscriptionModeOptions"
                                    ValueChanged="@(value => UpdateSectionMode(sec, ParseSubscriptionMode(value)))" />
                            <p class="self-end pb-2 text-xs text-app-muted">
                                @(sec.Mode == SubscriptionMode.Brackets
                                    ? "Brackets pick a fixed action by sub count."
                                    : "Each extra sub adds to the action, up to a maximum.")
                            </p>
                            <div class="sm:col-span-2">
                                <ShockerSelect Label="Shockers" MultiSelect="true" SelectedIds="sec.SelectedShockerIds"
                                               SelectedIdsChanged="@(ids => UpdateSectionShockers(sec, ids))" />
                                @if (sec.SelectedShockerIds.Count == 0)
                                {
                                    <NoShockersHint Class="mt-1.5" />
                                }
                            </div>
                        </div>

                        @if (sec.Mode == SubscriptionMode.Brackets)
                        {
                            <div data-guided-setup="twitch-subs-brackets">
                                <div class="panel-body grid gap-4 border-t border-app-border sm:grid-cols-2">
                                    <Select TValue="string" Label="Command" Value="@sec.BracketCommandType" Options="ActionOptions.Commands"
                                            ValueChanged="@(value => UpdateBracketCommandType(sec, value ?? "Vibrate"))" />
                                    <Select TValue="string" Label="Matching" Value="@(sec.FixedAmount ? "exact" : "round")" Options="ActionOptions.Matching"
                                            ValueChanged="@(value => UpdateSectionFixedAmount(sec, value == "exact"))" />
                                    @if (sec.BracketCommandType == "Shock")
                                    {
                                        <div class="sm:col-span-2">
                                            <Toggle Label="Vibrate as a warning before each shock" Value="sec.WarningVibrate"
                                                    ValueChanged="@(v => UpdateSectionWarningVibrate(sec, v))" />
                                        </div>
                                    }
                                </div>

                                <div class="border-t border-app-border">
                                    <div class="flex items-start justify-between gap-3 px-4 py-3">
                                        <div>
                                            <h3 class="text-sm font-medium text-app-text">Sub brackets</h3>
                                            <p class="text-xs text-app-muted">
                                                @(sec.FixedAmount
                                                    ? "Fires the bracket whose amount matches the sub count exactly. A single sub counts as 1; a gift counts its subs."
                                                    : "Fires the highest bracket at or below the sub count. A single sub counts as 1; a gift counts its subs.")
                                            </p>
                                        </div>
                                        <Button Text="Add bracket" Variant="secondary" Size="sm" Icon="plus" OnClick="@(() => AddBracket(sec))" />
                                    </div>

                                    <BracketList TBracket="SubscriptionBracket" CountLabel="Subs" Brackets="sec.Brackets"
                                                 CountSelector="@(b => b.Count)" IntensitySelector="@(b => b.Intensity)"
                                                 DurationSelector="@(b => b.Duration)" ModeSelector="@(b => b.Mode.ToString())"
                                                 OnCountChanged="@(change => UpdateBracketCount(sec, change.Bracket, change.Value))"
                                                 OnIntensityChanged="@(change => UpdateBracketIntensity(sec, change.Bracket, change.Value))"
                                                 OnDurationChanged="@(change => UpdateBracketDuration(sec, change.Bracket, change.Value))"
                                                 OnModeChanged="@(change => UpdateBracketMode(sec, change.Bracket, ActionOptions.ParseMode(change.Value)))"
                                                 OnRemove="@(bracket => RemoveBracket(sec, bracket))"
                                                 EmptyText="No brackets yet. This tier won't run until you add one." />
                                </div>

                                @if (CheerConfigService.Config.Sections.Any())
                                {
                                    var source = CheerConfigService.Config.Sections.FirstOrDefault(cs => cs.Id == SelectedCheerSectionIdForImport);
                                    <div class="panel-body flex flex-wrap items-end gap-2 border-t border-app-border">
                                        <Select TValue="string" Label="Copy brackets from a cheer section" Class="w-64" Placeholder="Choose a section"
                                                Value="@SelectedCheerSectionIdForImport" Options="CheerSectionOptions"
                                                ValueChanged="@(value => SelectedCheerSectionIdForImport = value)" />
                                        <Button Text="Copy brackets" Variant="secondary" Size="sm"
                                                Disabled="@(source == null || source.Brackets.Count == 0)"
                                                Title="@(source == null ? "Choose a cheer section first" : source.Brackets.Count == 0 ? "That section has no brackets" : null)"
                                                OnClick="@(() => RequestCopyBrackets(sec))" />
                                        <p class="basis-full text-xs text-app-muted">
                                            Replaces this tier's brackets and command, converting @BitsPerSub(sec.Tier) bits to one sub.
                                        </p>
                                    </div>
                                }
                            </div>
                        }

                        @if (sec.Mode == SubscriptionMode.Incremental)
                        {
                            <div class="border-t border-app-border px-4 py-2" data-guided-setup="twitch-subs-incremental">
                                <SettingRow Label="Command" Description="What the shockers do.">
                                    <Select TValue="string" Label="Command" Class="[&_label]:sr-only" Value="@sec.Incremental.CommandType" Options="ActionOptions.Commands"
                                            ValueChanged="@(value => UpdateIncrementalCommandType(sec, value ?? "Vibrate"))" />
                                </SettingRow>
                                @if (sec.Incremental.CommandType == "Shock")
                                {
                                    <SettingRow Label="Warning vibrate" Description="Vibrate briefly before each shock.">
                                        <Toggle AriaLabel="Warning vibrate" Value="sec.Incremental.WarningVibrate"
                                                ValueChanged="@(v => UpdateIncrementalWarningVibrate(sec, v))" />
                                    </SettingRow>
                                }
                                <SettingRow Label="Mode" Description="Which of the selected shockers react.">
                                    <Select TValue="string" Label="Mode" Class="[&_label]:sr-only" Value="@sec.Incremental.Mode.ToString()" Options="ActionOptions.Modes"
                                            ValueChanged="@(value => UpdateIncrementalMode(sec, ActionOptions.ParseMode(value)))" />
                                </SettingRow>
                                <SettingRow Label="One sub" Description="Intensity and duration for a single sub.">
                                    <div class="flex gap-2">
                                        <NumberField Label="Intensity for one sub" Class="w-28 [&_label]:sr-only" Suffix="%" Min="1" Max="100" Value="sec.Incremental.BaseIntensity"
                                                     ValueChanged="@(v => UpdateIncrementalBaseIntensity(sec, (int)v))" />
                                        <NumberField Label="Duration for one sub" Class="w-28 [&_label]:sr-only" Suffix="s" Min="0.1" Max="15" Step="0.1" Value="sec.Incremental.BaseDuration"
                                                     ValueChanged="@(v => UpdateIncrementalBaseDuration(sec, v))" />
                                    </div>
                                </SettingRow>
                                <SettingRow Label="Increase per extra sub" Description="Added for each sub after the first, including gifted subs.">
                                    <div class="flex gap-2">
                                        <NumberField Label="Intensity increase per extra sub" Class="w-28 [&_label]:sr-only" Suffix="%" Min="0" Max="100" Value="sec.Incremental.IncrementIntensity"
                                                     ValueChanged="@(v => UpdateIncrementalIntensityIncrement(sec, (int)v))" />
                                        <NumberField Label="Duration increase per extra sub" Class="w-28 [&_label]:sr-only" Suffix="s" Min="0" Max="15" Step="0.1" Value="sec.Incremental.IncrementDuration"
                                                     ValueChanged="@(v => UpdateIncrementalDurationIncrement(sec, v))" />
                                    </div>
                                </SettingRow>
                                <SettingRow Label="Maximum" Description="The action never goes above these, however many subs.">
                                    <div class="flex gap-2">
                                        <NumberField Label="Maximum intensity" Class="w-28 [&_label]:sr-only" Suffix="%" Min="1" Max="100" Value="sec.Incremental.MaxIntensity"
                                                     ValueChanged="@(v => UpdateIncrementalMaxIntensity(sec, (int)v))" />
                                        <NumberField Label="Maximum duration" Class="w-28 [&_label]:sr-only" Suffix="s" Min="0.1" Max="15" Step="0.1" Value="sec.Incremental.MaxDuration"
                                                     ValueChanged="@(v => UpdateIncrementalMaxDuration(sec, v))" />
                                    </div>
                                </SettingRow>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
    @if (!SubConfigService.Config.Sections.Any())
    {
        <Card>
            <EmptyState Icon="users" Title="No subscription tiers" Description="Tiers 1, 2 and 3 are normally created automatically. Restart MultiShock to recreate them." />
        </Card>
    }

    <details class="panel group/help" data-guided-setup="twitch-subs-help">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-panel px-4 py-3 [&::-webkit-details-marker]:hidden">
            <LucideIcon Name="chevron-right" Size="16" Class="shrink-0 text-app-muted transition-transform group-open/help:rotate-90" />
            <span class="panel-title">How it works</span>
        </summary>
        <div class="space-y-2 border-t border-app-border p-4 text-sm text-app-muted">
            <p>When a subscription event arrives, the section for its tier is used.</p>
            <p>Brackets match the sub count: 1 for a single sub, or the number of subs in a gift.</p>
            <p>Incremental scaling uses the one-sub values, then adds the increase for each extra sub up to the maximum.</p>
            <p>Resubs only arrive when the viewer shares the resub message in chat.</p>
        </div>
    </details>
</div>

<ConfirmDialog IsOpen="@(PendingCopyTarget != null)" Title="Replace brackets?"
               Message="@($"Tier {PendingCopyTarget?.Tier}'s {ActionOptions.Count(PendingCopyTarget?.Brackets.Count ?? 0, "bracket", "brackets")} and command will be replaced with the ones from {SelectedCheerSectionName}.")"
               ConfirmText="Replace brackets" OnCancel="@(() => PendingCopyTarget = null)" OnConfirm="ConfirmCopyBrackets" />

@code {
    // Use service locator instead of @inject for plugin-specific services
    // This survives hot-reload where the DI container has stale types
    private static readonly string PluginId = TwitchIntegrationPlugin.PluginId;
    private SubscriptionConfigService SubConfigService => PluginServiceLocator.GetRequiredService<SubscriptionConfigService>(PluginId);
    private CheerConfigService CheerConfigService => PluginServiceLocator.GetRequiredService<CheerConfigService>(PluginId);

    private HashSet<string> ExpandedSections = new();
    private string? SelectedCheerSectionIdForImport;
    private SubscriptionTierSection? PendingCopyTarget;

    private string SelectedCheerSectionName =>
        CheerConfigService.Config.Sections.FirstOrDefault(cs => cs.Id == SelectedCheerSectionIdForImport) is { } cs && !string.IsNullOrWhiteSpace(cs.Name)
            ? cs.Name
            : "the selected cheer section";

    private static readonly Select<string>.SelectOption<string>[] SubscriptionModeOptions =
    [
        new(nameof(SubscriptionMode.Brackets), "Brackets"),
        new(nameof(SubscriptionMode.Incremental), "Incremental"),
    ];

    private IReadOnlyList<Select<string>.SelectOption<string>> CheerSectionOptions =>
        CheerConfigService.Config.Sections
            .Select(cs => new Select<string>.SelectOption<string>(cs.Id, string.IsNullOrWhiteSpace(cs.Name) ? "Unnamed section" : cs.Name))
            .ToList();

    protected override void OnInitialized()
    {
        SubConfigService.ConfigChanged += OnConfigChanged;
        var first = SubConfigService.Config.Sections.OrderBy(s => s.Tier).FirstOrDefault();
        if (first != null) ExpandedSections.Add(first.Id);
    }

    private static string SectionDetail(SubscriptionTierSection sec) =>
        sec.Mode == SubscriptionMode.Incremental
            ? $"Incremental · {sec.Incremental.CommandType}"
            : $"{sec.BracketCommandType} · {ActionOptions.Count(sec.Brackets.Count, "bracket", "brackets")}";

    private static string? SectionIssue(SubscriptionTierSection sec)
    {
        var noBrackets = sec.Mode == SubscriptionMode.Brackets && sec.Brackets.Count == 0;
        var noShockers = sec.SelectedShockerIds.Count == 0;
        return (noBrackets, noShockers) switch
        {
            (true, true) => "No brackets or shockers",
            (true, false) => "No brackets",
            (false, true) => "No shockers",
            _ => null,
        };
    }

    private static int BitsPerSub(int tier) => tier switch
    {
        2 => 500,
        3 => 1250,
        _ => 250
    };

    private static SubscriptionMode ParseSubscriptionMode(string? value) =>
        Enum.TryParse<SubscriptionMode>(value, out var result) ? result : SubscriptionMode.Brackets;

    private void OnConfigChanged() => InvokeAsync(StateHasChanged);

    private void ToggleMasterEnabled(bool enabled) => SubConfigService.SetEnabled(enabled);

    private void ToggleSectionExpanded(string sectionId)
    {
        if (!ExpandedSections.Remove(sectionId))
            ExpandedSections.Add(sectionId);
    }

    private void ToggleSectionEnabled(SubscriptionTierSection sec, bool enabled)
    {
        sec.Enabled = enabled;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateSectionMode(SubscriptionTierSection sec, SubscriptionMode mode)
    {
        sec.Mode = mode;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateSectionShockers(SubscriptionTierSection sec, List<string> ids)
    {
        sec.SelectedShockerIds = ids;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalBaseIntensity(SubscriptionTierSection sec, int value)
    {
        sec.Incremental.BaseIntensity = value;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalBaseDuration(SubscriptionTierSection sec, double value)
    {
        sec.Incremental.BaseDuration = value;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalMaxIntensity(SubscriptionTierSection sec, int value)
    {
        sec.Incremental.MaxIntensity = value;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalMaxDuration(SubscriptionTierSection sec, double value)
    {
        sec.Incremental.MaxDuration = value;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalIntensityIncrement(SubscriptionTierSection sec, int value)
    {
        sec.Incremental.IncrementIntensity = value;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalDurationIncrement(SubscriptionTierSection sec, double value)
    {
        sec.Incremental.IncrementDuration = value;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalMode(SubscriptionTierSection sec, SelectionMode mode)
    {
        sec.Incremental.Mode = mode;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalCommandType(SubscriptionTierSection sec, string commandType)
    {
        sec.Incremental.CommandType = commandType;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateSectionFixedAmount(SubscriptionTierSection sec, bool fixedAmount)
    {
        sec.FixedAmount = fixedAmount;
        SubConfigService.UpdateSection(sec);
    }

    private void AddBracket(SubscriptionTierSection sec)
    {
        var bracket = new SubscriptionBracket
        {
            Count = 1,
            Intensity = 50,
            Duration = 1.0,
            Mode = SelectionMode.All
        };
        sec.Brackets.Add(bracket);
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateBracketCount(SubscriptionTierSection sec, SubscriptionBracket bracket, int count)
    {
        bracket.Count = count;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateBracketIntensity(SubscriptionTierSection sec, SubscriptionBracket bracket, int intensity)
    {
        bracket.Intensity = intensity;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateBracketDuration(SubscriptionTierSection sec, SubscriptionBracket bracket, double duration)
    {
        bracket.Duration = duration;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateBracketMode(SubscriptionTierSection sec, SubscriptionBracket bracket, SelectionMode mode)
    {
        bracket.Mode = mode;
        SubConfigService.UpdateSection(sec);
    }

    private void RemoveBracket(SubscriptionTierSection sec, SubscriptionBracket bracket)
    {
        sec.Brackets.RemoveAll(b => b.Id == bracket.Id);
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateBracketCommandType(SubscriptionTierSection sec, string commandType)
    {
        sec.BracketCommandType = commandType;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateSectionWarningVibrate(SubscriptionTierSection sec, bool enabled)
    {
        sec.WarningVibrate = enabled;
        SubConfigService.UpdateSection(sec);
    }

    private void UpdateIncrementalWarningVibrate(SubscriptionTierSection sec, bool enabled)
    {
        sec.Incremental.WarningVibrate = enabled;
        SubConfigService.UpdateSection(sec);
    }

    private void RequestCopyBrackets(SubscriptionTierSection sec)
    {
        if (sec.Brackets.Count > 0)
        {
            PendingCopyTarget = sec;
            return;
        }

        ConvertFromCheerSection(sec);
    }

    private void ConfirmCopyBrackets()
    {
        if (PendingCopyTarget != null) ConvertFromCheerSection(PendingCopyTarget);
        PendingCopyTarget = null;
    }

    private void ConvertFromCheerSection(SubscriptionTierSection sec)
    {
        var source = CheerConfigService.Config.Sections.FirstOrDefault(s => s.Id == SelectedCheerSectionIdForImport);
        if (source == null || !source.Brackets.Any()) return;

        var bitsPerSub = BitsPerSub(sec.Tier);
        sec.Brackets = source.Brackets
            .OrderBy(b => b.BitAmount)
            .Select(b => new SubscriptionBracket
            {
                Count = Math.Max(1, (int)Math.Round((double)b.BitAmount / bitsPerSub)),
                Intensity = b.Intensity,
                Duration = b.Duration,
                Mode = b.Mode
            })
            .ToList();
        sec.BracketCommandType = source.CommandType;
        sec.FixedAmount = source.FixedAmount;

        SubConfigService.UpdateSection(sec);
    }

    public void Dispose()
    {
        SubConfigService.ConfigChanged -= OnConfigChanged;
    }
}
