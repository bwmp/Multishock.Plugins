@page "/plugins/com-multishock-tiktokintegration/coin-goal"
@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@using TikTokIntegration.Components.Config
@implements IDisposable

<div class="space-y-4">
    <div>
        <h1 class="text-xl font-bold text-app-text">Coin Goal</h1>
        <p class="text-sm mt-1 text-app-muted">
            Add up gift coins over time and fire an action every time the running total hits a goal — a meter that
            builds up as viewers send gifts, instead of reacting to each gift on its own.
        </p>
    </div>

    <SimpleActionCard Title="Coin Goal Meter" Icon="target" Config="Service.Config"
        Description="Each completed gift adds its full coin value to the meter. A single large gift can fill the meter more than once and will fire the action for each goal it crosses."
        OnChanged="Save">
        <ExtraTop>
            <div class="flex flex-wrap items-end gap-4">
                <div>
                    <label class="block text-xs font-medium mb-1 text-app-muted">
                        Goal (coins)
                    </label>
                    <NumberInput Value="@((double)Service.Config.GoalAmount)" Min="1" Max="1000000" Class="w-32"
                        ValueChanged="@(v => UpdateGoal(v))" />
                </div>
                <div class="flex items-center gap-2 pb-1">
                    <Toggle Label="Reset when stream ends" Value="Service.Config.ResetOnStreamEnd"
                        ValueChanged="@(v => Service.SetResetOnStreamEnd(v))" />
                </div>
            </div>

            <div class="space-y-1">
                <div class="flex items-center justify-between text-xs text-app-muted">
                    <span>Progress</span>
                    <span>@Service.Accumulated / @Service.Config.GoalAmount coins</span>
                </div>
                <div class="w-full h-3 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.08);">
                    <div class="h-full rounded-full transition-all"
                        style="width: @($"{Service.ProgressFraction * 100:0.#}%"); background: linear-gradient(90deg, #fe2c55, #ff6b81);"></div>
                </div>
                <div class="flex items-center justify-between pt-1">
                    <span class="text-xs text-app-muted">
                        Reached @Service.TimesReached time@(Service.TimesReached == 1 ? "" : "s") this session
                    </span>
                    <Button Text="Reset progress" Variant="secondary" Size="sm" OnClick="@(() => Service.Reset())" />
                </div>
            </div>
        </ExtraTop>
    </SimpleActionCard>
</div>

@code {
    private static readonly string PluginId = TikTokIntegrationPlugin.PluginId;
    private CoinGoalService Service => PluginServiceLocator.GetRequiredService<CoinGoalService>(PluginId);

    protected override void OnInitialized()
    {
        Service.ConfigChanged += OnChanged;
        Service.ProgressChanged += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Save() => Service.SaveConfig();

    private void UpdateGoal(double? value) => Service.SetGoalAmount((int)Math.Clamp(value ?? 100, 1, 1000000));

    public void Dispose()
    {
        Service.ConfigChanged -= OnChanged;
        Service.ProgressChanged -= OnChanged;
    }
}
