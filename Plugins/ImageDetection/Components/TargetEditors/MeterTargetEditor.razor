@inject ImageDetectionService DetectionService
@inject ImageConfigService ConfigService
@inject IScreenCaptureService CaptureService
@inject ValueChangeAnalyzerService ValueAnalyzer
@inject IPluginHost PluginHost

@* Meter/healthbar target editor: setup warning, live value, region selection,
   and detection settings. Action settings live in ActionSettingsCard. *@

@{
    var regionConfigured = Image.Region.CustomRegion != null
        && (Image.Region.CustomRegion.X != 0 || Image.Region.CustomRegion.Y != 0
            || !string.IsNullOrEmpty(Image.Meter.RegionPreviewPath));
}

@if (!regionConfigured)
{
    <Alert Variant="warning" Title="Setup required: select your health bar region">
        Use the region picker below to select where the health bar appears on screen.
        This is required before detection can work.
    </Alert>
}

@if (DetectionService.IsRunning && !string.IsNullOrEmpty(ModuleId))
{
    var currentVal = GetMeterCurrentValue();
    <div class="rounded-panel border border-app-border bg-app-surface p-3" role="status">
        <div class="mb-2 flex items-center justify-between">
            <span class="text-xs font-medium text-app-muted">Live fill level</span>
            @if (currentVal.HasValue)
            {
                <span class="font-mono text-sm font-semibold tabular-nums text-app-text">@currentVal.Value.ToString("F1")%</span>
            }
            else
            {
                <span class="text-xs text-app-muted">Waiting for data…</span>
            }
        </div>
        @if (currentVal.HasValue)
        {
            <div class="h-2 w-full overflow-hidden rounded-full bg-app-surface-3">
                <div class="h-full rounded-full bg-app-primary transition-[width] duration-150"
                     style="width: @(currentVal.Value)%"></div>
            </div>
        }
    </div>
}

<Card Title="1. Health bar region" Description="Where the health bar is on your screen.">
    <div class="space-y-4">
        @if (!string.IsNullOrEmpty(Image.Meter.RegionPreviewPath) && File.Exists(Image.Meter.RegionPreviewPath))
        {
            <div>
                <span class="mb-1.5 block text-xs font-medium text-app-muted">Region preview</span>
                <div class="overflow-hidden rounded-ctl border border-app-border bg-app-surface-2">
                    <img src="@EditorUi.GetImageDataUri(Image.Meter.RegionPreviewPath)"
                         alt="Region preview"
                         class="max-w-full max-h-24 mx-auto object-contain" />
                </div>
                <span class="mt-1 block font-mono text-xs text-app-muted">
                    @(Image.Region.CustomRegion != null
                        ? $"{Image.Region.CustomRegion.Width} x {Image.Region.CustomRegion.Height} px at ({Image.Region.CustomRegion.X}, {Image.Region.CustomRegion.Y})"
                        : "")
                </span>
            </div>
        }

        <p class="text-xs text-app-muted">
            Take a screenshot of your game, then draw a box around the health bar.
            For best results, select just the filled portion of the bar (avoid borders and text).
        </p>

        <RegionPickerControls ModuleId="@ModuleId" TargetId="@Image.Id" OnCaptureRequested="OnPickRegion" />

        <details class="rounded-ctl border border-app-border px-3 py-2">
            <summary class="cursor-pointer text-sm text-app-muted hover:text-app-text">Manual coordinates</summary>
            <div class="mt-3">
                <ManualRegionInputs ModuleId="@ModuleId" Image="Image" />
            </div>
        </details>
    </div>
</Card>

<Card Title="2. Reading the bar" Description="How the health bar is read and which changes count.">
    <div class="space-y-3">

        <Select Label="Fill direction" TValue="MeterFillDirection"
                Value="Image.Meter.Direction"
                ValueChanged="OnMeterDirectionChangedSelect"
                Options="MeterDirectionOptions"
                Description="The direction the bar grows as it fills." />

        <Checkbox Label="Decreases only (damage)" Description="Only trigger when the bar goes down. Ignores healing and regeneration."
                  Value="Image.Meter.DecreasesOnly" ValueChanged="OnDecreasesOnlyChanged" />

        <Slider Label="Minimum change (%)" Value="Image.Meter.MinDeltaPercent"
                ValueChanged="UpdateMeterMinDelta"
                Min="0.5" Max="20" Step="0.5" Filled="true" ShowValueDirection="right" />
        <p class="text-xs text-app-muted -mt-2">
            Ignore changes smaller than this. Increase if you get false triggers from bar animations.
        </p>
        <div class="space-y-3 rounded-ctl border border-app-border px-3 py-3">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <span class="text-sm font-medium text-app-text">Bar color</span>
                    <p class="text-xs text-app-muted mt-0.5">
                        @if (Image.Meter.UseColorHint && Image.Meter.ColorHint != null)
                        {
                            @($"Active: hue {Image.Meter.ColorHint.HueMin}–{Image.Meter.ColorHint.HueMax}")
                        }
                        else
                        {
                            @("Not set. Using brightness-based detection.")
                        }
                    </p>
                </div>
                @if (Image.Meter.UseColorHint)
                {
                    <Button Text="Re-detect" Size="sm" Variant="secondary" OnClick="RedetectBarColor" />
                }
            </div>

            <Checkbox Label="Use color filtering" Description="Filter by the bar's color for more accurate readings"
                      Value="Image.Meter.UseColorHint" ValueChanged="OnUseColorHintChanged" />

            @if (Image.Meter.UseColorHint)
            {
                <div class="space-y-2">
                    <div class="text-xs font-medium text-app-muted">Color preset</div>
                    <div class="flex flex-wrap gap-2">
                        <Button Text="Green" Size="sm" Variant="secondary" OnClick="@(() => ApplyColorPreset("green"))" />
                        <Button Text="Red" Size="sm" Variant="secondary" OnClick="@(() => ApplyColorPreset("red"))" />
                        <Button Text="Blue" Size="sm" Variant="secondary" OnClick="@(() => ApplyColorPreset("blue"))" />
                        <Button Text="Yellow" Size="sm" Variant="secondary" OnClick="@(() => ApplyColorPreset("yellow"))" />
                        <Button Text="White" Size="sm" Variant="secondary" OnClick="@(() => ApplyColorPreset("white"))" />
                    </div>

                    @if (Image.Meter.ColorHint != null)
                    {
                        <details class="rounded-ctl border border-app-border px-2 py-1.5">
                            <summary class="cursor-pointer text-xs text-app-muted hover:text-app-text">Manual HSV tuning</summary>
                            <div class="mt-2 space-y-2">
                                <div class="grid grid-cols-2 gap-2">
                                    <ValidatedNumberInput Label="Hue min" Value="(double)Image.Meter.ColorHint.HueMin"
                                                 ValueChanged="@(v => UpdateColorHint(h => h.HueMin = (int)Math.Clamp(v ?? 0, 0, 180)))"
                                                 Min="0" Max="180" Step="1" />
                                    <ValidatedNumberInput Label="Hue max" Value="(double)Image.Meter.ColorHint.HueMax"
                                                 ValueChanged="@(v => UpdateColorHint(h => h.HueMax = (int)Math.Clamp(v ?? 0, 0, 180)))"
                                                 Min="0" Max="180" Step="1" />
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <ValidatedNumberInput Label="Saturation min" Value="(double)Image.Meter.ColorHint.SatMin"
                                                 ValueChanged="@(v => UpdateColorHint(h => h.SatMin = (int)Math.Clamp(v ?? 0, 0, 255)))"
                                                 Min="0" Max="255" Step="1" />
                                    <ValidatedNumberInput Label="Saturation max" Value="(double)Image.Meter.ColorHint.SatMax"
                                                 ValueChanged="@(v => UpdateColorHint(h => h.SatMax = (int)Math.Clamp(v ?? 0, 0, 255)))"
                                                 Min="0" Max="255" Step="1" />
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <ValidatedNumberInput Label="Brightness min" Value="(double)Image.Meter.ColorHint.ValMin"
                                                 ValueChanged="@(v => UpdateColorHint(h => h.ValMin = (int)Math.Clamp(v ?? 0, 0, 255)))"
                                                 Min="0" Max="255" Step="1" />
                                    <ValidatedNumberInput Label="Brightness max" Value="(double)Image.Meter.ColorHint.ValMax"
                                                 ValueChanged="@(v => UpdateColorHint(h => h.ValMax = (int)Math.Clamp(v ?? 0, 0, 255)))"
                                                 Min="0" Max="255" Step="1" />
                                </div>
                            </div>
                        </details>
                    }
                </div>
            }
        </div>
        <details class="rounded-ctl border border-app-border px-3 py-2">
            <summary class="cursor-pointer text-sm text-app-muted hover:text-app-text">Advanced tuning</summary>
            <div class="mt-3 space-y-3">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <ValidatedNumberInput Label="Smoothing frames" Value="(double)Image.Meter.SmoothingFrames"
                                     ValueChanged="OnMeterSmoothingChanged"
                                     Min="1" Max="10" Step="1" />
                        <p class="text-xs text-app-muted mt-1">Averages this many readings to reduce noise. Higher = more stable but slower to react.</p>
                    </div>
                    <div>
                        <ValidatedNumberInput Label="Event cooldown" Value="(double)Image.Meter.EventCooldownMs"
                                     ValueChanged="OnMeterCooldownChanged"
                                     Min="50" Max="5000" Step="50" Suffix="ms" />
                        <p class="text-xs text-app-muted mt-1">Minimum time between triggers. Prevents rapid repeated activations.</p>
                    </div>
                </div>

                <div>
                    <Slider Label="Fill sensitivity" Value="Image.Meter.FillSensitivity"
                            ValueChanged="OnMeterFillSensitivityChanged"
                            Min="0.05" Max="0.95" Step="0.05" Filled="true" ShowValueDirection="right" />
                    <p class="text-xs text-app-muted mt-1">
                        How much of a column must be lit to count as filled.
                        Lower tolerates borders/anti-aliasing; raise it if glow or bloom
                        around the bar inflates the reading.
                    </p>
                </div>

                <Checkbox Label="Require focused window" Description="Only track when a specific window is in the foreground"
                          Value="Image.Meter.RequireFocusedWindow" ValueChanged="OnRequireFocusedWindowChanged" />

                @if (Image.Meter.RequireFocusedWindow)
                {
                    <div class="pl-6 space-y-2">
                        <div class="flex gap-2 items-end">
                            <div class="flex-1">
                                <Select Label="Required window" TValue="string"
                                        Value="GetRequiredWindowSelectionKey()"
                                        ValueChanged="OnRequiredFocusWindowSelect"
                                        Placeholder="Select a window…"
                                        Options="GetFocusWindowOptions()" />
                            </div>
                            <Button Text="Refresh" Size="sm" Variant="secondary" OnClick="RefreshWindowOptions" />
                        </div>
                    </div>
                }
            </div>
        </details>
    </div>
</Card>

@code {
    [Parameter, EditorRequired] public string ModuleId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public DetectionImage Image { get; set; } = default!;

    /// <summary>Asks the host editor to capture a screenshot and open the region picker.</summary>
    [Parameter] public EventCallback OnPickRegion { get; set; }

    private static readonly IEnumerable<Select<MeterFillDirection>.SelectOption<MeterFillDirection>> MeterDirectionOptions =
    [
        new(MeterFillDirection.LeftToRight, "Left to right"),
        new(MeterFillDirection.RightToLeft, "Right to left"),
        new(MeterFillDirection.BottomToTop, "Bottom to top"),
        new(MeterFillDirection.TopToBottom, "Top to bottom"),
    ];

    private List<WindowInfo> AvailableWindows = [];

    protected override void OnInitialized()
    {
        AvailableWindows = CaptureService.GetWindows();
    }

    private void Save() => ConfigService.UpdateImage(ModuleId, Image);

    private double? GetMeterCurrentValue()
    {
        try
        {
            return ValueAnalyzer.GetCurrentValue(ModuleId, Image.Id);
        }
        catch
        {
            return null;
        }
    }

    private void OnMeterDirectionChangedSelect(MeterFillDirection direction)
    {
        Image.Meter.Direction = direction;
        Save();
    }

    private void OnDecreasesOnlyChanged(bool value)
    {
        Image.Meter.DecreasesOnly = value;
        Save();
    }

    private void UpdateMeterMinDelta(double value)
    {
        Image.Meter.MinDeltaPercent = Math.Clamp(value, 0.5, 20);
        Save();
    }

    private void OnMeterSmoothingChanged(double? value)
    {
        if (value == null) return;
        Image.Meter.SmoothingFrames = (int)Math.Clamp(value.Value, 1, 10);
        Save();
    }

    private void OnMeterCooldownChanged(double? value)
    {
        if (value == null) return;
        Image.Meter.EventCooldownMs = (int)Math.Clamp(value.Value, 50, 5000);
        Save();
    }

    private void OnMeterFillSensitivityChanged(double value)
    {
        Image.Meter.FillSensitivity = Math.Clamp(value, 0.05, 0.95);
        Save();
    }

    private void OnRequireFocusedWindowChanged(bool value)
    {
        Image.Meter.RequireFocusedWindow = value;

        if (!value)
        {
            Image.Meter.RequiredFocusWindowProcess = null;
            Image.Meter.RequiredFocusWindowTitle = null;
        }

        Save();
    }

    private void OnRequiredFocusWindowSelect(string value)
    {
        var split = value.Split('|', 2);
        Image.Meter.RequiredFocusWindowProcess = split.Length > 0 ? split[0] : null;
        Image.Meter.RequiredFocusWindowTitle = split.Length > 1 ? split[1] : null;
        Save();
    }

    private string GetRequiredWindowSelectionKey()
    {
        var process = Image.Meter.RequiredFocusWindowProcess ?? string.Empty;
        var title = Image.Meter.RequiredFocusWindowTitle ?? string.Empty;
        return $"{process}|{title}";
    }

    private IEnumerable<Select<string>.SelectOption<string>> GetFocusWindowOptions()
    {
        return AvailableWindows
            .OrderBy(w => w.ProcessName)
            .ThenBy(w => w.Title)
            .Select(w => new Select<string>.SelectOption<string>(
                $"{w.ProcessName}|{w.Title}",
                string.IsNullOrWhiteSpace(w.ProcessName) ? w.Title : $"{w.ProcessName} - {w.Title}"));
    }

    private void RefreshWindowOptions()
    {
        AvailableWindows = CaptureService.GetWindows();
        StateHasChanged();
    }

    private void OnUseColorHintChanged(bool value)
    {
        Image.Meter.UseColorHint = value;
        if (value && Image.Meter.ColorHint == null)
        {
            Image.Meter.ColorHint = HsvRange.Green;
        }
        Save();
    }

    private void ApplyColorPreset(string preset)
    {
        Image.Meter.ColorHint = preset switch
        {
            "green" => HsvRange.Green,
            "red" => HsvRange.Red,
            "blue" => HsvRange.Blue,
            "yellow" => HsvRange.Yellow,
            "white" => HsvRange.White,
            _ => HsvRange.Green
        };
        Save();
    }

    private void UpdateColorHint(Action<HsvRange> update)
    {
        if (Image.Meter.ColorHint == null) return;
        update(Image.Meter.ColorHint);
        Save();
    }

    private void RedetectBarColor()
    {
        var previewPath = Image.Meter.RegionPreviewPath;
        if (!string.IsNullOrEmpty(previewPath) && File.Exists(previewPath))
        {
            try
            {
                using var previewMat = Emgu.CV.CvInvoke.Imread(previewPath, Emgu.CV.CvEnum.ImreadModes.Unchanged);
                if (previewMat != null && !previewMat.IsEmpty)
                {
                    var autoHsv = ImageDetection.Algorithms.MeterFillAlgorithm.ComputeDominantHsvRange(previewMat);
                    if (autoHsv != null)
                    {
                        Image.Meter.ColorHint = autoHsv;
                        Image.Meter.UseColorHint = true;
                        Save();
                        PluginHost.ShowSuccessToast("Color updated", $"Detected hue range {autoHsv.HueMin}-{autoHsv.HueMax}");
                        return;
                    }
                }
            }
            catch
            {
            }
        }

        if (Image.Region.CustomRegion != null)
        {
            try
            {
                using var screenshot = CaptureService.CaptureMonitor(ConfigService.CaptureConfig.MonitorIndex);
                var region = Image.Region.CustomRegion;
                using var subMat = new Emgu.CV.Mat(screenshot,
                    new System.Drawing.Rectangle(
                        Math.Max(0, region.X), Math.Max(0, region.Y),
                        Math.Min(region.Width, screenshot.Width - Math.Max(0, region.X)),
                        Math.Min(region.Height, screenshot.Height - Math.Max(0, region.Y))));
                using var roiClone = subMat.Clone();

                var autoHsv = ImageDetection.Algorithms.MeterFillAlgorithm.ComputeDominantHsvRange(roiClone);
                if (autoHsv != null)
                {
                    Image.Meter.ColorHint = autoHsv;
                    Image.Meter.UseColorHint = true;
                    Save();
                    PluginHost.ShowSuccessToast("Color updated", $"Detected hue range {autoHsv.HueMin}-{autoHsv.HueMax}");
                    return;
                }
            }
            catch (Exception ex)
            {
                PluginHost.ShowErrorToast("Re-detect failed", $"Failed to re-detect color: {ex.Message}");
                return;
            }
        }

        PluginHost.ShowErrorToast("Re-detect failed", "Could not detect bar color. Try re-picking the region first.");
    }
}
