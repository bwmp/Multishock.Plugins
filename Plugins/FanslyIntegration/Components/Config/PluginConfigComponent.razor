@using MultiShock.PluginSdk
@implements IDisposable

<div class="space-y-4">
    <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full @(Connection.IsConnected ? "bg-app-success" : "bg-app-subtle")"></div>
        <span class="text-sm font-medium">
            @if (Connection.IsConnected)
            {
                <span>Connected to Fansly</span>
            }
            else if (Connection.IsConnecting)
            {
                <span>Connecting...</span>
            }
            else
            {
                <span>Not connected</span>
            }
        </span>
    </div>

    <p class="text-sm text-app-subtle">
        Set up your account token and connection on the
        <a href="/plugins/com-multishock-fanslyintegration/fanslyintegration" class="fsl-brand hover:underline">
            Fansly page
        </a>.
    </p>

    <div class="text-xs text-app-muted space-y-1">
        <div><strong>Supported Events:</strong></div>
        <ul class="list-disc list-inside ml-2">
            <li>Tips (with token minimums)</li>
            <li>Chat messages (with text filters &amp; bot commands)</li>
            <li>Follows</li>
            <li>Subscriptions (including gifted)</li>
            <li>Stream state changes</li>
        </ul>
    </div>
</div>

@code {
    private static readonly string PluginId = FanslyIntegrationPlugin.PluginId;
    private FanslyConnectionService Connection => PluginServiceLocator.GetRequiredService<FanslyConnectionService>(PluginId);

    [Parameter]
    public string? PluginId_ { get; set; }

    protected override void OnInitialized()
    {
        Connection.ConnectionStateChanged += OnConnectionChanged;
    }

    private void OnConnectionChanged(bool connected) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connection.ConnectionStateChanged -= OnConnectionChanged;
    }
}
