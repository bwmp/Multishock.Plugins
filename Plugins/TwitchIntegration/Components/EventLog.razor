@implements IAsyncDisposable

<Card Title="Event log" Description="Events from this session, newest first." NoPadding="true">
    <Actions>
        @if (_entries.Count > 0)
        {
            <Button Variant="ghost" Size="sm" Icon="trash-2" Text="Clear" OnClick="ClearLog" />
        }
    </Actions>
    <ChildContent>
        @if (_entries.Count == 0)
        {
            <div class="px-4 py-6">
                <p class="text-sm text-app-muted">No events yet.</p>
                <p class="mt-0.5 text-xs text-app-subtle">
                    @(TwitchService.IsConnected
                        ? "Cheers, subs, follows and reactions appear here as they happen."
                        : "Cheers, subs, follows and connection messages appear here once you connect.")
                </p>
            </div>
        }
        else
        {
            <ol class="max-h-80 divide-y divide-app-border overflow-y-auto" aria-label="Twitch events">
                @foreach (var log in _entries)
                {
                    <li class="flex items-start gap-3 px-4 py-2 text-sm">
                        <time class="shrink-0 pt-px font-mono text-xs text-app-subtle">@log.Time.ToString("HH:mm:ss")</time>
                        @if (log.IsError)
                        {
                            <span class="flex min-w-0 items-start gap-1.5 text-app-danger">
                                <LucideIcon Name="alert-circle" Size="14" Class="mt-0.5 shrink-0" />
                                <span class="break-words">@log.Message</span>
                            </span>
                        }
                        else
                        {
                            <span class="min-w-0 break-words text-app-text">@log.Message</span>
                        }
                    </li>
                }
            </ol>
        }
    </ChildContent>
</Card>

@code {
    private EventLogService LogService => PluginServiceLocator.GetRequiredService<EventLogService>(TwitchIntegrationPlugin.PluginId);
    private TwitchEventSubService TwitchService => PluginServiceLocator.GetRequiredService<TwitchEventSubService>(TwitchIntegrationPlugin.PluginId);
    private readonly CancellationTokenSource _refreshCts = new();
    private IReadOnlyList<EventLogService.LogEntry> _entries = [];
    private Task? _refreshTask;
    private int _dirty;
    private bool _disposed;

    protected override void OnInitialized()
    {
        LogService.LogChanged += OnLogChanged;
        _entries = LogService.GetRecentEntries(50);
        _refreshTask = Task.Run(RefreshAsync);
    }

    private void OnLogChanged() => Interlocked.Exchange(ref _dirty, 1);

    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
        try
        {
            while (await timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                if (Interlocked.Exchange(ref _dirty, 0) == 0) continue;
                await InvokeAsync(() =>
                {
                    if (_disposed) return;
                    _entries = LogService.GetRecentEntries(50);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_refreshCts.IsCancellationRequested) { }
    }

    private void ClearLog()
    {
        LogService.Clear();
        _entries = [];
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        LogService.LogChanged -= OnLogChanged;
        await _refreshCts.CancelAsync();
        if (_refreshTask != null) await _refreshTask;
        _refreshCts.Dispose();
    }
}
