@using MultiShock.PluginSdk
@implements IDisposable

<div class="space-y-3">
    <div class="flex flex-wrap items-center gap-2">
        <ConnectionChip Connected="TwitchService.IsConnected" Connecting="TwitchService.IsConnecting" Reconnecting="TwitchService.IsReconnecting" />
        @if (TwitchService.IsConnected && !string.IsNullOrEmpty(TwitchService.CurrentUserName))
        {
            <span class="text-sm text-app-muted">@TwitchService.CurrentUserName</span>
        }
    </div>
    <p class="text-sm text-app-muted">Set up the connection and reactions on the Twitch page.</p>
    <NavButton Href="/plugins/com-multishock-twitchintegration/twitchintegration" Text="Open Twitch page" />
</div>

@code {
    private static readonly string OwnPluginId = TwitchIntegrationPlugin.PluginId;
    private TwitchEventSubService TwitchService => PluginServiceLocator.GetRequiredService<TwitchEventSubService>(OwnPluginId);

    [Parameter]
    public string? PluginId { get; set; }

    protected override void OnInitialized()
    {
        TwitchService.ConnectionStateChanged += OnConnectionChanged;
        TwitchService.ErrorOccurred += OnError;
    }

    private void OnConnectionChanged(bool connected) => InvokeAsync(StateHasChanged);

    private void OnError(string _) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        TwitchService.ConnectionStateChanged -= OnConnectionChanged;
        TwitchService.ErrorOccurred -= OnError;
    }
}
