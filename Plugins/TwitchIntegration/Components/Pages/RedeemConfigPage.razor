@page "/plugins/com-multishock-twitchintegration/redeem-config"
@using MultiShock.PluginSdk
@implements IDisposable

<PageHeader Title="Channel points" Icon="ticket" Description="React when viewers redeem your channel point rewards. Reactions save automatically; reward details save to Twitch with Save changes.">
    <Breadcrumb><BackLink /></Breadcrumb>
    <Actions>
        <Toggle Label="Enabled" AriaLabel="Enable channel point reactions" Value="RedeemConfigService.Config.Enabled" ValueChanged="ToggleMasterEnabled" />
        <Button Text="Refresh rewards" Icon="refresh-cw" Variant="secondary" Loading="RedeemConfigService.IsFetchingRedeems" OnClick="FetchRewards" />
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!RedeemConfigService.Config.Enabled)
    {
        <Alert Variant="neutral">Channel point reactions are off. You can set up rewards now; nothing runs until you switch on Enabled. Redemptions still reach your flows.</Alert>
    }

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        @if (StatusIsSuccess)
        {
            <p role="status" class="text-sm text-app-muted">@StatusMessage</p>
        }
        else
        {
            <Alert Variant="danger">@StatusMessage</Alert>
        }
    }

    <div class="flex flex-wrap items-center justify-between gap-3">
        <Tabs Items="RewardTabs" @bind-Value="ActiveTab" />
        <span class="text-xs text-app-muted">
            @(RedeemConfigService.Config.LastFetchedUtc.HasValue
                ? $"Last fetched {RedeemConfigService.Config.LastFetchedUtc.Value.ToLocalTime():g}"
                : "Rewards not fetched yet")
        </span>
    </div>

    <div class="space-y-3">
        @if (ActiveTab == "manageable")
        {
            var manageableRewards = RedeemConfigService.Config.Redeems.Where(r => r.IsManageable).OrderBy(r => r.RewardTitle).ToList();

            @if (ShowCreateForm)
            {
                <Card Title="Create reward" Description="Creates the reward on Twitch immediately. Only rewards created here can be turned on or off by a flow.">
                    <div class="grid gap-4 sm:grid-cols-2">
                        <TextInput Label="Title" Value="@NewRewardTitle" ValueChanged="@(v => NewRewardTitle = v ?? string.Empty)" />
                        <NumberInput Label="Cost" Suffix="pts" Min="1" Max="MaxRewardCost" Value="NewRewardCost" Error="@NewRewardCostError" ValueChanged="@(v => NewRewardCost = v)" />
                        <div class="sm:col-span-2">
                            <TextArea Label="Description (optional)" Rows="2" Value="@NewRewardPrompt" ValueChanged="@(v => NewRewardPrompt = v ?? string.Empty)" />
                        </div>
                    </div>
                    <div class="mt-4 flex items-center justify-end gap-3 border-t border-app-border pt-3">
                        <Button Text="Cancel" Variant="ghost" OnClick="@(() => { ShowCreateForm = false; ResetCreateForm(); })" />
                        <Button Text="Create reward" Variant="primary" Loading="IsCreatingReward" Disabled="@(NewRewardCostError != null)" Title="@(NewRewardCostError == null ? null : "Correct the cost first")" OnClick="CreateReward" />
                    </div>
                </Card>
            }
            else if (manageableRewards.Any())
            {
                <div>
                    <Button Text="Create reward" Icon="plus" Variant="secondary" Size="sm" OnClick="@(() => ShowCreateForm = true)" />
                </div>
            }

            @foreach (var redeem in manageableRewards)
            {
                @RenderRedeemCard(redeem)
            }

            @if (!manageableRewards.Any() && !ShowCreateForm)
            {
                <Card>
                    <EmptyState Icon="ticket" Title="No rewards created here" Description="Rewards you create here can also be turned on and off by a flow.">
                        <Actions><Button Text="Create reward" Icon="plus" Variant="primary" OnClick="@(() => ShowCreateForm = true)" /></Actions>
                    </EmptyState>
                </Card>
            }
        }
        else
        {
            @if (RedeemConfigService.Config.Redeems.Any())
            {
                @foreach (var redeem in RedeemConfigService.Config.Redeems.OrderBy(r => r.RewardTitle))
                {
                    @RenderRedeemCard(redeem)
                }
            }
            else
            {
                <Card>
                    <EmptyState Icon="ticket" Title="No channel point rewards yet" Description="Load your channel point rewards from Twitch to give each one a reaction.">
                        <Actions><Button Text="Refresh rewards" Icon="refresh-cw" Variant="primary" Loading="RedeemConfigService.IsFetchingRedeems" OnClick="FetchRewards" /></Actions>
                    </EmptyState>
                </Card>
            }
        }

        <details class="panel group/help">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-panel px-4 py-3 [&::-webkit-details-marker]:hidden">
                <LucideIcon Name="chevron-right" Size="16" Class="shrink-0 text-app-muted transition-transform group-open/help:rotate-90" />
                <span class="panel-title">How it works</span>
            </summary>
            <ul class="list-disc space-y-1 border-t border-app-border p-4 pl-8 text-sm text-app-muted">
                <li>Refresh rewards loads your channel point rewards from Twitch. Each reward can have its own shockers, intensity and duration.</li>
                <li>All rewards lists every reward on your channel. You can set a reaction for any of them.</li>
                <li>Created here lists rewards made on this page. Only these can be edited, deleted, or turned on and off with the Set Redeem Enabled flow node.</li>
            </ul>
        </details>
    </div>
</div>

<ConfirmDialog IsOpen="@(PendingDelete != null)" Title="Delete reward?"
               Message="@($"{PendingDelete?.RewardTitle} will be deleted from your Twitch channel. Viewers can no longer redeem it. This can't be undone.")"
               ConfirmText="Delete reward" IsConfirming="IsDeleting" OnCancel="@(() => PendingDelete = null)" OnConfirm="ConfirmDeleteReward" />

@code {
    // Use service locator instead of @inject for plugin-specific services
    // This survives hot-reload where the DI container has stale types
    private static readonly string PluginId = TwitchIntegrationPlugin.PluginId;
    private RedeemConfigService RedeemConfigService => PluginServiceLocator.GetRequiredService<RedeemConfigService>(PluginId);

    private IReadOnlyList<Tabs.TabItem> RewardTabs => [
        new("all", "All rewards", Badge: RedeemConfigService.Config.Redeems.Count.ToString()),
        new("manageable", "Created here", Badge: RedeemConfigService.Config.Redeems.Count(r => r.IsManageable).ToString())];
    private string ActiveTab = "all";
    private HashSet<string> ExpandedRedeems = new();
    private string? StatusMessage;
    private bool StatusIsSuccess;

    private bool ShowCreateForm = false;
    private bool IsCreatingReward = false;
    private string NewRewardTitle = "";
    private double? NewRewardCost = 100;
    private string NewRewardPrompt = "";

    private string? EditingRewardId = null;
    private string EditRewardTitle = "";
    private double? EditRewardCost = 100;

    private const int MaxRewardCost = int.MaxValue;
    private string? NewRewardCostError => NumberField.Validate(NewRewardCost, 1, MaxRewardCost, 1);
    private string? EditRewardCostError => NumberField.Validate(EditRewardCost, 1, MaxRewardCost, 1);
    private string EditRewardPrompt = "";

    private RedeemConfig? PendingDelete;
    private bool IsDeleting;

    protected override void OnInitialized()
    {
        RedeemConfigService.ConfigChanged += OnConfigChanged;
        foreach (var redeem in RedeemConfigService.Config.Redeems)
        {
            ExpandedRedeems.Add(redeem.Id);
        }
    }

    private RenderFragment RenderRedeemCard(RedeemConfig redeem) => __builder =>
    {
        var isEditing = EditingRewardId == redeem.RewardId;
        var expanded = ExpandedRedeems.Contains(redeem.Id);
        var title = string.IsNullOrWhiteSpace(redeem.RewardTitle) ? "Untitled reward" : redeem.RewardTitle;

        <section class="panel" @key="redeem.Id" aria-label="@title">
            <div class="@($"flex flex-wrap items-center gap-x-2 gap-y-1 px-3 py-2 {(expanded ? "border-b border-app-border" : "")}")">
                <button type="button" class="flex min-w-0 flex-1 items-center gap-2 rounded-ctl py-1 text-left"
                        aria-expanded="@(expanded ? "true" : "false")" aria-controls="@(expanded ? $"reward-{redeem.Id}" : null)"
                        @onclick="@(() => ToggleExpanded(redeem.Id))">
                    <LucideIcon Name="chevron-right" Size="16" Class="@($"shrink-0 text-app-muted transition-transform {(expanded ? "rotate-90" : "")}")" />
                    <span class="min-w-0">
                        <span class="flex items-center gap-2">
                            <span class="truncate text-sm font-medium text-app-text">@title</span>
                            @if (redeem.IsManageable)
                            {
                                <Badge>Created here</Badge>
                            }
                        </span>
                        <span class="block truncate text-xs text-app-subtle">@redeem.Cost points · @redeem.CommandType @redeem.Intensity% for @redeem.Duration.ToString("0.0") s</span>
                    </span>
                </button>
                @if (redeem.Enabled && redeem.SelectedShockerIds.Count == 0)
                {
                    <SummaryChip Summary="@(new ReactionSummary(RedeemConfigService.Config.Enabled ? ReactionStatus.Attention : ReactionStatus.Off, "No shockers"))" />
                }
                <Toggle AriaLabel="@($"React to {title}")" Value="redeem.Enabled" ValueChanged="@(e => ToggleRedeemEnabled(redeem, e))" />
            </div>

            @if (expanded)
            {
                <div id="@($"reward-{redeem.Id}")" class="panel-body">
                    @if (redeem.IsManageable && isEditing)
                    {
                        <div class="mb-4 space-y-4 border-b border-app-border pb-4">
                            <h3 class="text-sm font-medium text-app-text">Edit reward on Twitch</h3>
                            <div class="grid gap-4 sm:grid-cols-2">
                                <TextInput Label="Title" Value="@EditRewardTitle" ValueChanged="@(v => EditRewardTitle = v ?? string.Empty)" />
                                <NumberInput Label="Cost" Suffix="pts" Min="1" Max="MaxRewardCost" Value="EditRewardCost" Error="@EditRewardCostError" ValueChanged="@(v => EditRewardCost = v)" />
                                <div class="sm:col-span-2">
                                    <TextArea Label="Description (optional)" Rows="2" Value="@EditRewardPrompt" ValueChanged="@(v => EditRewardPrompt = v ?? string.Empty)" />
                                </div>
                            </div>
                            <div class="flex items-center justify-end gap-3 border-t border-app-border pt-3">
                                <span role="status" class="text-xs text-app-muted">Saving updates this reward on Twitch immediately.</span>
                                <Button Text="Cancel" Variant="ghost" OnClick="@(() => EditingRewardId = null)" />
                                <Button Text="Save changes" Variant="primary" Disabled="@(EditRewardCostError != null)" Title="@(EditRewardCostError == null ? null : "Correct the cost first")" OnClick="@(() => SaveRewardEdit(redeem.RewardId))" />
                            </div>
                        </div>
                    }

                    <SettingRow Label="Shockers" Description="The shockers this reward can run on.">
                        <Help>
                            @if (redeem.SelectedShockerIds.Count == 0)
                            {
                                <NoShockersHint />
                            }
                        </Help>
                        <ChildContent>
                            <ShockerSelect Label="Shockers" Class="[&_label]:sr-only" MultiSelect="true" SelectedIds="redeem.SelectedShockerIds"
                                           SelectedIdsChanged="@(ids => UpdateShockers(redeem, ids))" />
                        </ChildContent>
                    </SettingRow>
                    <SettingRow Label="Mode" Description="Which of the selected shockers react.">
                        <Select TValue="string" Label="@($"Mode for {title}")" Class="[&_label]:sr-only" Value="@redeem.Mode.ToString()" Options="ActionOptions.Modes"
                                ValueChanged="@(value => UpdateMode(redeem, ActionOptions.ParseMode(value)))" />
                    </SettingRow>
                    <SettingRow Label="Command" Description="What the shockers do.">
                        <Select TValue="string" Label="@($"Command for {title}")" Class="[&_label]:sr-only" Value="@redeem.CommandType" Options="ActionOptions.Commands"
                                ValueChanged="@(value => UpdateCommandType(redeem, value ?? "Shock"))" />
                    </SettingRow>
                    @if (redeem.CommandType == "Shock")
                    {
                        <SettingRow Label="Warning vibrate" Description="Vibrate briefly before each shock.">
                            <Toggle AriaLabel="@($"Warning vibrate for {title}")" Value="redeem.WarningVibrate"
                                    ValueChanged="@(v => UpdateWarningVibrate(redeem, v))" />
                        </SettingRow>
                    }
                    <SettingRow Label="Intensity" Description="How strong the action is.">
                        <NumberField Label="@($"Intensity for {title}")" Class="w-28 [&_label]:sr-only" Suffix="%" Min="1" Max="100" Value="redeem.Intensity"
                                     ValueChanged="@(v => UpdateIntensity(redeem, (int)v))" />
                    </SettingRow>
                    <SettingRow Label="Duration" Description="How long the action lasts.">
                        <NumberField Label="@($"Duration for {title}")" Class="w-28 [&_label]:sr-only" Suffix="s" Min="0.1" Max="15" Step="0.1" Value="redeem.Duration"
                                     ValueChanged="@(v => UpdateDuration(redeem, v))" />
                    </SettingRow>

                    @if (redeem.IsManageable && !isEditing)
                    {
                        <div class="mt-3 flex items-center justify-between gap-2 border-t border-app-border pt-3">
                            <Button Text="Edit reward" Icon="pencil" Variant="secondary" Size="sm" OnClick="@(() => StartEditReward(redeem))" />
                            <Button Variant="ghost" Size="icon-sm" Icon="trash-2" AriaLabel="@($"Delete {title} from Twitch")" Title="Delete reward" OnClick="@(() => PendingDelete = redeem)" />
                        </div>
                    }
                    else if (!redeem.IsManageable)
                    {
                        <p class="mt-3 flex items-start gap-1.5 border-t border-app-border pt-3 text-xs text-app-muted">
                            <LucideIcon Name="info" Size="12" Class="mt-0.5 shrink-0" />
                            <span>Created outside MultiShock. Its reaction works, but the Set Redeem Enabled flow node can't turn it on or off. Create a reward here if you need that.</span>
                        </p>
                    }
                </div>
            }
        </section>
    };

    private void OnConfigChanged() => InvokeAsync(StateHasChanged);

    private void ToggleMasterEnabled(bool enabled) => RedeemConfigService.SetEnabled(enabled);

    private void ToggleExpanded(string redeemId)
    {
        if (!ExpandedRedeems.Remove(redeemId))
            ExpandedRedeems.Add(redeemId);
    }

    private void ToggleRedeemEnabled(RedeemConfig redeem, bool enabled)
    {
        RedeemConfigService.SetRedeemEnabled(redeem.Id, enabled);
    }

    private void UpdateShockers(RedeemConfig redeem, List<string> ids)
    {
        redeem.SelectedShockerIds = ids;
        RedeemConfigService.UpdateRedeem(redeem);
    }

    private void UpdateIntensity(RedeemConfig redeem, int value)
    {
        RedeemConfigService.UpdateRedeemIntensity(redeem.Id, value);
    }

    private void UpdateDuration(RedeemConfig redeem, double value)
    {
        RedeemConfigService.UpdateRedeemDuration(redeem.Id, value);
    }

    private void UpdateMode(RedeemConfig redeem, SelectionMode mode)
    {
        RedeemConfigService.UpdateRedeemMode(redeem.Id, mode);
    }

    private void UpdateCommandType(RedeemConfig redeem, string commandType)
    {
        RedeemConfigService.UpdateRedeemCommandType(redeem.Id, commandType);
    }

    private void UpdateWarningVibrate(RedeemConfig redeem, bool enabled)
    {
        redeem.WarningVibrate = enabled;
        RedeemConfigService.UpdateRedeem(redeem);
    }

    private async Task FetchRewards()
    {
        StatusMessage = null;
        await InvokeAsync(StateHasChanged);

        var result = await RedeemConfigService.FetchRedeemsAsync();
        StatusIsSuccess = result.Success;

        if (result.Success)
        {
            StatusMessage = $"{result.Message} (+{result.AddedCount} new, {result.UpdatedCount} updated)";
            foreach (var redeem in RedeemConfigService.Config.Redeems)
            {
                ExpandedRedeems.Add(redeem.Id);
            }
        }
        else
        {
            StatusMessage = result.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetCreateForm()
    {
        NewRewardTitle = "";
        NewRewardCost = 100;
        NewRewardPrompt = "";
    }

    private async Task CreateReward()
    {
        if (string.IsNullOrWhiteSpace(NewRewardTitle))
        {
            StatusMessage = "Reward title is required";
            StatusIsSuccess = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (NewRewardCostError != null) return;

        IsCreatingReward = true;
        StatusMessage = null;
        await InvokeAsync(StateHasChanged);

        var result = await RedeemConfigService.CreateRewardAsync(
            NewRewardTitle,
            (int)NewRewardCost!.Value,
            string.IsNullOrWhiteSpace(NewRewardPrompt) ? null : NewRewardPrompt
        );

        IsCreatingReward = false;
        StatusIsSuccess = result.Success;
        StatusMessage = result.Message;

        if (result.Success)
        {
            ShowCreateForm = false;
            ResetCreateForm();
            if (result.RewardId != null)
            {
                var redeem = RedeemConfigService.Config.Redeems.FirstOrDefault(r => r.RewardId == result.RewardId);
                if (redeem != null)
                {
                    ExpandedRedeems.Add(redeem.Id);
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void StartEditReward(RedeemConfig redeem)
    {
        EditingRewardId = redeem.RewardId;
        EditRewardTitle = redeem.RewardTitle;
        EditRewardCost = redeem.Cost;
        EditRewardPrompt = "";
    }

    private async Task SaveRewardEdit(string rewardId)
    {
        StatusMessage = null;
        await InvokeAsync(StateHasChanged);

        var result = await RedeemConfigService.UpdateRewardAsync(
            rewardId,
            title: EditRewardTitle,
            cost: (int)EditRewardCost!.Value,
            prompt: string.IsNullOrWhiteSpace(EditRewardPrompt) ? null : EditRewardPrompt
        );

        StatusIsSuccess = result.Success;
        StatusMessage = result.Message;

        if (result.Success)
        {
            EditingRewardId = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmDeleteReward()
    {
        if (PendingDelete == null) return;

        IsDeleting = true;
        StatusMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await RedeemConfigService.DeleteRewardAsync(PendingDelete.RewardId);
            StatusIsSuccess = result.Success;
            StatusMessage = result.Message;
        }
        finally
        {
            IsDeleting = false;
            PendingDelete = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        RedeemConfigService.ConfigChanged -= OnConfigChanged;
    }
}
