@using ImageDetection.Models
@using MultiShock.PluginSdk.Components

<Modal IsOpen="IsVisible" Title="Image resolution" OnClose="Cancel">
    <ChildContent>
        <div class="space-y-4">
            <p class="text-sm text-app-muted">
                Enter the screen resolution this image was captured at. Matching works best when it equals the resolution detection runs at.
            </p>

            <div class="grid grid-cols-2 gap-3">
                <NumberInput Label="Width" Value="Width" Error="@WidthError" ValueChanged="OnWidthChanged" Min="1" Max="10000" Step="1" Suffix="px" />
                <NumberInput Label="Height" Value="Height" Error="@HeightError" ValueChanged="OnHeightChanged" Min="1" Max="10000" Step="1" Suffix="px" />
            </div>

            <div>
                <div class="mb-1.5 text-xs font-medium text-app-muted">Presets</div>
                <div class="flex flex-wrap gap-2">
                    <Button Text="720p" Size="sm" Variant="secondary" OnClick="() => SetPreset(1280, 720)" />
                    <Button Text="1080p" Size="sm" Variant="secondary" OnClick="() => SetPreset(1920, 1080)" />
                    <Button Text="1440p" Size="sm" Variant="secondary" OnClick="() => SetPreset(2560, 1440)" />
                    <Button Text="4K" Size="sm" Variant="secondary" OnClick="() => SetPreset(3840, 2160)" />
                    <Button Text="Current monitor" Icon="monitor" Size="sm" Variant="secondary"
                            Disabled="@(CurrentMonitorResolution == null)"
                            OnClick="UseCurrentMonitor" />
                </div>
            </div>

            @if (ShowWarning)
            {
                <Alert Variant="warning" Title="Resolution differs from your monitor">
                    This image is @(Width) × @(Height) but your current monitor is @CurrentMonitorResolution.
                    Detection may be inaccurate unless the image is resized or your monitor resolution changes.
                </Alert>
            }
        </div>
    </ChildContent>
    <Footer>
        <Button Text="Cancel" Variant="ghost" OnClick="Cancel" />
        <Button Text="Upload image" Icon="upload" Variant="primary" Disabled="@(WidthError != null || HeightError != null)" OnClick="Confirm" />
    </Footer>
</Modal>

@code {
    private double? Width { get; set; } = 1920;
    private double? Height { get; set; } = 1080;
    private string? WidthError => ValidSize(Width) ? null : "Enter a whole number from 1 to 10000.";
    private string? HeightError => ValidSize(Height) ? null : "Enter a whole number from 1 to 10000.";
    private static bool ValidSize(double? value) => value is { } v && double.IsFinite(v) && v >= 1 && v <= 10000 && v == Math.Truncate(v);
    private bool _wasVisible;

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public Resolution? DefaultResolution { get; set; }

    [Parameter]
    public Resolution? CurrentMonitorResolution { get; set; }

    [Parameter]
    public EventCallback<Resolution> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool ShowWarning => 
        CurrentMonitorResolution != null && 
        (Width != CurrentMonitorResolution.Width || Height != CurrentMonitorResolution.Height);

    protected override void OnParametersSet()
    {
        // The editor re-renders every 500 ms while detection runs; only seed the
        // fields when the dialog opens so typed values are not overwritten.
        var opening = IsVisible && !_wasVisible;
        _wasVisible = IsVisible;
        if (!opening) return;

        if (DefaultResolution != null)
        {
            Width = DefaultResolution.Width;
            Height = DefaultResolution.Height;
        }
        else if (CurrentMonitorResolution != null)
        {
            Width = CurrentMonitorResolution.Width;
            Height = CurrentMonitorResolution.Height;
        }
    }

    private void OnWidthChanged(double? value)
    {
        Width = value;
    }

    private void OnHeightChanged(double? value)
    {
        Height = value;
    }

    private void SetPreset(int width, int height)
    {
        Width = width;
        Height = height;
    }

    private void UseCurrentMonitor()
    {
        if (CurrentMonitorResolution != null)
        {
            Width = CurrentMonitorResolution.Width;
            Height = CurrentMonitorResolution.Height;
        }
    }

    private async Task Confirm()
    {
        if (WidthError != null || HeightError != null) return;
        await OnConfirm.InvokeAsync(new Resolution((int)Width!.Value, (int)Height!.Value));
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}
