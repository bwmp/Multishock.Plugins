@page "/plugins/com-multishock-speechtotext/speechtotext"
@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@using SpeechToText.Services
@implements IDisposable
@inject NavigationManager Navigation

<div class="space-y-4">
<PageHeader Title="Speech to text" Icon="mic" Description="Use recognized words and sentences to trigger flows.">
    <Meta><span class="chip @(PendingAction != null ? "chip-info" : RecognitionService.IsListening ? "chip-ok" : "chip-neutral")" role="status"><span class="status-dot @(PendingAction != null ? "bg-app-info" : RecognitionService.IsListening ? "bg-app-success" : "bg-app-subtle")"></span> @(PendingAction ?? (RecognitionService.IsListening ? "Listening" : "Stopped"))</span></Meta>
    <Actions><Button Text="Settings" Icon="settings" Variant="ghost" OnClick="OpenSettings" />@if (RecognitionService.IsListening) { <Button Text="Stop" Disabled="@(PendingAction != null)" Variant="secondary" OnClick="StopListening" /> }
        else { <Button Text="@(PendingAction ?? "Start")" Disabled="@(PendingAction != null)" OnClick="StartListening" /> }</Actions>
</PageHeader>
<div class="max-w-4xl space-y-4">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        @if (StatusIsError) { <Alert Variant="danger">@StatusMessage</Alert> } else { <p class="text-sm text-app-muted" role="status">@StatusMessage</p> }
    }

    <Card Title="Live microphone input">
        <div class="flex items-center justify-between text-sm">
            <span class="text-app-muted">Input level</span>
            <span class="text-app-muted">@InputLevelPercent%</span>
        </div>
        <div role="progressbar" aria-label="Microphone input level" aria-valuenow="@InputLevelPercent" aria-valuemin="0" aria-valuemax="100" class="h-3 rounded border border-app-border bg-app-surface-2 overflow-hidden">
            <div class="h-3 motion-reduce:transition-none transition-all duration-100 bg-app-primary"
                 style="width: @(InputLevelPercent + "%")"></div>
        </div>
        <div class="text-xs text-app-subtle">Speak into your selected microphone to check its input.</div>
    </Card>

    @if (RecognitionService.IsListening && SilentSince is { } since && DateTimeOffset.UtcNow - since > TimeSpan.FromSeconds(3))
    {
        <Alert Variant="neutral" Title="No input detected">If you are speaking, check your microphone selection and input volume in Settings.</Alert>
    }


    <Card Title="Recent recognized sentences">
        <Actions>
            @if (Sentences.Count > 0) { <Button Text="Clear" Variant="ghost" Size="sm" OnClick="ClearLog" /> }
        </Actions>
        <ChildContent>

        @if (Sentences.Count == 0)
        {
            <div class="py-2 text-sm text-app-muted"><p>No speech events yet</p><p class="text-xs text-app-subtle">@(RecognitionService.IsListening ? "Speak into your selected microphone to see recognized sentences." : "Start listening and speak into your microphone to see recognized sentences.")</p></div>
        }
        else
        {
            <div class="space-y-1 max-h-80 overflow-y-auto">
                @foreach (var sentence in Sentences.TakeLast(100).Reverse())
                {
                    <div class="text-sm">
                        <span class="font-mono text-xs text-app-subtle">[@sentence.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")]</span>
                        <span class="text-app-muted"> (@sentence.Confidence.ToString("0.00"))</span>
                        <span> @sentence.Text</span>
                    </div>
                }
            </div>
        }
        </ChildContent>
    </Card>
</div>
</div>

@code {
    private void OpenSettings() => Navigation.NavigateTo($"settings/plugins?open={PluginIdValue}");
    private static readonly string PluginIdValue = SpeechToTextPlugin.PluginId;

    private SpeechRecognitionService RecognitionService =>
        PluginServiceLocator.GetRequiredService<SpeechRecognitionService>(PluginIdValue);

    private readonly List<SpeechSentenceEvent> Sentences = [];

    private double InputLevel;
    private int InputLevelPercent => (int)Math.Round(Math.Clamp(InputLevel, 0.0, 1.0) * 100);

    private Timer? InputHintTimer;
    private DateTimeOffset? SilentSince;
    private string? StatusMessage;
    private string? PendingAction;
    private bool StatusIsError;

    protected override void OnInitialized()
    {

        RecognitionService.SentenceRecognized += OnSentenceRecognized;
        RecognitionService.StatusMessage += OnStatus;
        RecognitionService.ErrorOccurred += OnError;
        RecognitionService.ListeningStateChanged += OnListeningChanged;
        RecognitionService.InputLevelChanged += OnInputLevelChanged;

        InputHintTimer = new Timer(_ => InvokeAsync(() =>
        {
            SilentSince = RecognitionService.IsListening && InputLevelPercent == 0
                ? SilentSince ?? DateTimeOffset.UtcNow : null;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        InputLevel = RecognitionService.CurrentInputLevel;
        SilentSince = InputLevelPercent == 0 ? DateTimeOffset.UtcNow : null;
    }

    private async Task StartListening()
    {
        if (PendingAction != null) return;
        PendingAction = "Starting…";
        try { await RecognitionService.StartListeningAsync(); }
        finally { PendingAction = null; }
    }

    private async Task StopListening()
    {
        if (PendingAction != null) return;
        PendingAction = "Stopping…";
        try { await RecognitionService.StopListeningAsync(); }
        finally { PendingAction = null; }
    }

    private void OnSentenceRecognized(SpeechSentenceEvent sentence)
    {
        InvokeAsync(() =>
        {
            Sentences.Add(sentence);
            if (Sentences.Count > 300)
            {
                Sentences.RemoveRange(0, Sentences.Count - 300);
            }

            StateHasChanged();
        });
    }

    private void OnStatus(string message)
    {
        InvokeAsync(() =>
        {
            StatusIsError = false;
            StatusMessage = message;
            StateHasChanged();
        });
    }

    private void OnError(string message)
    {
        InvokeAsync(() =>
        {
            StatusIsError = true;
            StatusMessage = message;
            StateHasChanged();
        });
    }

    private void OnListeningChanged(bool _)
    {
        InvokeAsync(() => { SilentSince = null; StateHasChanged(); });
    }

    private void OnInputLevelChanged(double level)
    {
        InvokeAsync(() =>
        {
            InputLevel = level;
            SilentSince = InputLevelPercent == 0 ? SilentSince ?? DateTimeOffset.UtcNow : null;
            StateHasChanged();
        });
    }

    private void ClearLog()
    {
        Sentences.Clear();
    }

    public void Dispose()
    {
        InputHintTimer?.Dispose();
        RecognitionService.SentenceRecognized -= OnSentenceRecognized;
        RecognitionService.StatusMessage -= OnStatus;
        RecognitionService.ErrorOccurred -= OnError;
        RecognitionService.ListeningStateChanged -= OnListeningChanged;
        RecognitionService.InputLevelChanged -= OnInputLevelChanged;
    }
}
