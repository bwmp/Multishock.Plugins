@page "/plugins/com-multishock-twitchintegration/hype-train-config"
@implements IDisposable

<PageHeader Title="Hype trains" Icon="train-front" Description="React while a hype train runs and when it ends. Changes save automatically.">
    <Breadcrumb><BackLink /></Breadcrumb>
    <Actions>
        <Toggle Label="Enabled" AriaLabel="Enable hype train reactions" Value="Config.Enabled" ValueChanged="ToggleEnabled" />
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!Config.Enabled)
    {
        <Alert Variant="neutral">Hype train reactions are off. You can set up both stages now; nothing runs until you switch on Enabled. Hype trains still reach your flows.</Alert>
    }

    @StagePanel(Config.During, true, "During train", "Runs when a train starts and each time it progresses.", _duringExpanded, () => _duringExpanded = !_duringExpanded)
    @StagePanel(Config.End, false, "Train end", "Runs once when the train ends.", _endExpanded, () => _endExpanded = !_endExpanded)
</div>

@code {
    private bool _duringExpanded = true;
    private bool _endExpanded = true;

    private static readonly string PluginId = TwitchIntegrationPlugin.PluginId;
    private HypeTrainConfigService HypeTrainConfigService => PluginServiceLocator.GetRequiredService<HypeTrainConfigService>(PluginId);
    private HypeTrainConfig Config => HypeTrainConfigService.Config;

    private static readonly Select<string>.SelectOption<string>[] ScalingModeOptions =
    [
        new(nameof(HypeTrainScalingMode.Fixed), "Same every level"),
        new(nameof(HypeTrainScalingMode.Incremental), "Increase each level")
    ];

    private RenderFragment StagePanel(HypeTrainActionConfig stage, bool during, string title, string description, bool expanded, Action toggle) => __builder =>
    {
        var panelId = during ? "hype-during-editor" : "hype-end-editor";
        var incremental = during && stage.ScalingMode == HypeTrainScalingMode.Incremental;
        <section class="panel" aria-label="@title">
            <div class="@($"flex flex-wrap items-center gap-x-2 gap-y-1 px-3 py-2 {(expanded ? "border-b border-app-border" : "")}")">
                <button type="button" class="flex min-w-0 flex-1 items-center gap-2 rounded-ctl py-1 text-left"
                        aria-expanded="@(expanded ? "true" : "false")" aria-controls="@(expanded ? panelId : null)" @onclick="toggle">
                    <LucideIcon Name="chevron-right" Size="16" Class="@($"shrink-0 text-app-muted transition-transform {(expanded ? "rotate-90" : "")}")" />
                    <span class="min-w-0">
                        <span class="block truncate text-sm font-medium text-app-text">@title</span>
                        <span class="block truncate text-xs text-app-subtle">@description</span>
                    </span>
                </button>
                @if (stage.Enabled && stage.SelectedShockerIds.Count == 0)
                {
                    <SummaryChip Summary="@(new ReactionSummary(Config.Enabled ? ReactionStatus.Attention : ReactionStatus.Off, "No shockers"))" />
                }
                <Toggle AriaLabel="@($"Enable {title.ToLowerInvariant()} reactions")" Value="stage.Enabled" ValueChanged="@(v => Update(during, a => a.Enabled = v))" />
            </div>
            @if (expanded)
            {
                <div id="@panelId" class="panel-body">
                    <SettingRow Label="Shockers" Description="The shockers this stage can run on.">
                        <Help>
                            @if (stage.SelectedShockerIds.Count == 0)
                            {
                                <NoShockersHint />
                            }
                        </Help>
                        <ChildContent>
                            <ShockerSelect Label="Shockers" Class="[&_label]:sr-only" MultiSelect="true" SelectedIds="stage.SelectedShockerIds"
                                           SelectedIdsChanged="@(ids => Update(during, a => a.SelectedShockerIds = ids))" />
                        </ChildContent>
                    </SettingRow>
                    <SettingRow Label="Mode" Description="Which of the selected shockers react.">
                        <Select TValue="string" Label="Mode" Class="[&_label]:sr-only" Value="@stage.Mode.ToString()" Options="ActionOptions.Modes"
                                ValueChanged="@(value => Update(during, a => a.Mode = ActionOptions.ParseMode(value)))" />
                    </SettingRow>
                    <SettingRow Label="Command" Description="What the shockers do.">
                        <Select TValue="string" Label="Command" Class="[&_label]:sr-only" Value="@stage.CommandType" Options="ActionOptions.Commands"
                                ValueChanged="@(value => Update(during, a => a.CommandType = value ?? "Shock"))" />
                    </SettingRow>
                    @if (stage.CommandType == "Shock")
                    {
                        <SettingRow Label="Warning vibrate" Description="Vibrate briefly before each shock.">
                            <Toggle AriaLabel="@($"Warning vibrate for {title.ToLowerInvariant()}")" Value="stage.WarningVibrate"
                                    ValueChanged="@(v => Update(during, a => a.WarningVibrate = v))" />
                        </SettingRow>
                    }
                    @if (during)
                    {
                        <SettingRow Label="Scaling" Description="Keep the action the same at every level, or make it stronger as the train levels up.">
                            <Select TValue="string" Label="Scaling" Class="[&_label]:sr-only" Value="@stage.ScalingMode.ToString()" Options="ScalingModeOptions"
                                    ValueChanged="@(value => Update(during, a => a.ScalingMode = ParseScalingMode(value)))" />
                        </SettingRow>
                    }
                    <SettingRow Label="Intensity" Description="How strong the action is.">
                        <NumberField Label="@($"Intensity for {title.ToLowerInvariant()}")" Class="w-28 [&_label]:sr-only" Suffix="%" Min="1" Max="100" Value="stage.Intensity"
                                     ValueChanged="@(v => Update(during, a => a.Intensity = (int)v))" />
                    </SettingRow>
                    <SettingRow Label="Duration" Description="How long the action lasts.">
                        <NumberField Label="@($"Duration for {title.ToLowerInvariant()}")" Class="w-28 [&_label]:sr-only" Suffix="s" Min="0.1" Max="15" Step="0.1" Value="stage.Duration"
                                     ValueChanged="@(v => Update(during, a => a.Duration = v))" />
                    </SettingRow>
                    @if (incremental)
                    {
                        <SettingRow Label="Increase per level" Description="Intensity and duration added for each level after the first.">
                            <div class="flex gap-2">
                                <NumberField Label="Intensity increase per level" Class="w-28 [&_label]:sr-only" Suffix="%" Min="0" Max="100" Value="stage.IncrementIntensity"
                                             ValueChanged="@(v => Update(during, a => a.IncrementIntensity = (int)v))" />
                                <NumberField Label="Duration increase per level" Class="w-28 [&_label]:sr-only" Suffix="s" Min="0" Max="15" Step="0.1" Value="stage.IncrementDuration"
                                             ValueChanged="@(v => Update(during, a => a.IncrementDuration = v))" />
                            </div>
                        </SettingRow>
                        <SettingRow Label="Maximum" Description="The action never goes above these, however high the level.">
                            <div class="flex gap-2">
                                <NumberField Label="Maximum intensity" Class="w-28 [&_label]:sr-only" Suffix="%" Min="1" Max="100" Value="stage.MaxIntensity"
                                             ValueChanged="@(v => Update(during, a => a.MaxIntensity = (int)v))" />
                                <NumberField Label="Maximum duration" Class="w-28 [&_label]:sr-only" Suffix="s" Min="0.1" Max="15" Step="0.1" Value="stage.MaxDuration"
                                             ValueChanged="@(v => Update(during, a => a.MaxDuration = v))" />
                            </div>
                        </SettingRow>
                    }
                </div>
            }
        </section>
    };

    protected override void OnInitialized()
    {
        HypeTrainConfigService.ConfigChanged += OnConfigChanged;
    }

    private void OnConfigChanged() => InvokeAsync(StateHasChanged);

    private void ToggleEnabled(bool enabled) => HypeTrainConfigService.SetEnabled(enabled);

    private void Update(bool during, Action<HypeTrainActionConfig> mutate)
    {
        var action = during ? Config.During : Config.End;
        mutate(action);
        if (during)
            HypeTrainConfigService.UpdateDuring(action);
        else
            HypeTrainConfigService.UpdateEnd(action);
    }

    private static HypeTrainScalingMode ParseScalingMode(string? value) =>
        Enum.TryParse<HypeTrainScalingMode>(value, out var mode) ? mode : HypeTrainScalingMode.Fixed;

    public void Dispose()
    {
        HypeTrainConfigService.ConfigChanged -= OnConfigChanged;
    }
}
