@page "/plugins/com-multishock-streamlabsintegration/streamlabsintegration"
@using MultiShock.PluginSdk
@using MultiShock.PluginSdk.Components
@using StreamlabsIntegration.Models
@implements IDisposable

<PageHeader Title="Streamlabs" Icon="badge-dollar-sign" Description="React to donations, cheers, subscriptions, follows, hosts, raids and super chats with shocker actions or flow triggers.">
    <Meta>
        <span class="chip @ConnectionChip" role="status">
            <span class="status-dot @ConnectionDot"></span>
            @ConnectionLabel
        </span>
    </Meta>
    <Actions>
        @if (Connection.IsConnected)
        {
            <Button Variant="secondary" Icon="log-out" Text="Disconnect" OnClick="Disconnect" />
        }
        else
        {
            <Button Variant="primary" Icon="plug" Text="Connect" Disabled="@(Connection.IsConnecting || !Settings.HasToken)" Title="@(Settings.HasToken ? null : "Paste your Socket API token first")" OnClick="Connect" />
        }
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    <Card Title="Connection" Description="Changes save automatically.">
        <ChildContent>
            <SettingRow Label="Account" Description="In the Streamlabs dashboard, open Settings > API Settings > API Tokens and copy the Socket API token.">
                <Button Text="Open account settings" Variant="secondary" Icon="external-link" OnClick="OpenSettings" />
            </SettingRow>
            <SettingRow Label="Socket API token" Description="Paste your token to connect. Keep it secret; it grants access to your account.">
                <TextInput Label="Socket API token" Class="[&_label]:sr-only" InputType="password" Placeholder="Paste your Socket API token" Value="@Token" ValueChanged="UpdateToken" />
            </SettingRow>
            <SettingRow Label="Connect on startup" Description="Connect to Streamlabs when MultiShock starts.">
                <Toggle AriaLabel="Connect on startup" Value="Settings.AutoConnect" ValueChanged="SetAutoConnect" />
            </SettingRow>
            <SettingRow Label="Reconnect automatically" Description="Reconnect if the connection drops.">
                <Toggle AriaLabel="Reconnect automatically" Value="Settings.AutoReconnect" ValueChanged="SetAutoReconnect" />
            </SettingRow>
            @if (!Connection.IsConnected && !string.IsNullOrWhiteSpace(Log.LastConnectionError))
            {
                <Alert Variant="danger">@Log.LastConnectionError</Alert>
            }
            @if (!Connection.IsConnected && !string.IsNullOrWhiteSpace(Log.ConnectionStatus))
            {
                <p class="text-xs text-app-muted" role="status">@Log.ConnectionStatus</p>
            }
        </ChildContent>
    </Card>
    <Card Title="Reactions" Description="Run shocker actions straight from Streamlabs events. For custom logic, use the Streamlabs triggers in a flow instead.">
        <ChildContent>
            @foreach (var info in StreamlabsEventCatalog.All)
            {
                <ReactionRow Info="info" Config="Actions.Get(info.Type)" Href="@($"/plugins/com-multishock-streamlabsintegration/streamlabs-{info.Type}")" />
            }
        </ChildContent>
    </Card>
    <Card Title="Event log" Description="Latest 50 events, newest first." NoPadding="true">
        <Actions>
            @if (Log.Count > 0)
            {
                <Button Variant="ghost" Size="sm" Icon="trash-2" Text="Clear" OnClick="@(() => Log.Clear())" />
            }
        </Actions>
        <ChildContent>
            @if (Log.Count == 0)
            {
                <div class="px-4 py-6">
                    <p class="text-sm text-app-muted">No events yet.</p>
                    <p class="mt-0.5 text-xs text-app-subtle">@(Connection.IsConnected
                        ? "Send a test alert from your Streamlabs dashboard to check the connection."
                        : "Events appear here once you connect.")</p>
                </div>
            }
            else
            {
                <div class="max-h-64 overflow-y-auto divide-y divide-app-border" role="region" aria-label="Recent events" tabindex="0">
                    @foreach (var entry in Log.Entries.TakeLast(50).Reverse())
                    {
                        <div class="flex items-start gap-3 px-4 py-2 text-sm">
                            <time class="shrink-0 font-mono text-xs text-app-subtle">@entry.Time.ToString("HH:mm:ss")</time>
                            <span class="min-w-0 break-words @(entry.IsError ? "text-app-danger" : "text-app-text")">@entry.Message</span>
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </Card>
    <details class="panel group/advanced">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-panel px-4 py-3 [&::-webkit-details-marker]:hidden">
            <span class="min-w-0">
                <span class="panel-title block">Advanced</span>
                <span class="panel-desc block">Flow triggers this plugin adds.</span>
            </span>
            <LucideIcon Name="chevron-right" Size="16" Class="shrink-0 text-app-muted transition-transform group-open/advanced:rotate-90" />
        </summary>
        <div class="border-t border-app-border p-4 space-y-2">
            <h2 class="panel-title">Available flow triggers</h2>
            <p class="text-sm text-app-muted">These triggers are available in Flows independently of the reaction switches above.</p>
            <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-app-text">
                @foreach (var info in StreamlabsEventCatalog.All)
                {
                    <li class="flex items-center gap-2"><LucideIcon Name="@info.Icon" Size="14" Class="text-app-muted" />@info.DisplayName</li>
                }
            </ul>
        </div>
    </details>
</div>

@code {
    private static readonly string PluginId = StreamlabsIntegrationPlugin.PluginId;
    private StreamlabsSettingsService Settings => PluginServiceLocator.GetRequiredService<StreamlabsSettingsService>(PluginId);
    private StreamlabsConnectionService Connection => PluginServiceLocator.GetRequiredService<StreamlabsConnectionService>(PluginId);
    private ActionConfigService Actions => PluginServiceLocator.GetRequiredService<ActionConfigService>(PluginId);
    private EventLogService Log => PluginServiceLocator.GetRequiredService<EventLogService>(PluginId);

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private string ConnectionLabel => Connection.IsConnected ? "Connected" : Log.IsReconnecting ? "Reconnecting…" : Connection.IsConnecting ? "Connecting…" : Log.LastConnectionError != null ? "Error" : "Disconnected";
    private string ConnectionChip => Connection.IsConnected ? "chip-ok" : Log.IsReconnecting ? "chip-info" : Connection.IsConnecting ? "chip-info" : Log.LastConnectionError != null ? "chip-danger" : "chip-neutral";
    private string ConnectionDot => Connection.IsConnected ? "bg-app-success" : Log.IsReconnecting ? "bg-app-info" : Connection.IsConnecting ? "bg-app-info" : Log.LastConnectionError != null ? "bg-app-danger" : "bg-app-subtle";
    private string Token = "";

    protected override void OnInitialized()
    {
        Token = Settings.SocketToken;
        Connection.ConnectionStateChanged += OnStateChanged;
        Log.LogChanged += OnLogChanged;
        Actions.ConfigChanged += OnLogChanged;
    }

    private void UpdateToken(string? v)
    {
        Token = v ?? "";
        Settings.SocketToken = Token;
    }

    private void SetAutoConnect(bool v) => Settings.AutoConnect = v;
    private void SetAutoReconnect(bool v) => Settings.AutoReconnect = v;

    private void OnStateChanged(bool _) => InvokeAsync(StateHasChanged);
    private void OnLogChanged() => InvokeAsync(StateHasChanged);

    private async Task Connect() => await Connection.ConnectAsync();
    private async Task Disconnect() => await Connection.DisconnectAsync();

    private async Task OpenSettings()
    {
        try { await JS.InvokeVoidAsync("open", StreamlabsConstants.TokenSettingsUrl, "_blank"); } catch { }
    }

    public void Dispose()
    {
        Connection.ConnectionStateChanged -= OnStateChanged;
        Log.LogChanged -= OnLogChanged;
        Actions.ConfigChanged -= OnLogChanged;
    }
}
