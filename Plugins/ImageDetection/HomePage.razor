@page "/plugins/com-multishock-imagedetection/imagedetection"
@inject ImageDetectionService DetectionService
@inject ImageConfigService ConfigService
@inject NavigationManager NavManager
@implements IDisposable

<PageHeader Title="@GetPageTitle()"
            Icon="@(SelectedModuleData == null ? "scan-eye" : null)"
            Description="@GetPageDescription()"
            Breadcrumb="@(SelectedModuleData == null ? null : BackToModules)">
    <Meta>
        @if (IsRunning)
        {
            <span role="status" class="chip chip-ok"><span class="status-dot bg-app-success"></span> Running</span>
        }
        else
        {
            <span role="status" class="chip chip-neutral"><span class="status-dot bg-app-subtle"></span> Stopped</span>
        }
    </Meta>
    <Actions>
        @if (SelectedModuleData is { } module)
        {
            <Toggle Label="Module enabled" Value="module.Enabled" ValueChanged="OnModuleEnabledChanged" />
        }
        else
        {
            <Button Text="Settings" Icon="settings" Variant="ghost" OnClick="@(() => NavManager.NavigateTo($"settings/plugins?open={ImageDetectionPlugin.PluginId}"))" />
            <Button Text="Recent detections" Icon="history" Variant="secondary" OnClick="OpenRecentDetections" />
        }
        <Button Text="@(IsRunning ? "Stop detection" : "Start detection")"
                Icon="@(IsRunning ? "square" : "play")"
                Variant="@(IsRunning ? "secondary" : "primary")"
                OnClick="ToggleDetection" />
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <Alert Variant="danger" Class="mb-4">
        <ChildContent>@ErrorMessage</ChildContent>
        <Actions>
            <Button Icon="x" Size="icon-sm" Variant="ghost" AriaLabel="Dismiss error" Title="Dismiss error" OnClick="ClearErrorMessage" />
        </Actions>
    </Alert>
}

@if (string.IsNullOrEmpty(SelectedModule))
{
    <HomeDashboard OnModuleSelected="SelectModule" />
}
else
{
    <HomeModuleEditor ModuleId="@(SelectedModule!)" />
}

@code {
    private const string RecentDetectionsRoute = "/plugins/com-multishock-imagedetection/recent-detections";

    private bool IsRunning => DetectionService?.IsRunning ?? false;
    private string? ErrorMessage;
    private string? SelectedModule;

    protected override void OnInitialized()
    {
        DetectionService.RunningStateChanged += OnRunningStateChanged;
        DetectionService.ErrorOccurred += OnError;
        ConfigService.ConfigurationChanged += OnConfigChanged;
    }

    public void Dispose()
    {
        DetectionService.RunningStateChanged -= OnRunningStateChanged;
        DetectionService.ErrorOccurred -= OnError;
        ConfigService.ConfigurationChanged -= OnConfigChanged;
    }

    private DetectionModule? SelectedModuleData =>
        !string.IsNullOrEmpty(SelectedModule) && ConfigService.Modules.TryGetValue(SelectedModule, out var module)
            ? module
            : null;

    private string GetPageTitle() => SelectedModuleData?.Name ?? "Image detection";

    private string GetPageDescription()
    {
        if (SelectedModuleData is not { } module)
        {
            return "Watch your screen for images, health bars and text, and send shocks, vibrations or beeps when they appear.";
        }

        return string.IsNullOrWhiteSpace(module.Description)
            ? "Targets in this module. Changes save automatically."
            : module.Description;
    }

    private RenderFragment BackToModules => __builder =>
    {
        <button type="button" class="inline-flex items-center gap-1 rounded-ctl hover:text-app-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary" @onclick="GoBack">
            <LucideIcon Name="arrow-left" Size="12" />
            Image detection
        </button>
    };

    private void OnModuleEnabledChanged(bool enabled)
    {
        if (SelectedModule != null)
        {
            ConfigService.SetModuleEnabled(SelectedModule, enabled);
        }
    }

    private Task ToggleDetection() => DetectionService.ToggleAsync();

    private void OpenRecentDetections()
    {
        NavManager.NavigateTo(RecentDetectionsRoute);
    }

    private void SelectModule(string moduleId)
    {
        SelectedModule = moduleId;
        StateHasChanged();
    }

    private void GoBack()
    {
        SelectedModule = null;
        StateHasChanged();
    }

    private void ClearErrorMessage()
    {
        ErrorMessage = null;
        StateHasChanged();
    }

    private void OnRunningStateChanged(bool _)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnError(string error)
    {
        ErrorMessage = error;
        InvokeAsync(StateHasChanged);
    }

    private void OnConfigChanged()
    {
        InvokeAsync(() =>
        {
            if (!string.IsNullOrEmpty(SelectedModule) && !ConfigService.Modules.ContainsKey(SelectedModule))
            {
                SelectedModule = null;
            }

            StateHasChanged();
        });
    }
}
