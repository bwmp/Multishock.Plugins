@using ImageDetection.Models
@using ImageDetection.Services
@using MultiShock.PluginSdk.Components
@inject ImageConfigService ConfigService
@inject IGlobalHotkeyService HotkeyService

<div class="max-w-4xl space-y-4">
    <p class="text-sm text-app-muted">Changes save automatically.</p>
    <Card Title="Detection">
        <Header><div class="panel-title">Detection</div><p class="panel-desc">Monitor, capture delay and capture backend are on the <a href="plugins/com-multishock-imagedetection/imagedetection" class="text-app-primary hover:underline">Image detection page</a>.</p></Header>
        <ChildContent>
        <SettingRow Label="Run detection automatically"
                    Description="Starts now and whenever MultiShock opens. Turning this off stops detection that is running.">
            <Toggle AriaLabel="Run detection automatically"
                    Value="@BackgroundDetectionEnabled"
                    ValueChanged="@OnBackgroundDetectionChanged" />
        </SettingRow>
        <SettingRow Label="Debug logging"
                    Description="Writes detailed detection logs and saves captured frames to disk for troubleshooting.">
            <Toggle AriaLabel="Debug logging"
                    Value="@DebugMode"
                    ValueChanged="@OnDebugModeChanged" />
        </SettingRow>
        </ChildContent>
    </Card>

    <Card Title="Region picker hotkey">
        @if (!HotkeyService.IsSupported)
        {
            <Alert Variant="warning" Class="mb-3">
                @(HotkeyService.UnsupportedReason ?? "Global hotkeys are not supported on this platform.")
            </Alert>
        }

        <SettingRow Label="Global hotkey"
                    Description="Press the hotkey in game to capture the screen and pick a region for the armed target.">
            <Meta>
                @if (HotkeyEnabled)
                {
                    @if (HotkeyService.IsRegistered)
                    {
                        <span class="chip chip-ok" role="status"><span class="status-dot bg-app-success"></span> Active</span>
                    }
                    else
                    {
                        <span class="chip chip-warn" role="status"><span class="status-dot bg-app-warning"></span> @(HotkeyService.IsSupported ? "Not registered" : "Unsupported")</span>
                    }
                }
            </Meta>
            <ChildContent>
                <Toggle AriaLabel="Enable global hotkey for region picker"
                        Value="@HotkeyEnabled"
                        ValueChanged="@OnHotkeyEnabledChanged" />
            </ChildContent>
        </SettingRow>

        @if (HotkeyEnabled)
        {
            <SettingRow Label="Shortcut" WideControl="true">
                <Help>
                    Current binding <span class="kbd">@GetHotkeyDisplayString()</span>
                </Help>
                <ChildContent>
                    <div class="flex w-full flex-wrap sm:flex-nowrap items-center justify-end gap-x-4 gap-y-2">
                        <div class="flex h-9 items-center gap-4">
                            <Checkbox Label="Ctrl" Value="@HotkeyCtrl" ValueChanged="@(value => OnHotkeyModifierChanged("ctrl", value))" />
                            <Checkbox Label="Alt" Value="@HotkeyAlt" ValueChanged="@(value => OnHotkeyModifierChanged("alt", value))" />
                            <Checkbox Label="Shift" Value="@HotkeyShift" ValueChanged="@(value => OnHotkeyModifierChanged("shift", value))" />
                        </div>
                        <div class="w-28">
                            <Select Class="[&_label]:sr-only" TValue="string"
                                    Label="Key"
                                    Value="@HotkeyKey"
                                    ValueChanged="OnHotkeyKeyChanged"
                                    Options="KeyOptions" />
                        </div>
                    </div>
                </ChildContent>
            </SettingRow>

            @if (!string.IsNullOrEmpty(HotkeyError))
            {
                <Alert Variant="danger" Class="mt-3">@HotkeyError</Alert>
            }
        }
    </Card>
</div>

@code {
    [Parameter] public string? PluginId { get; set; }
    [Parameter] public Dictionary<string, object?>? Settings { get; set; }
    [Parameter] public EventCallback<Dictionary<string, object?>> SettingsChanged { get; set; }

    private static readonly IEnumerable<Select<string>.SelectOption<string>> KeyOptions =
        HotkeyBinding.SupportedKeys.Select(key => new Select<string>.SelectOption<string>(key, key)).ToList();

    private bool BackgroundDetectionEnabled;
    private bool DebugMode;

    private bool HotkeyEnabled;
    private string HotkeyKey = "F8";
    private bool HotkeyCtrl;
    private bool HotkeyAlt;
    private bool HotkeyShift;
    private string? HotkeyError;

    protected override void OnParametersSet()
    {
        if (Settings != null)
        {
            BackgroundDetectionEnabled = Settings.TryGetValue("backgroundDetectionEnabled", out var e) && e is bool b && b;
            DebugMode = Settings.TryGetValue("debugMode", out var dm) && dm is bool db && db;
        }

        var hotkey = ConfigService.PickerHotkey;
        HotkeyEnabled = hotkey.Enabled;
        HotkeyKey = hotkey.Key;
        HotkeyCtrl = hotkey.Ctrl;
        HotkeyAlt = hotkey.Alt;
        HotkeyShift = hotkey.Shift;
    }

    private async Task OnBackgroundDetectionChanged(bool value)
    {
        BackgroundDetectionEnabled = value;
        await SaveSettings();
    }

    private async Task OnDebugModeChanged(bool value)
    {
        DebugMode = value;
        await SaveSettings();
    }

    private void OnHotkeyEnabledChanged(bool value)
    {
        HotkeyEnabled = value;
        HotkeyError = null;
        ApplyHotkeySettings();
    }

    private void OnHotkeyKeyChanged(string? key)
    {
        HotkeyKey = key ?? "F8";
        HotkeyError = null;
        ApplyHotkeySettings();
    }

    private void OnHotkeyModifierChanged(string modifier, bool value)
    {
        switch (modifier)
        {
            case "ctrl": HotkeyCtrl = value; break;
            case "alt": HotkeyAlt = value; break;
            case "shift": HotkeyShift = value; break;
        }
        HotkeyError = null;
        ApplyHotkeySettings();
    }

    private void ApplyHotkeySettings()
    {
        var binding = new HotkeyBinding
        {
            Enabled = HotkeyEnabled,
            Key = HotkeyKey,
            Ctrl = HotkeyCtrl,
            Alt = HotkeyAlt,
            Shift = HotkeyShift
        };

        ConfigService.PickerHotkey = binding;

        if (!HotkeyService.UpdateBinding(binding, out var error))
        {
            HotkeyError = error;
        }
        else
        {
            HotkeyError = null;
        }

        StateHasChanged();
    }

    private string GetHotkeyDisplayString()
    {
        var binding = new HotkeyBinding
        {
            Key = HotkeyKey,
            Ctrl = HotkeyCtrl,
            Alt = HotkeyAlt,
            Shift = HotkeyShift
        };
        return binding.GetDisplayString();
    }

    private async Task SaveSettings()
    {
        var newSettings = Settings == null ? [] : new Dictionary<string, object?>(Settings);
        newSettings["backgroundDetectionEnabled"] = BackgroundDetectionEnabled;
        newSettings["debugMode"] = DebugMode;
        
        await SettingsChanged.InvokeAsync(newSettings);
    }
}
