<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.22621.0</TargetFramework>
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFramework>
        <!-- Plugin still runs on Windows 10 1809+; WGC availability is checked at runtime. -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">18.0</SupportedOSPlatformVersion>
        <UseRidGraph>true</UseRidGraph>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PluginVersion>1.3.0</PluginVersion> <!-- x-release-please-version -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Emgu.CV" />
        <PackageReference Include="Emgu.CV.runtime.windows" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
        <PackageReference Include="Vortice.Direct3D11" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
        <PackageReference Include="Emgu.CV.runtime.maui.mini.macos" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
        <PackageReference Include="Tmds.DBus.Protocol" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''" />
    </ItemGroup>

    <!--
        Linux ships a self-built OpenCV (native/build-linux-cvextern.sh) instead of Emgu's Ubuntu runtime,
        which links ~50 distro-specific libraries (VTK, FFmpeg 6, GTK3, GStreamer) and only loads on Ubuntu 24.04.
    -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
        <LinuxCvExternPath>$(MSBuildProjectDirectory)/native/linux-x64/libcvextern.so</LinuxCvExternPath>
    </PropertyGroup>
    <ItemGroup Condition="'$(LinuxCvExternPath)' != '' and Exists('$(LinuxCvExternPath)')">
        <None Include="$(LinuxCvExternPath)" Link="runtimes/linux-x64/native/libcvextern.so" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Target Name="RequireLinuxCvExtern" BeforeTargets="Build" Condition="'$(LinuxCvExternPath)' != '' and !Exists('$(LinuxCvExternPath)')">
        <Error Text="$(LinuxCvExternPath) is missing. Run native/build-linux-cvextern.sh (needs Docker) to build it." />
    </Target>
</Project>
