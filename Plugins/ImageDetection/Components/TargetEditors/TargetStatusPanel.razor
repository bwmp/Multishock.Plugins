@inject ImageDetectionService DetectionService

@* Validation issues + live health + one-shot "Test Now" for the selected target. *@

@{
    var targetIssues = DetectionService.GetTargetIssues(Image);
}
@if (targetIssues.Count > 0)
{
    <Alert Variant="warning" Title="This target needs attention">
        <ul class="space-y-0.5">
            @foreach (var issue in targetIssues)
            {
                <li>@issue</li>
            }
        </ul>
    </Alert>
}

<Card Title="Status">
    <Actions>
        <Button Text="@(_testRunning ? "Testing…" : "Test now")" Icon="scan-search" Size="sm" Variant="secondary"
                Loading="@_testRunning" OnClick="RunTargetTest" />
    </Actions>
    <ChildContent>
        <div class="space-y-3">
            @if (DetectionService.IsRunning && !string.IsNullOrEmpty(ModuleId))
            {
                var health = DetectionService.GetTargetHealth(ModuleId, Image);
                @if (health == null)
                {
                    <p class="text-xs text-app-muted m-0">Waiting for the first detection pass…</p>
                }
                else
                {
                    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-app-muted">
                        @if (health.LastConfidence.HasValue)
                        {
                            <span>Confidence: <span class="font-mono text-app-text">@health.LastConfidence.Value.ToString("P1")</span></span>
                        }
                        @if (health.LastMeterPercent.HasValue)
                        {
                            <span>Fill: <span class="font-mono text-app-text">@health.LastMeterPercent.Value.ToString("F1")%</span></span>
                        }
                        @if (!string.IsNullOrEmpty(health.LastOcrText))
                        {
                            <span>Last text: <span class="font-mono text-app-text">@EditorUi.TruncateText(health.LastOcrText, 40)</span></span>
                        }
                        <span>Checked @EditorUi.FormatTimeAgo(health.LastCheckedUtc)</span>
                        <span>Last match: @(health.LastDetectedUtc.HasValue ? EditorUi.FormatTimeAgo(health.LastDetectedUtc.Value) : "never")</span>
                        @if (health.CooldownRemainingSeconds > 0.05)
                        {
                            <span class="text-app-warning">Cooldown: @health.CooldownRemainingSeconds.ToString("F1")s</span>
                        }
                        @if (!string.IsNullOrEmpty(health.LastError))
                        {
                            <span class="text-app-danger">Error: @health.LastError</span>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-xs text-app-muted m-0">Background detection is stopped — use Test now for a one-shot check.</p>
            }

            @if (_testResult != null)
            {
                var testOk = _testResult.Success && (_testResult.Found || _testResult.MeterPercent.HasValue);
                <div class="rounded-lg border p-3 space-y-2 @(testOk ? "border-app-success/40 bg-app-success/5" : "border-app-border-strong bg-black/10")">
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-sm @(testOk ? "text-app-success" : _testResult.Success ? "text-app-muted" : "text-app-danger")">
                            @_testResult.Message
                        </span>
                        <span class="text-xs text-app-muted whitespace-nowrap">@_testResult.Duration.TotalMilliseconds.ToString("F0") ms</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_testResult.PreviewDataUri))
                    {
                        <img src="@_testResult.PreviewDataUri" alt="Test preview"
                             class="max-w-full max-h-80 rounded border border-app-border" />
                    }
                </div>
            }
        </div>
    </ChildContent>
</Card>

@code {
    [Parameter, EditorRequired] public string ModuleId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public DetectionImage Image { get; set; } = default!;

    private TargetTestResult? _testResult;
    private bool _testRunning;
    private string? _lastImageId;

    protected override void OnParametersSet()
    {
        // Discard a stale test result when the user switches targets.
        if (_lastImageId != Image.Id)
        {
            _lastImageId = Image.Id;
            _testResult = null;
        }
    }

    private async Task RunTargetTest()
    {
        if (string.IsNullOrEmpty(ModuleId) || _testRunning) return;

        _testRunning = true;
        _testResult = null;
        StateHasChanged();

        try
        {
            _testResult = await Task.Run(() => DetectionService.TestTargetAsync(ModuleId, Image.Id));
        }
        catch (Exception ex)
        {
            _testResult = TargetTestResult.Fail(ex.Message);
        }
        finally
        {
            _testRunning = false;
            StateHasChanged();
        }
    }
}
