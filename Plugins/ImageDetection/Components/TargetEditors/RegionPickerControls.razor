@inject RegionPickerArmService PickerArmService
@inject IGlobalHotkeyService HotkeyService
@inject ImageConfigService ConfigService

@* Arm-picker / instant-capture button pair shared by the meter, OCR, and
   template region editors. The actual picker modal lives in HomeModuleEditor;
   OnCaptureRequested asks it to capture and open. *@

<div class="flex flex-wrap items-center gap-2">
    @if (IsArmedForTarget)
    {
        <span class="chip chip-warn h-8 flex-1 justify-center" role="status">
            <span class="status-dot bg-app-warning"></span>
            Armed: press <span class="kbd">@PickerHotkeyDisplay</span> in game
        </span>
        <Button Text="Disarm" Variant="secondary" OnClick="ToggleArm" />
    }
    else
    {
        <Button Text="Arm region picker" Icon="crosshair" Variant="secondary" Class="flex-1"
                Title="Arm, then press the hotkey in game to capture and pick a region"
                Disabled="@(!HotkeyService.IsRegistered)"
                OnClick="ToggleArm" />
    }
    <Button Text="Capture now" Icon="camera" Variant="secondary"
            Title="Capture the screen now and pick a region"
            OnClick="OnCaptureRequested" />
</div>

@if (!HotkeyService.IsRegistered)
{
    <p class="text-xs text-app-muted">
        @(HotkeyService.IsSupported
            ? "Arming needs the region picker hotkey. Turn it on in Manage plugins → Image detection → Configure."
            : (HotkeyService.UnsupportedReason ?? "Global hotkeys are not supported on this platform."))
    </p>
}

@code {
    [Parameter, EditorRequired] public string ModuleId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string TargetId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnCaptureRequested { get; set; }

    private string PickerHotkeyDisplay => ConfigService.PickerHotkey.GetDisplayString();

    private bool IsArmedForTarget =>
        PickerArmService.IsArmed &&
        PickerArmService.Current?.ModuleId == ModuleId &&
        PickerArmService.Current?.TargetId == TargetId;

    private void ToggleArm()
    {
        if (string.IsNullOrEmpty(ModuleId) || string.IsNullOrEmpty(TargetId)) return;
        PickerArmService.Toggle(ModuleId, TargetId);
    }
}
