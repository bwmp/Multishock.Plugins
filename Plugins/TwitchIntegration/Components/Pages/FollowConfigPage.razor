@page "/plugins/com-multishock-twitchintegration/follow-config"
@using MultiShock.PluginSdk
@implements IDisposable

<PageHeader Title="Follows" Icon="user-plus" Description="React when a viewer follows your channel for the first time. Changes save automatically.">
    <Breadcrumb><BackLink /></Breadcrumb>
    <Actions>
        <Toggle Label="Enabled" AriaLabel="Enable follow reactions" Value="Config.Enabled" ValueChanged="ToggleEnabled" />
    </Actions>
</PageHeader>

<div class="max-w-4xl space-y-4">
    @if (!Config.Enabled)
    {
        <Alert Variant="neutral">Follow reactions are off. You can set up the action now; nothing runs until you switch on Enabled. Follows still reach your flows.</Alert>
    }

    <Card Title="Action" Description="Runs once for each viewer's first follow.">
        <SettingRow Label="Shockers" Description="The shockers a follow can run on.">
            <Help>
                @if (Config.SelectedShockerIds.Count == 0)
                {
                    <NoShockersHint />
                }
            </Help>
            <ChildContent>
                <ShockerSelect Label="Shockers" Class="[&_label]:sr-only" MultiSelect="true" SelectedIds="Config.SelectedShockerIds"
                               SelectedIdsChanged="UpdateShockers" />
            </ChildContent>
        </SettingRow>
        <SettingRow Label="Mode" Description="Which of the selected shockers react.">
            <Select TValue="string" Label="Mode" Class="[&_label]:sr-only" Value="@Config.Mode.ToString()" Options="ActionOptions.Modes"
                    ValueChanged="@(value => UpdateMode(ActionOptions.ParseMode(value)))" />
        </SettingRow>
        <SettingRow Label="Command" Description="What the shockers do.">
            <Select TValue="string" Label="Command" Class="[&_label]:sr-only" Value="@Config.CommandType" Options="ActionOptions.Commands"
                    ValueChanged="@(value => UpdateCommandType(value ?? "Shock"))" />
        </SettingRow>
        @if (Config.CommandType == "Shock")
        {
            <SettingRow Label="Warning vibrate" Description="Vibrate briefly before each shock.">
                <Toggle AriaLabel="Warning vibrate" Value="Config.WarningVibrate" ValueChanged="UpdateWarningVibrate" />
            </SettingRow>
        }
        <SettingRow Label="Intensity" Description="How strong the action is.">
            <NumberField Label="Intensity" Class="w-28 [&_label]:sr-only" Suffix="%" Min="1" Max="100" Value="Config.Intensity"
                         ValueChanged="@(v => UpdateIntensity((int)v))" />
        </SettingRow>
        <SettingRow Label="Duration" Description="How long the action lasts.">
            <NumberField Label="Duration" Class="w-28 [&_label]:sr-only" Suffix="s" Min="0.1" Max="15" Step="0.1" Value="Config.Duration"
                         ValueChanged="UpdateDuration" />
        </SettingRow>
    </Card>

    <Card Title="Follower tracking" Description="MultiShock remembers who has followed, so unfollowing and following again doesn't run the action twice.">
        <Actions>
            <Button Text="Refresh followers" Icon="refresh-cw" Variant="secondary" Size="sm"
                    Loading="FollowConfigService.IsFetchingFollowers" OnClick="RefreshFollowers" />
        </Actions>
        <ChildContent>
            <SettingRow Label="Known followers" Description="@LastFetchedText">
                <span class="text-sm tabular-nums text-app-text">@FollowConfigService.KnownFollowerCount</span>
            </SettingRow>
            <SettingRow Label="Fetch followers on startup" Description="Load your current followers when MultiShock connects, so existing followers don't trigger the action.">
                <Toggle AriaLabel="Fetch followers on startup" Value="Config.FetchFollowersOnStartup" ValueChanged="ToggleFetchOnStartup" />
            </SettingRow>
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                @if (StatusIsSuccess)
                {
                    <p role="status" class="mt-3 text-sm text-app-muted">@StatusMessage</p>
                }
                else
                {
                    <Alert Variant="danger" Class="mt-3">@StatusMessage</Alert>
                }
            }
        </ChildContent>
    </Card>
</div>

@code {
    // Use service locator instead of @inject for plugin-specific services
    // This survives hot-reload where the DI container has stale types
    private static readonly string PluginId = TwitchIntegrationPlugin.PluginId;
    private FollowConfigService FollowConfigService => PluginServiceLocator.GetRequiredService<FollowConfigService>(PluginId);

    private string? StatusMessage;
    private bool StatusIsSuccess;

    private FollowConfig Config => FollowConfigService.Config;

    private string LastFetchedText => Config.LastFetchedUtc.HasValue
        ? $"Last fetched {Config.LastFetchedUtc.Value.ToLocalTime():g}."
        : "Not fetched yet.";

    protected override void OnInitialized()
    {
        FollowConfigService.ConfigChanged += OnConfigChanged;
    }

    private void OnConfigChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleEnabled(bool enabled) => FollowConfigService.SetEnabled(enabled);

    private void ToggleFetchOnStartup(bool enabled) => FollowConfigService.SetFetchFollowersOnStartup(enabled);

    private void UpdateMode(SelectionMode mode) => FollowConfigService.UpdateMode(mode);

    private void UpdateCommandType(string command) => FollowConfigService.UpdateCommandType(command);

    private void UpdateWarningVibrate(bool enabled) => FollowConfigService.UpdateWarningVibrate(enabled);

    private void UpdateIntensity(int value) => FollowConfigService.UpdateIntensity(value);

    private void UpdateDuration(double value) => FollowConfigService.UpdateDuration(value);

    private async Task UpdateShockers(List<string> ids)
    {
        FollowConfigService.UpdateSelectedShockers(ids);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshFollowers()
    {
        StatusMessage = null;
        await InvokeAsync(StateHasChanged);
        var result = await FollowConfigService.FetchFollowersAsync();
        StatusIsSuccess = result.Success;
        StatusMessage = result.Success
        ? $"{result.Message} (+{result.AddedCount} new)"
        : result.Message;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        FollowConfigService.ConfigChanged -= OnConfigChanged;
    }
}